{
    "name": "Jockey",
    "description": "Rats are small enough to mount and ride other players and living things. Look at the target and press NeoOrigins Skill 1 to climb on. The pack default for Skill 1 is F6. Dismount with Sneak, which the pack binds to Left Shift.",
    "badges": [
        {
            "type": "origins:tooltip",
            "text": "Mount with NeoOrigins Skill 1 (pack default F6). Dismount with Sneak (pack default Left Shift).",
            "sprite": "origins:textures/gui/badge/active.png"
        }
    ],
    "type": "origins:multiple",
    "mount": {
        "condition": {
            "inverted": true,
            "type": "origins:riding"
        },
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:raycast",
            "distance": 10,
            "block": false,
            "entity": true,
            "shape_type": "collider",
            "fluid_handling": "none",
            "bientity_condition": {
                "type": "origins:target_condition",
                "condition": {
                    "type": "origins:living"
                }
            },
            "bientity_action": {
                "type": "origins:mount"
            },
            "entity_distance": 3,
            "command_step": 1,
            "command_along_ray_only_on_hit": false
        },
        "cooldown": 1,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.origins.secondary_active",
            "continuous": false
        }
    },
    "dismount": {
        "condition": {
            "inverted": false,
            "type": "origins:riding"
        },
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:dismount"
        },
        "cooldown": 1,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.sneak",
            "continuous": false
        }
    }
}
{
    "name": "Envy of Flight Effect",
    "description": "The levitation and the sugar drain behind Envy of Flight. Levitation drops when sugar hits zero or you sneak, and the toggle turns itself off.",
    "hidden": true,
    "type": "origins:multiple",
    "key0": {
        "type": "neoorigins:persistent_effect",
        "toggleable": false,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:power_active",
                    "power": "autisorigins:envy_of_flight"
                },
                {
                    "type": "origins:resource",
                    "resource": "autisorigins:sugar_addict",
                    "comparison": ">",
                    "compare_to": 0
                }
            ]
        },
        "effects": [
            {
                "effect": "minecraft:levitation",
                "amplifier": 1,
                "ambient": true,
                "show_particles": false,
                "show_icon": false
            }
        ]
    },
    "key1": {
        "condition": {
            "type": "origins:power_active",
            "power": "autisorigins:envy_of_flight"
        },
        "type": "origins:action_over_time",
        "interval": 5,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:modify_resource",
                    "resource": "autisorigins:sugar_addict",
                    "modifier": {
                        "operation": "addition",
                        "value": -10
                    }
                },
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:entity.ender_dragon.flap",
                    "volume": 0.1,
                    "pitch": 2.0
                }
            ]
        }
    },
    "key2": {
        "type": "origins:action_over_time",
        "interval": 1,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:power_active",
                    "power": "autisorigins:envy_of_flight"
                },
                {
                    "type": "origins:or",
                    "conditions": [
                        {
                            "type": "origins:resource",
                            "resource": "autisorigins:sugar_addict",
                            "comparison": "<=",
                            "compare_to": 0
                        },
                        {
                            "type": "origins:sneaking"
                        }
                    ]
                }
            ]
        },
        "entity_action": {
            "type": "origins:toggle",
            "power": "autisorigins:envy_of_flight",
            "value": false
        }
    }
}

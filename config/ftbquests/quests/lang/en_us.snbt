	quest.15978ED5A6E3DFFE.title: "Logistic Mechanism"
	quest.1642A27606A34984.quest_desc: [
		"The second crystal-growth step left with AE2 as well."
		"Rose quartz is nether quartz and redstone, and the line goes on without the growth."
	]
	quest.1642A27606A34984.quest_subtitle: "{cabin.quest.1642A27606A34984.subtitle}"
	quest.1642A27606A34984.title: "Crystal Growth (removed)"
	quest.16F920C2AF2FA2E0.quest_desc: [
		"A coke chunk is coal coke broken down for the silicon line."
		"It joins purified sand in the silicon compound."
	]
	quest.16F920C2AF2FA2E0.quest_subtitle: "{cabin.quest.16F920C2AF2FA2E0.subtitle}"
	quest.16F920C2AF2FA2E0.title: "Coke Chunk"
	quest.171A0F26C6608E83.quest_subtitle: "{cabin.quest.171A0F26C6608E83.subtitle}"
	quest.171A0F26C6608E83.title: "{cabin.quest.171A0F26C6608E83.title}"
	quest.174E3A810535CAAC.quest_desc: [
		"An empty blaze burner is netherrack and iron sheets, and flint and steel lights it. Lighting it does not take an electron tube."
		"Heated mixes, including brass, sit on coal or lava. Superheat waits on a blaze cake."
	]
	quest.174E3A810535CAAC.quest_subtitle: "Heat under a basin"
	quest.174E3A810535CAAC.title: "Blaze Burner"
	quest.17817EA324333BE9.quest_desc: [" Most mod controls have been unbound. There's a handy new binding UI in the settings menu, make sure to use it!"]
	quest.17817EA324333BE9.quest_subtitle: "I WILL NOT BE BOUND"
	quest.17AA221C7B7E6734.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.17AA221C7B7E6734.title: "Lead Casing"
quest.17AA221C7B7E6734.quest_desc: [
		"A lead casing is the shell a logistic mechanism wears."
		"Packagers, frogports, and the stock link are built in that shell."
	]
	quest.1861E583C9DAA0BA.quest_desc: [
		"Rose quartz is nether quartz and redstone."
		"It is the gem the electron tube is built on, and the old certus line is not part of it."
	]
	quest.1861E583C9DAA0BA.quest_subtitle: "{cabin.quest.1861E583C9DAA0BA.subtitle}"
	quest.1861E583C9DAA0BA.title: "Rose Quartz"
	quest.18EDB4CD525CE110.quest_subtitle: "{cabin.quest.18EDB4CD525CE110.subtitle}"
	quest.18EDB4CD525CE110.title: "{cabin.quest.18EDB4CD525CE110.title}"
	quest.1947C6CE179EBAC6.quest_desc: [
		"{cabin.quest.1947C6CE179EBAC6.description1}"

		"{cabin.quest.1947C6CE179EBAC6.description2}"
	]
	quest.1947C6CE179EBAC6.title: "Exploration"
	quest.19715EBCBBA1B4AD.quest_desc: [
		"A precision mechanism is two electron tubes deployed onto a kinetic mechanism, then the wire cutters."
		"The Brass Machine is brass casing around it, and the infernal and logistic lines both start here."
	]
	quest.19715EBCBBA1B4AD.quest_subtitle: "{cabin.quest.19715EBCBBA1B4AD.subtitle}"
	quest.19715EBCBBA1B4AD.title: "Precision Mechanism"
	quest.19921941321965A4.quest_desc: [
		"A slab is cut from those planks."
		"The stripped log and the kinetic mechanism follow it."
	]
	quest.19921941321965A4.quest_subtitle: "{cabin.quest.19921941321965A4.subtitle}"
	quest.19921941321965A4.title: "Slab"
	quest.1A06FA866B74E75B.quest_desc: [
		"Liquid pulp is the other fluid poured into a precision mechanism to grow the logistic mechanism."
		"The haste potion goes in with it."
	]
	quest.1A06FA866B74E75B.quest_subtitle: "{cabin.quest.1A06FA866B74E75B.subtitle}"
	quest.1A06FA866B74E75B.title: "Liquid Pulp Bucket"
	quest.1A383F96B312D1B8.quest_desc: [
		"Coal coke is the coke cooked toward silicon."
		"The next ask is a coke chunk."
	]
	quest.1A383F96B312D1B8.quest_subtitle: "{cabin.quest.1A383F96B312D1B8.subtitle}"
	quest.1A383F96B312D1B8.title: "Coal Coke"
	quest.1A5A81CA749DAB2A.quest_subtitle: "{cabin.quest.1250AE58911C27A9.subtitle}"
	quest.1A5A81CA749DAB2A.title: "{cabin.quest.1A5A81CA749DAB2A.title}"
	quest.1B4D4D92C05B9A16.title: "1-Up"
	quest.1BAFDA330E991BEC.quest_desc: ["For the next step you'll need reinforced paper, but sugarcane can be hard to find on the islands. Luckily, that axe and cutting board can strip logs, and the tree bark left behind can be made into paper. Combined with the other parts, you've got reinforced paper. All you'll need after that are a couple of whiskers..."]
	quest.1BAFDA330E991BEC.title: "Stacking Paper"
	quest.1BCFB709E97A74FA.quest_desc: [
		"Accelerator redstone and accelerator glowstone speed the Alchemical Laser."
		"A long reagent row crawls without them."
	]
	quest.1BCFB709E97A74FA.quest_subtitle: "Redstone and glowstone"
	quest.1BCFB709E97A74FA.title: "Laser Accelerators"
	quest.1BF8F3CC8BEBB620.quest_desc: [
		"The flash drive is the storage stick the calculation mechanism is sequenced with."
		"Processor binding sits in front of it."
	]
	quest.1BF8F3CC8BEBB620.title: "Flash Drive"
	quest.1C6657984648B0D4.quest_desc: [
		"Six is a computation-matrix digit."
		"Raw logic started the set, and this one is ready only after plus exists."
	]
	quest.1C6657984648B0D4.quest_subtitle: "{cabin.quest.1C6657984648B0D4.subtitle}"
	quest.1CC536F2D05E8189.title: "Infinite Vials"
	quest.1CCDA748B237F6F5.quest_desc: [
		"A mechanical harvester uses its standard mod crafting recipe (check EMI)."
		"It is how a moving farm gathers itself."
	]
	quest.1CCDA748B237F6F5.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.1CCDA748B237F6F5.title: "Mechanical Harvester"
	quest.1D1D1FEAF49C5E11.quest_desc: [
		"Computer advanced is a ComputerCraft goal on the laser page, beside the jars."
		"It is not a reagent and not one of the seven rows."
	]
	quest.1D1D1FEAF49C5E11.title: "Computer Advanced"
	quest.1D9D65FBD06DD481.quest_desc: [
		"A lava bucket is the heat poured into the infernal mechanism."
		"It comes after the precision mechanism, beside the plasma from the vines."
	]
	quest.1D9D65FBD06DD481.quest_subtitle: "{cabin.quest.1D9D65FBD06DD481.subtitle}"
	quest.1D9D65FBD06DD481.title: "Lava Bucket"
	quest.1DBFD0B34659A8F9.quest_desc: ["{cabin.quest.1DBFD0B34659A8F9.description1}"]
	quest.1DBFD0B34659A8F9.title: "Skeleton Skull"
	quest.1DD2802F5611D419.quest_desc: [
		"{cabin.quest.1DD2802F5611D419.description1}"
		""
		"{cabin.quest.1DD2802F5611D419.description2}"
	]
	quest.1DD2802F5611D419.title: "Attachment Base"
	quest.1E263994D4883A08.quest_desc: [
		"This overview node tracks the chapter milestone that opens the brass age."
	]
	quest.1E263994D4883A08.quest_subtitle: "{cabin.quest.1E263994D4883A08.subtitle}"
	quest.1E263994D4883A08.title: "{cabin.quest.1E263994D4883A08.title}"
	quest.2131996D22A87667.quest_desc: [
		"This potion is the haste brew the logistic mechanism is filled with."
		"The glowing potion for the mushrooms is a later cup."
	]
	quest.2131996D22A87667.quest_subtitle: "{cabin.quest.2131996D22A87667.subtitle}"
	quest.2131996D22A87667.title: "Potion"
	quest.2167272204B6627B.quest_desc: [
		"Light the empty blaze burner, then feed it a blaze cake so the mixer can superheat."
		"A superheated mixer melts an iron ingot into 90 mB of molten iron. A spout pours 10 mB of that onto polished rose quartz to fill an electron tube."
	]
	quest.2167272204B6627B.quest_subtitle: "Blaze cake, then an ingot"
	quest.2167272204B6627B.title: "Molten Iron"
	quest.21E2FD715F43CCC2.quest_desc: [""]
	quest.21E2FD715F43CCC2.title: "redstone_blood"
	quest.21E76761CD3761C2.quest_subtitle: "{cabin.quest.21E76761CD3761C2.subtitle}"
	quest.21E76761CD3761C2.title: "{cabin.quest.21E76761CD3761C2.title}"
	quest.21F77EA64E11A9AB.quest_desc: ["Your newly forged blade hungers for the blood of your enemies. You can collect their tears in a bucket at the same time, and gain a useful tool for descending cliffs and dousing yourself if you catch fire."]
	quest.21F77EA64E11A9AB.title: "KILL"
	quest.22202C87352242D6.quest_desc: [
		"Sand at the start of the processor line becomes a sand ball."
		"Rough sand, purified sand, silicon compound, and heated Refined Storage silicon follow."
	]
	quest.22202C87352242D6.quest_subtitle: "{cabin.quest.22202C87352242D6.subtitle}"
	quest.22202C87352242D6.title: "Sand"
	quest.223BB57AD0239511.quest_desc: [
		"Twisting vines are a nether plant on the infernal branch."
		"Heated with weeping vines they make the plasma that mechanism is filled with."
	]
	quest.223BB57AD0239511.quest_subtitle: "{cabin.quest.223BB57AD0239511.subtitle}"
	quest.223BB57AD0239511.title: "Twisting Vines"
	quest.2268AFAF6E9AB5E2.quest_desc: [
		"Silicon compound is purified sand brought together with a coke chunk."
		"Heated, it becomes Refined Storage silicon."
	]
	quest.2268AFAF6E9AB5E2.quest_subtitle: "{cabin.quest.2268AFAF6E9AB5E2.subtitle}"
	quest.2268AFAF6E9AB5E2.title: "Silicon Compound"
	quest.22CE9949793981A6.title: "its a tree :)"
	quest.232166AEE943A162.title: "Let's Recycle!"
	quest.239C64263B91350D.quest_desc: [
		"Soul sand is nether soil the infernal branch asks you to hold, after the vines."
		"The mechanism itself is filled from lava and from that plasma."
	]
	quest.239C64263B91350D.quest_subtitle: "{cabin.quest.239C64263B91350D.subtitle}"
	quest.239C64263B91350D.title: "Soul Sand"
	quest.240206E4C3855006.quest_desc: ["i like the ccrunchy ones better :DD if were gonna eat vegtibles im gonna at least have some crunchys too. blobbins need a crunch brake some times."]
	quest.240206E4C3855006.title: "Crunchy snack"
	quest.2441491CB5D5E57D.quest_desc: [
		"Zero is a computation-matrix digit."
		"It waits on three, eight, and plus, and the thinking machine wants it with the rest."
	]
	quest.2441491CB5D5E57D.quest_subtitle: "{cabin.quest.2441491CB5D5E57D.subtitle}"
	quest.24C48CFAAD71B230.quest_desc: [
		"Raw processors are diced from washed, polished, or insulated wafers: basic, improved, and advanced."
		"Smelting them finishes the processors."
	]
	quest.FABFAB0000000001.title: "Blank Wafers"
	quest.FABFAB0000000001.quest_desc: ["Saw one Refined Storage silicon into six wafers. Each later step is its own item, so a normal Create filter can route the line."]
	quest.FABFAB0000000002.title: "Lithography Spirit"
	quest.FABFAB0000000002.quest_desc: [
		"Pull alchemical sulfur out of something that used to be alive (Theurgy liquefaction), then heat-mix it with a mercury shard, redstone, and liquid experience."
		""
		"Eight spirits a batch. Deploying one writes the pattern. It also damages the die and contaminates it."
	]
	quest.FABFAB0000000003.title: "Expose"
	quest.FABFAB0000000003.quest_desc: ["Deploy a lithography spirit onto a blank wafer. A second spirit on an exposed wafer ruins it."]
	quest.FABFAB0000000004.title: "Anneal"
	quest.FABFAB0000000004.quest_desc: ["Superheat an exposed wafer. The damage comes out. The contamination gets worse. Annealing a blank wafer ruins it."]
	quest.FABFAB0000000005.title: "Wash"
	quest.FABFAB0000000005.quest_desc: [
		"Spout sal ammoniac or sulfuric acid onto an annealed wafer."
		""
		"Washing a blank or an exposed wafer etches the pattern off. That one is ruined."
	]
	quest.FABFAB0000000006.title: "Polish"
	quest.FABFAB0000000006.quest_desc: ["Optional. Deploy sandpaper onto a washed wafer. Better odds when you dice it."]
	quest.FABFAB0000000007.title: "Insulate"
	quest.FABFAB0000000007.quest_desc: ["Optional. Stack three washed wafers with a diamond. The diamond is the insulation. This is the plate that actually wants to be an advanced processor."]
	quest.FABFAB0000000008.title: "Exorcism"
	quest.FABFAB0000000008.quest_desc: [
		"A ruined wafer is full of demons. There is no demon mod in the pack, so the lattice sends wraiths, foxhounds, and a wildfire."
		""
		"Craft a Wafer Gate and right-click it with the ruined wafer. The gate holds the wafer. Right-click again to enter the cell. Kill everything in it and the held wafer becomes a blank one. Sneak-click to take it out."
		""
		"Dying in the cell sends you back to the gate with your inventory. The same wafer is still seated, so you can try again. A soul sand fan or a spout of concentrated souls still skips the fight."
	]
	quest.FABFAB0000000009.title: "Defective DRAM"
	quest.FABFAB0000000009.quest_desc: ["The press also bins failures: defective DRAM, a basic CAD core, and cooked bacon. You will get DRAM. Keep the line moving."]
	quest.FABFAB000000000A.title: "Good Bin"
	quest.FABFAB000000000A.quest_desc: ["Dice a washed, polished, or insulated wafer in a sequenced press. A raw improved processor is what the flash drive wants. Advanced is the jackpot. Smelt after."]
	quest.24C48CFAAD71B230.quest_subtitle: "{cabin.quest.24C48CFAAD71B230.subtitle}"
	quest.24C48CFAAD71B230.title: "Raw Processors"
	quest.24FFFE0FC9EAEF8D.quest_desc: [
		"The charger left with AE2."
		"Nothing is charged here, and the line goes on to redstone and polished rose quartz."
	]
	quest.24FFFE0FC9EAEF8D.quest_subtitle: "{cabin.quest.24FFFE0FC9EAEF8D.subtitle}"
	quest.24FFFE0FC9EAEF8D.title: "The (Re-)Charger (removed)"
	quest.252015A3FD4F1528.title: "Flinging is the New Sling"
	quest.25B76A897D97C9F1.quest_desc: [
		"Another rocket fuel, after the crude oil is in a bucket."
		"The launch marker will not close without it."
	]
	quest.25B76A897D97C9F1.quest_subtitle: "{cabin.quest.25B76A897D97C9F1.subtitle}"
	quest.26173D4777F439B1.quest_desc: [
		"This overview node tracks the chapter milestone that opens the calculation age."
	]
	quest.26173D4777F439B1.quest_subtitle: "{cabin.quest.26173D4777F439B1.subtitle}"
	quest.26173D4777F439B1.title: "{cabin.quest.26173D4777F439B1.title}"
	quest.26A1E68DA7ACB025.quest_desc: [
		"This overview node tracks a chapter milestone for the hammer mark at the close of the inductive page."
	]
	quest.26A1E68DA7ACB025.quest_subtitle: "{cabin.quest.26A1E68DA7ACB025.subtitle}"
	quest.26A1E68DA7ACB025.title: "{cabin.quest.26A1E68DA7ACB025.title}"

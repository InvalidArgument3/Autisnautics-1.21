	]
	quest.6B03056FA21424C0.title: "Iron Pickaxe"
	quest.6B7F0631060A9E62.quest_desc: [
		"Clay is the soft earth the algal blend is mixed from."
		"That blend is Architect's Palette masonry. Andesite alloy does not use it."
	]
	quest.6B7F0631060A9E62.quest_subtitle: "{cabin.quest.6B7F0631060A9E62.subtitle}"
	quest.6B7F0631060A9E62.title: "Clay"
	quest.6BA9A176EDA001A3.quest_desc: [
		"The space suit is the helmet, chest, legs, and boots worn off-world."
		"It is what you stand in once the rocket leaves."
	]
	quest.6BC4C7084350D5D7.quest_subtitle: ">minecraft combat"
	quest.6BC4C7084350D5D7.title: "Better™® Combat"
	quest.6BC864CC7CB2C316.quest_desc: [

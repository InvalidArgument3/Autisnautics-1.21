	quest.3CBED6B591BCEDEA.quest_desc: ["Rocketry Equipment is built from the light but robust material of Matter Plastics. Without AE2 Matter Balls, Matter Plastics are made from Paraffin Wax, a distillation product from Immersive Petroleum."]

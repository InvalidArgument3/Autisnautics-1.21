	quest.345B94F6D17605CD.quest_desc: ["With AE2 gone there is no Certus Quartz to grow. Grab some Nether Quartz instead: crafted together with Redstone it becomes Rose Quartz."]
	quest.345B94F6D17605CD.quest_subtitle: "{cabin.quest.345B94F6D17605CD.subtitle}"

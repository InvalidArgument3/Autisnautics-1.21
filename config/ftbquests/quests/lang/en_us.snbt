	quest.08367CEDF13CB65C.title: "Lead Casing"
quest.08367CEDF13CB65C.quest_desc: [
		"A lead casing is the shell a logistic mechanism wears."
		"Packagers, frogports, and the stock link are built in that shell."
	]
	quest.08716DBF9C882623.quest_desc: [
		"Apple cider is a drink counter for the calculation age."
		"It marks the calculation mechanism, the flash drive, and the turn toward flight."
	]
	quest.08716DBF9C882623.quest_subtitle: "{cabin.quest.08716DBF9C882623.subtitle}"
	quest.08716DBF9C882623.title: "Apple Cider"

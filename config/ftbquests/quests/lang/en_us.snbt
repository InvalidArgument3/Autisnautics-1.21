	quest.623EE1E0678E4F2A.title: "{cabin.quest.623EE1E0678E4F2A.title}"
	quest.626A7D9947D82B89.quest_desc: [
		"A radiant coil is the wound sheet."
		"The inductive mechanism is sequenced from it, with the chromatic resonator."
	]
	quest.626A7D9947D82B89.quest_subtitle: "{cabin.quest.626A7D9947D82B89.subtitle}"
	quest.626A7D9947D82B89.title: "Radiant Coil"
	quest.62EB94758A862091.quest_desc: [
		"Another blaze reagent for the egg row, after the void catalyst and the jars beside it."
	]
	quest.630DA0C83959E9D8.quest_desc: [
		"Accelerator redstone speeds the Alchemical Laser."
		"The glowstone accelerator does the same job with a brighter burn."
	]
	quest.630DA0C83959E9D8.quest_subtitle: "{cabin.quest.630DA0C83959E9D8.subtitle}"
	quest.630DA0C83959E9D8.title: "Accellerator Redstone"

	]
	quest.6416040000000000.title: "Metal Swarf"
	quest.6416040000000000.quest_subtitle: "A ferrouslime ball, raw iron, and gravel"
	quest.6416040000000000.quest_desc: [
		"Metal swarf is magnetic scrap."
		"It is a material used in the magnetic-cave crafts."
	]
	quest.6416050000000000.title: "Frostmint"
	quest.6416050000000000.quest_subtitle: "Peppermint powder and blue ice"
	quest.6416050000000000.quest_desc: [
		"Frostmint is a candy plant."
		"It is a food from the candy caves."
	]
	chapter.6517000000000000.title: "The Undergarden"
	chapter.6517000000000000.chapter_subtitle: [
		"A rectangle of stone bricks"
	]
	quest.6417000000000000.title: "Catalyst"
	quest.6417000000000000.quest_subtitle: "Right-click the inside"
	quest.6417000000000000.quest_desc: [
		"The catalyst is the quest item for entering the Undergarden."
		"It opens the way in."
	]
	quest.6417010000000000.title: "Wigglewood Log"
	quest.6417010000000000.quest_subtitle: "Chop a wigglewood tree on the far"
	quest.6417010000000000.quest_desc: [
		"Wigglewood is the wood of the Undergarden."
		"The log is used for the planks and early builds there."
	]
	quest.6417020000000000.title: "Wigglewood Planks"
	quest.6417020000000000.quest_subtitle: "Shapeless, from a wigglewood log"
	quest.6417020000000000.quest_desc: [
		"Wigglewood planks are boards of wigglewood."
		"They are the building wood of the Undergarden."
	]
	quest.6417030000000000.title: "Twistytwig"
	quest.6417030000000000.quest_subtitle: "Two wigglewood planks, set on a diagonal"
	quest.6417030000000000.quest_desc: [
		"Twistytwig is a plant."
		"It is used as the stick of the Undergarden."
	]
	quest.6417040000000000.title: "Depthrock"
	quest.6417040000000000.quest_subtitle: "Mine it in the Undergarden"
	quest.6417040000000000.quest_desc: [
		"Depthrock is the stone of the Undergarden."
		"The ores of that dimension are found in it."
	]
	quest.6417050000000000.title: "Raw Cloggrum"
	quest.6417050000000000.quest_subtitle: "Mine cloggrum ore"
	quest.6417050000000000.quest_desc: [
		"Raw cloggrum is the raw form of the first metal."
		"It smelts into cloggrum."
	]
	quest.6417060000000000.title: "Cloggrum Ingot"
	quest.6417060000000000.quest_subtitle: "Smelt raw cloggrum, or blast it"
	quest.6417060000000000.quest_desc: [
		"A cloggrum ingot is smelted from raw cloggrum."
		"It is the metal of the first pickaxe."
	]
	quest.6417070000000000.title: "Cloggrum Pickaxe"
	quest.6417070000000000.quest_subtitle: "Cloggrum ingots and a wooden rod, in"
	quest.6417070000000000.quest_desc: [
		"The cloggrum pickaxe is the first metal pick of the Undergarden."
		"It mines the ores of that dimension."
	]
	chapter.6518000000000000.title: "Tide"
	chapter.6518000000000000.chapter_subtitle: [
		"String, then a fish"
	]
	quest.6418000000000000.title: "Fishing Journal"
	quest.6418000000000000.quest_subtitle: "In the tome, not at spawn"
	quest.6418000000000000.quest_desc: [
		"The Fishing Journal is the fishing book."
		"It records catches and explains rods, tackle, and the dock machines."
	]
	quest.6418010000000000.title: "Stone Fishing Rod"
	quest.6418010000000000.quest_subtitle: "Cobblestone and string, in a rod shape"
	quest.6418010000000000.quest_desc: [
		"The stone fishing rod is the first rod, and there is no plain fishing rod item."
		"It is the rod you cast with before the metal rods."
	]
	quest.6418020000000000.title: "Fishing Hook"
	quest.6418020000000000.quest_subtitle: "Iron nuggets and cobblestone"
	quest.6418020000000000.quest_desc: [
		"A fishing hook is tackle."
		"It is fitted to a rod to change the hook."
	]
	quest.6418030000000000.title: "Fishing Line"
	quest.6418030000000000.quest_subtitle: "Three string, stacked"
	quest.6418030000000000.quest_desc: [
		"Fishing line is the basic tackle line."
		"It is fitted to a rod."
	]
	quest.6418040000000000.title: "Iron Line"
	quest.6418040000000000.quest_subtitle: "Iron ingots and a fishing line"
	quest.6418040000000000.quest_desc: [
		"Iron line is tackle, the line above the basic fishing line."
		"It is a line, not a rod."
	]
	quest.6418050000000000.title: "Bait"
	quest.6418050000000000.quest_subtitle: "A bait plant, rotten flesh, seeds, and"
	quest.6418050000000000.quest_desc: [
		"Bait attracts fish."
		"It is used on a cast to draw a bite."
	]
	quest.6418060000000000.title: "Wooden Crate"
	quest.6418060000000000.quest_subtitle: "Wooden slabs in a chest ring"
	quest.6418060000000000.quest_desc: [
		"A wooden crate stores fish."
		"It is the first crate in the line that ends at the obsidian crate."
	]
	quest.64010A0000000001.title: "Andesite Casing"
	quest.64010A0000000001.quest_subtitle: "Alloy and any log"
	quest.64010A0000000001.quest_desc: [
		"Andesite casing is one alloy and any log, and the craft makes two."
		"Used as the structural frame for basic Create contraptions and early rotational machines."
	]
	quest.7F08F344795D16E1.title: "Taking Flight"
	quest.7F08F344795D16E1.quest_subtitle: "Leave the stack"
	quest.7F08F344795D16E1.quest_desc: [
		"Taking Flight is the sky chapter on the overview."
		"It opens after the calculation age, and Skyworthy is the attribute that lets you leave."
	]
	quest.7A65109679CB08D7.title: "Silicon Wafer"
	quest.7A65109679CB08D7.quest_subtitle: "Saw a silicon item"
	quest.7A65109679CB08D7.quest_desc: [
		"A silicon wafer is a saw cut of Refined Storage silicon, six from one piece."
		"The lithography spirit has to land on it before any heat or wash, or the blank is ruined."
	]
	quest.2E9DE41FAC48B8A7.title: "Lithography Spirit"
	quest.2E9DE41FAC48B8A7.quest_subtitle: "Heated, with mercury"
	quest.2E9DE41FAC48B8A7.quest_desc: [
		"Lithography spirit is the resist painted onto a blank wafer."
		"Spirit on silicon makes the exposed, latent wafer."
	]
	quest.7C8C07525326B068.title: "Exposed Wafer"
	quest.7C8C07525326B068.quest_subtitle: "One spirit, not two"
	quest.7C8C07525326B068.quest_desc: [
		"The exposed wafer is the latent wafer, spirit on silicon, and it anneals next."
		"Superheating or washing a blank ruins it instead."
	]
	quest.682C6EDD7B131217.title: "Annealed Wafer"
	quest.682C6EDD7B131217.quest_subtitle: "Superheat the exposed one"
	quest.682C6EDD7B131217.quest_desc: [
		"The annealed wafer is the latent wafer after its heat."
		"It washes next, and a blank that was heated too early is the ruined wafer."
	]
	quest.27DFF2F1B447554C.title: "Washed Wafer"
	quest.27DFF2F1B447554C.quest_subtitle: "Sal ammoniac, or sulfuric acid"
	quest.27DFF2F1B447554C.quest_desc: [
		"The washed wafer is the annealed wafer after its bath."
		"It can be polished, or diced straight into a raw processor."
	]
	quest.375B60D0AA211DE5.title: "Polished Wafer"
	quest.375B60D0AA211DE5.quest_subtitle: "Sandpaper on the washed wafer"
	quest.375B60D0AA211DE5.quest_desc: [
		"The polished wafer is the washed wafer taken smoother."
		"It dices into raw processors, and it also feeds the insulated die."
	]
	quest.057B683A7191B2C2.title: "Insulated Die"
	quest.057B683A7191B2C2.quest_subtitle: "Three washed wafers, one diamond"
	quest.057B683A7191B2C2.quest_desc: [
		"The insulated die is the stacked wafer."
		"Dicing it is the best of the three raw-processor cuts, and a dram can fall out beside them."
	]
	quest.467B0625D2A4A184.title: "Ruined Wafer"
	quest.467B0625D2A4A184.quest_subtitle: "Haunt it back"
	quest.467B0625D2A4A184.quest_desc: [
		"A ruined wafer is a blank that was superheated or washed too soon."
		"The line continues from a proper annealed wafer, not from this one."
	]
	quest.40D97A07CDC07DB8.title: "Dram"
	quest.40D97A07CDC07DB8.quest_subtitle: "The junk face of the die"
	quest.40D97A07CDC07DB8.quest_desc: [
		"A dram is the small die dicing drops beside a raw processor."
		"It is the offcut of the wafer cut, not a processor."
	]
	quest.1C253E3B9DA3597E.title: "Raw Improved Processor"
	quest.1C253E3B9DA3597E.quest_subtitle: "A die roll, not the grid"
	quest.1C253E3B9DA3597E.quest_desc: [
		"The raw improved processor is one dice from an insulated die."
		"The combined raw-processor node still wants it together with the basic and the advanced."
	]
	quest.36A2C5B3E20C28DF.title: "Stone Reagent"
	quest.36A2C5B3E20C28DF.quest_subtitle: "First laser row"
	quest.36A2C5B3E20C28DF.quest_desc: [
		"A stone reagent is a jar for the Alchemical Laser, on the first row with lapis, slime, ender, oil, and chocolate."
		"Four reagents from one row become the catalyst for that row."
	]
	quest.60F7A50F984284F1.title: "Granite Reagent"
	quest.60F7A50F984284F1.quest_subtitle: "Granite laser row"
	quest.60F7A50F984284F1.quest_desc: [
		"A granite reagent is a jar on the granite row, with quartz, copper, emerald, and prismarine."
		"Four reagents from that row become its catalyst."
	]
	quest.35406FED565B7EFF.title: "Granite Reagent"
	quest.35406FED565B7EFF.quest_subtitle: "Granite laser row"
	quest.35406FED565B7EFF.quest_desc: [
		"Another granite reagent for the same laser row."
	]
	quest.6CBB7512CDFF4C2E.title: "Stone Reagent"
	quest.6CBB7512CDFF4C2E.quest_subtitle: "First laser row"
	quest.6CBB7512CDFF4C2E.quest_desc: [
		"Another stone reagent for the same first laser row."
	]
	quest.0F688EAF792BAE96.title: "Scoria Reagent"
	quest.0F688EAF792BAE96.quest_subtitle: "Netherrack laser row"
	quest.0F688EAF792BAE96.quest_desc: [
		"A scoria reagent is a jar on the netherrack row, with netherrack, zinc, sulfur, and niter."
		"Four reagents from that row become its catalyst."
	]
	quest.560F2995CE2862D7.title: "Scoria Reagent"
	quest.560F2995CE2862D7.quest_subtitle: "Netherrack laser row"
	quest.560F2995CE2862D7.quest_desc: [
		"Another scoria reagent for the same netherrack row."
	]
	quest.3978E4B39C9DB44D.title: "Red Dye"
	quest.3978E4B39C9DB44D.quest_subtitle: "The dye, not a reagent"
	quest.3978E4B39C9DB44D.quest_desc: [
		"Red dye on the laser page is a plain ingredient, not a reagent jar."
		"The bone meal jar sits after these dyes."
	]
	quest.122D3D6743D1DD04.title: "Orange Dye"
	quest.122D3D6743D1DD04.quest_subtitle: "The dye, not a reagent"
	quest.122D3D6743D1DD04.quest_desc: [
		"Orange dye is a plain ingredient for the laser page, not a jar."
	]
	quest.1E856F69C03B1D75.title: "Yellow Dye"
	quest.1E856F69C03B1D75.quest_subtitle: "The dye, not a reagent"
	quest.1E856F69C03B1D75.quest_desc: [
		"Yellow dye here is a plain ingredient, not the yellow dye that feeds chromatic compound."
	]
	quest.49957428564E8101.title: "Green Dye"
	quest.49957428564E8101.quest_subtitle: "The dye, not a reagent"
	quest.49957428564E8101.quest_desc: [
		"Green dye here is a plain ingredient beside the jars, not a substrate."
	]
	quest.678C5FC6A898E988.title: "Blue Dye"
	quest.678C5FC6A898E988.quest_subtitle: "The dye, not a reagent"
	quest.678C5FC6A898E988.quest_desc: [
		"Blue dye here is a plain ingredient, not a laser jar."
	]
	quest.3377A2C391B6F03A.title: "Magenta Dye"
	quest.3377A2C391B6F03A.quest_subtitle: "The dye, not a reagent"
	quest.3377A2C391B6F03A.quest_desc: [
		"Magenta dye here is a plain ingredient."
		"The dye itself is not a reagent, and the bone meal jar is what follows the set."
	]
	quest.616D07DC2CE17BA4.title: "Blaze Reagent"
	quest.616D07DC2CE17BA4.quest_subtitle: "Egg laser row"
	quest.616D07DC2CE17BA4.quest_desc: [
		"A blaze reagent is a jar on the egg row, with the bone meal reagent."
		"Four reagents from that row become its catalyst."
	]
	quest.758B836F53187B8C.title: "Slime Reagent"
	quest.758B836F53187B8C.quest_subtitle: "First laser row"
	quest.758B836F53187B8C.quest_desc: [
		"A slime reagent is a jar on the first laser row, beside stone and lapis."
		"Ender, oil, and chocolate sit on that row with them."
	]
	quest.4E3B9AA2062424F4.title: "Netherrack Reagent"
	quest.4E3B9AA2062424F4.quest_subtitle: "Netherrack laser row"
	quest.4E3B9AA2062424F4.quest_desc: [
		"A netherrack reagent is a jar on the netherrack row."
		"Scoria, zinc, sulfur, and niter share it."
	]
	quest.20AA864C5201C638.title: "Void Catalyst"
	quest.20AA864C5201C638.quest_subtitle: "Laser, not a jar"
	quest.20AA864C5201C638.quest_desc: [
		"Void catalyst is not jar-crafted."
		"The laser rolls a finished row into it."
	]
	quest.35A6E3BBD80FB00F.title: "Sulfur Reagent"
	quest.35A6E3BBD80FB00F.quest_subtitle: "Netherrack laser row"
	quest.35A6E3BBD80FB00F.quest_desc: [
		"A sulfur reagent is a jar on the netherrack row."
		"Four reagents from that row become the catalyst."
	]
	quest.03DB1FCC30B7321C.title: "Prismarine Reagent"
	quest.03DB1FCC30B7321C.quest_subtitle: "Granite laser row"
	quest.03DB1FCC30B7321C.quest_desc: [
		"A prismarine reagent is a jar on the granite row, the sea end of that set."
		"Granite, quartz, copper, and emerald are the others."
	]
	quest.421E285B7D642676.title: "Amethyst Shard"
	quest.421E285B7D642676.quest_subtitle: "Have one"
	quest.421E285B7D642676.quest_desc: [
		"An amethyst shard is a plain ingredient on this page, not a reagent jar."
	]
	quest.6E154A8C81D8DD5F.title: "Quartz Reagent"
	quest.6E154A8C81D8DD5F.quest_subtitle: "Granite laser row"
	quest.6E154A8C81D8DD5F.quest_desc: [
		"A quartz reagent is a jar on the granite row, not the plain quartz gem."
		"Copper, emerald, and prismarine share that row."
	]
	quest.58A0EA80BB3A3262.title: "Sulfur Reagent"
	quest.58A0EA80BB3A3262.quest_subtitle: "Netherrack laser row"
	quest.58A0EA80BB3A3262.quest_desc: [
		"Another sulfur reagent for the same netherrack row."
	]
	quest.2C6EE5BEB945F154.title: "Niter Reagent"
	quest.2C6EE5BEB945F154.quest_subtitle: "Netherrack laser row"
	quest.2C6EE5BEB945F154.quest_desc: [
		"A niter reagent is a jar on the netherrack row, beside the sulfur."
		"Scoria, netherrack, and zinc complete that row."
	]
	quest.7CA6AC3B07E07D81.title: "Quartz"
	quest.7CA6AC3B07E07D81.quest_subtitle: "Have one"
	quest.7CA6AC3B07E07D81.quest_desc: [
		"This quartz is the plain gem, not the quartz reagent jar."
		"The granite-row jar is a different node."
	]
	quest.40FDCF626F5EBB08.title: "Quartz Reagent"
	quest.40FDCF626F5EBB08.quest_subtitle: "Granite laser row"
	quest.40FDCF626F5EBB08.quest_desc: [
		"Another quartz reagent for the same granite row."
	]
	quest.5C0CE1EDF9BF49C9.title: "Zinc Reagent"
	quest.5C0CE1EDF9BF49C9.quest_subtitle: "Netherrack laser row"
	quest.5C0CE1EDF9BF49C9.quest_desc: [
		"A zinc reagent is a jar on the netherrack row, with scoria, netherrack, sulfur, and niter."
	]
	quest.5A957C9B5D8DE1A1.title: "Copper Reagent"
	quest.5A957C9B5D8DE1A1.quest_subtitle: "Granite laser row"
	quest.5A957C9B5D8DE1A1.quest_desc: [
		"A copper reagent is a jar on the granite row."
		"It sits with granite, quartz, emerald, and prismarine."
	]
	quest.2995ADCCB6496A22.title: "Iron Reagent"
	quest.2995ADCCB6496A22.quest_subtitle: "Wool laser row"
	quest.2995ADCCB6496A22.quest_desc: [
		"An iron reagent is a jar on the wool row, with the lead reagent."
		"Four reagents from that row become its catalyst."
	]
	quest.285F815678D5F32A.title: "Nickel Reagent"
	quest.285F815678D5F32A.quest_subtitle: "Calcite laser row"
	quest.285F815678D5F32A.quest_desc: [
		"A nickel reagent is a jar on the calcite row, with the gold reagent."
		"Four reagents from that row become its catalyst."
	]
	quest.394A502BD8B5B1A0.title: "Lead Reagent"
	quest.394A502BD8B5B1A0.quest_subtitle: "Wool laser row"
	quest.394A502BD8B5B1A0.quest_desc: [
		"A lead reagent is the other jar on the wool row, beside iron."
	]
	quest.22F0C935130ADCF4.title: "Gold Reagent"
	quest.22F0C935130ADCF4.quest_subtitle: "Calcite laser row"
	quest.22F0C935130ADCF4.quest_desc: [
		"A gold reagent is the other jar on the calcite row, beside nickel."
	]
	quest.235264EC150EDB4B.title: "Lapis Reagent"
	quest.235264EC150EDB4B.quest_subtitle: "First laser row"
	quest.235264EC150EDB4B.quest_desc: [
		"A lapis reagent is a jar on that first laser row, with the stone and the slime."
		"Four reagents from the row become the catalyst for that row."
	]
	quest.33B3AB3394DD012A.title: "Sulfur Reagent"
	quest.33B3AB3394DD012A.quest_subtitle: "Netherrack laser row"
	quest.33B3AB3394DD012A.quest_desc: [
		"A third sulfur reagent for the same netherrack row."
	]
	quest.58A6D5414035EEA1.title: "Lapis Reagent"
	quest.58A6D5414035EEA1.quest_subtitle: "First laser row"
	quest.58A6D5414035EEA1.quest_desc: [
		"Another lapis reagent for the same first laser row."
	]
	quest.2EECFBC4E2BF1F37.title: "Emerald Reagent"
	quest.2EECFBC4E2BF1F37.quest_subtitle: "Granite laser row"
	quest.2EECFBC4E2BF1F37.quest_desc: [
		"An emerald reagent is a jar on the granite row."
		"Four reagents from that row become the catalyst."
	]
	quest.2FD7D312EE63EA53.title: "Blaze Reagent"
	quest.2FD7D312EE63EA53.quest_subtitle: "Egg laser row"
	quest.2FD7D312EE63EA53.quest_desc: [
		"Another blaze reagent for the same egg row."
	]
	quest.2644760FA76D5F30.title: "Diamond"
	quest.2644760FA76D5F30.quest_subtitle: "Have one"
	quest.2644760FA76D5F30.quest_desc: [
		"A diamond is a plain ingredient on the laser page, not a jar."
		"The later emerald reagent waits until it is in hand."
	]
	quest.3EB5CD9776DF0E63.title: "Scoria Reagent"
	quest.3EB5CD9776DF0E63.quest_subtitle: "Netherrack laser row"
	quest.2B195E5B195246F5.title: "Bonemeal Reagent"
	quest.2B195E5B195246F5.quest_subtitle: "Egg laser row"
	quest.62EB94758A862091.title: "Blaze Reagent"
	quest.62EB94758A862091.quest_subtitle: "Egg laser row"
	quest.549D7F67A97CD2CE.title: "Quartz Reagent"
	quest.549D7F67A97CD2CE.quest_subtitle: "Granite laser row"
	quest.0CC92E94D10E681D.title: "Iron Reagent"
	quest.0CC92E94D10E681D.quest_subtitle: "Wool laser row"
	quest.5200AD3B32D219C6.title: "Emerald Reagent"
	quest.5200AD3B32D219C6.quest_subtitle: "Granite laser row"
	quest.566E72AE7D580917.title: "Silver Reagent"
	quest.566E72AE7D580917.quest_subtitle: "A laser result, not a jar"
	quest.5550A3E383EFEC90.title: "Three"
	quest.3126DE83A6741671.title: "Eight"
	quest.2441491CB5D5E57D.title: "Zero"
	quest.42B5C0102B22F389.title: "One"
	quest.5358E5F7FB59DD60.title: "Two"
	quest.55F959A18E904D6C.title: "Four"
	quest.7927B6162577FA7B.title: "Five"
	quest.1C6657984648B0D4.title: "Six"
	quest.4A16CE3BC111280F.title: "Seven"
	quest.7D808F15BEDD7A7B.title: "Nine"
	quest.29CF41B34D00FE4D.title: "Earth Orbit"
	quest.29CF41B34D00FE4D.quest_subtitle: "Above the sky islands"
	quest.29CF41B34D00FE4D.quest_desc: [
		"Earth orbit is the first trip off the pad."
		"The grass-block return can open from this trip."
	]
	quest.6DC501212658D17B.title: "The Moon"
	quest.6DC501212658D17B.quest_subtitle: "Past the rocket"
	quest.6DC501212658D17B.quest_desc: [
		"The moon is the landing the overview calls Moon Stone."
		"Any one of the trips, this one included, can send you back to the grass block."
	]
	quest.3F1B9487F515D609.title: "Mars Orbit"
	quest.3F1B9487F515D609.quest_subtitle: "Further out"
	quest.3F1B9487F515D609.quest_desc: [
		"Mars orbit is a trip, not a landing."
		"It still counts as time off the world, and the grass block is the way home."
	]
	quest.0DB6C5E3A6A8DCE0.title: "Mercury Orbit"
	quest.0DB6C5E3A6A8DCE0.quest_subtitle: "Close to the star"
	quest.0DB6C5E3A6A8DCE0.quest_desc: [
		"Mercury orbit is the hot short trip."
		"The return marker can open from it, the same as from the other orbits."
	]
	quest.55DD1BA6C84857AE.title: "Venus Orbit"
	quest.55DD1BA6C84857AE.quest_subtitle: "The long way around"
	quest.55DD1BA6C84857AE.quest_desc: [
		"Venus orbit is the last of the listed trips."
		"After a trip, the grass block is the way home."
	]
	quest.687C0B1646405F66.title: "Clear for Takeoff"
	quest.687C0B1646405F66.quest_subtitle: "The sky is a chapter"
	quest.687C0B1646405F66.quest_desc: [
		"Clear for Takeoff is the opening of the sky chapter."
		"The gliders, the aircraft, and the airship all sit on this page, and Skyworthy is what lets you leave."
	]
	quest.44574DD7ED012C32.title: "Wooden Paraglider"
	quest.44574DD7ED012C32.quest_subtitle: "Any wood, a first glide"
	quest.44574DD7ED012C32.quest_desc: [
		"The wooden paraglider is the first wing."
		"It is cloth and wood enough to leave the ground before any engine."
	]
	quest.7185578FE136832B.title: "Iron Paraglider"
	quest.7185578FE136832B.quest_subtitle: "A sturdier canopy"
	quest.7185578FE136832B.quest_desc: [
		"The iron paraglider is the sturdier wing after the wooden one."
		"It is still a glider, before the aircraft."
	]
	quest.7EA9F909DD9B538A.title: "Aircraft Propeller"
	quest.7EA9F909DD9B538A.quest_subtitle: "Eight iron sheets"
	quest.7EA9F909DD9B538A.quest_desc: [
		"The aircraft propeller is the Immersive Aircraft screw."
		"The gyrodyne and the airship turn on one, and the andesite propeller is the factory version of it."
	]
	quest.77426DDB0F2283CA.title: "Gyrodyne"
	quest.77426DDB0F2283CA.quest_subtitle: "Kinetic mechanism, not precision"
	quest.77426DDB0F2283CA.quest_desc: [
		"The gyrodyne is the small rotorcraft."
		"It is the step between a loose propeller and a full airship."
	]
	quest.67DCC1E05E49C5D0.title: "Airship"
	quest.67DCC1E05E49C5D0.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.67DCC1E05E49C5D0.quest_desc: [
		"The airship is the Immersive Aircraft hull."
		"The gas envelope and the andesite propeller are the factory ship beside it."
	]
	quest.1FBE189EB3E6A3C1.title: "Andesite Propeller"
	quest.1FBE189EB3E6A3C1.quest_subtitle: "Machine plus the aircraft prop"
	quest.1FBE189EB3E6A3C1.quest_desc: [
		"The andesite propeller is the factory propeller, an Andesite Machine applied to the aircraft propeller."
		"The airship line spins it."
	]
	quest.3F57748D80359EF6.title: "Gas Envelope"
	quest.3F57748D80359EF6.quest_subtitle: "The balloon"
	quest.3F57748D80359EF6.quest_desc: [
		"The gas envelope is the balloon of an Aeronautics airship."
		"The propeller bearing hangs the screw under it."
	]
	quest.4BE9B3642F8D9EB6.title: "Propeller Bearing"
	quest.4BE9B3642F8D9EB6.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.4BE9B3642F8D9EB6.quest_desc: [
		"The propeller bearing is the mount the andesite propeller spins on."
		"It is the hinge between the envelope and the engine."
	]
	quest.044B37BCECAC6250.title: "Create Jetpack"
	quest.044B37BCECAC6250.quest_subtitle: "When a ship is too much"
	quest.044B37BCECAC6250.quest_desc: [
		"The Create jetpack is a worn engine, flight without a hull."
		"Skyworthy is still the attribute that lets you leave for good."
	]
	quest.7D1250D39EDB5C02.title: "Skyworthy"
	quest.7D1250D39EDB5C02.quest_subtitle: "Two ways off the ground"
	quest.7D1250D39EDB5C02.quest_desc: [
		"Skyworthy is the attribute that lets you fly to leave."
		"The rocket chapter treats it as the door out of the sky."
	]
	quest.7650D7E4FE40E2C7.quest_subtitle: "Optional, and not the gate"
	quest.7650D7E4FE40E2C7.quest_desc: [
		"The angelic feather is a charm at the end of the sky chapter."
		"It spends itself to pull you back from a fatal fall."
	]
	quest.6600000000000001.title: "Tree Bark"
	quest.6600000000000001.quest_subtitle: "The knife takes a strip"
	quest.6600000000000001.quest_desc: [
		"Tree bark comes from cutting a log on the cutting board, which also returns the stripped log."
	]
	quest.6600000000000002.title: "Straw"
	quest.6600000000000002.quest_subtitle: "Cut the wheat"
	quest.6600000000000002.quest_desc: [
		"Straw comes from cutting grain on the cutting board."
		"Canvas is made from it."
	]
	quest.6600000000000003.title: "Canvas"
	quest.6600000000000003.quest_subtitle: "Straw, woven"
	quest.6600000000000003.quest_desc: [
		"Canvas is cloth made from straw."
		"The safety net is made from canvas."
	]
	quest.6600000000000004.title: "Safety Net"
	quest.6600000000000004.quest_subtitle: "Rope and canvas"
	quest.6600000000000004.quest_desc: [
		"The safety net is made from canvas, and you place it to catch a fall."
	]
	quest.6600000000000005.title: "Organic Compost"
	quest.6600000000000005.quest_subtitle: "The pile before the soil"
	quest.6600000000000005.quest_desc: [
		"Organic compost is the block that becomes rich soil."
	]
	quest.6600000000000006.title: "Rich Soil"
	quest.6600000000000006.quest_subtitle: "Let the compost ripen"
	quest.6600000000000006.quest_desc: [
		"Rich soil is what organic compost becomes, and crops are grown in it."
	]
	quest.6600000000000007.title: "Oak Cabinet"
	quest.6600000000000007.quest_subtitle: "A kitchen crate"
	quest.6600000000000007.quest_desc: [
		"The oak cabinet stores food."
	]
	quest.6600000000000008.title: "Basket"
	quest.6600000000000008.quest_subtitle: "It strains when waterlogged"
	quest.6600000000000008.quest_desc: [
		"The basket is a container, and in this pack it strains fluids when waterlogged."
	]
	quest.6600000000000009.title: "Rice Bag"
	quest.6600000000000009.quest_subtitle: "The crop, stored"
	quest.6600000000000009.quest_desc: [
		"The rice bag stores rice."
	]
	quest.660000000000000A.title: "Honey Glazed Ham"
	quest.660000000000000A.quest_subtitle: "The pot's feast"
	quest.660000000000000A.quest_desc: [
		"Honey glazed ham is a cooking-pot feast, a peer of shepherd's pie and roast chicken."
	]
	quest.660000000000000B.title: "Iron Backpack"
	quest.660000000000000B.quest_subtitle: "The first real tier"
	quest.660000000000000B.quest_desc: [
		"The iron backpack is the first metal backpack."
		"The copper tier is hidden."
	]
	quest.660000000000000C.title: "Gold Backpack"
	quest.660000000000000C.quest_subtitle: "Heavier cloth"
	quest.660000000000000C.quest_desc: [
		"The gold backpack is the metal backpack above iron."
	]
	quest.660000000000000D.title: "Diamond Backpack"
	quest.660000000000000D.quest_subtitle: "The deep pocket"
	quest.660000000000000D.quest_desc: [
		"The diamond backpack is the metal backpack above gold."
	]
	quest.660000000000000E.title: "Netherite Backpack"
	quest.660000000000000E.quest_subtitle: "The last backpack"
	quest.660000000000000E.quest_desc: [
		"The netherite backpack is the top backpack."
		"The omega and inception upgrades are hidden and are not a further tier."
	]
	quest.660000000000000F.title: "Iron Chest"
	quest.660000000000000F.quest_subtitle: "Skip the copper tier"
	quest.660000000000000F.quest_desc: [
		"The iron chest is the first metal chest."
		"Copper chests are hidden."
	]
	quest.6600000000000010.title: "Gold Chest"
	quest.6600000000000010.quest_subtitle: "The middle tier"
	quest.6600000000000010.quest_desc: [
		"The gold chest is the metal chest above iron."
	]
	quest.6600000000000011.title: "Diamond Chest"
	quest.6600000000000011.quest_subtitle: "Before the link"
	quest.6600000000000011.quest_desc: [
		"The diamond chest is the metal chest above gold."
	]
	quest.6600000000000012.title: "Storage Controller"
	quest.6600000000000012.quest_subtitle: "One inventory"
	quest.6600000000000012.quest_desc: [
		"The storage controller links touching chests into one inventory."
	]
	quest.6600000000000013.title: "Storage Link"
	quest.6600000000000013.quest_subtitle: "A remote face"
	quest.6600000000000013.quest_desc: [
		"The storage link connects a controller network to another place."
	]
	quest.6600000000000014.title: "Storage IO"
	quest.6600000000000014.quest_subtitle: "In and out"
	quest.6600000000000014.quest_desc: [
		"Storage IO connects a network so items can move in and out."
	]
	quest.6600000000000015.title: "Decoration Table"
	quest.6600000000000015.quest_subtitle: "Paint the chest"
	quest.6600000000000015.quest_desc: [
		"The decoration table recolours a chest or barrel."
	]
	quest.6600000000000016.title: "Netherite Chest"
	quest.6600000000000016.quest_subtitle: "The last chest"
	quest.6600000000000016.quest_desc: [
		"The netherite chest is the top chest."
	]
	quest.6600000000000017.title: "Angling Table"
	quest.6600000000000017.quest_subtitle: "The tackle bench"
	quest.6600000000000017.quest_desc: [
		"The angling table is a dock machine."
		"It is the bench for rods and tackle."
	]
	quest.6600000000000018.title: "Lunar Calendar"
	quest.6600000000000018.quest_subtitle: "What the moon does to the bite"
	quest.6600000000000018.quest_desc: [
		"The lunar calendar is a dock machine."
		"It tracks the moon phase that changes the bite."
	]
	quest.6600000000000019.title: "Weather Radio"
	quest.6600000000000019.quest_subtitle: "Listen before you cast"
	quest.6600000000000019.quest_desc: [
		"The weather radio is a dock machine."
		"It reports the weather that changes which fish bite."
	]
	quest.660000000000001A.title: "Fish Display"
	quest.660000000000001A.quest_subtitle: "Mount the catch"
	quest.660000000000001A.quest_desc: [
		"The fish display is a dock machine."
		"It mounts a caught fish for show."
	]
	quest.660000000000001B.title: "Jelly Torch"
	quest.660000000000001B.quest_subtitle: "A light that came out of the water"
	quest.660000000000001B.quest_desc: [
		"The jelly torch is a dock machine."
		"It lights the dock."
	]
	quest.660000000000001C.title: "Purpur Crate"
	quest.660000000000001C.quest_subtitle: "The end-stone cooler"
	quest.660000000000001C.quest_desc: [
		"A purpur crate stores fish."
		"It sits between the wooden crate and the obsidian crate."
	]
	quest.660000000000001D.title: "Obsidian Crate"
	quest.660000000000001D.quest_subtitle: "The last crate"
	quest.660000000000001D.quest_desc: [
		"The obsidian crate stores fish and ends the crate line."
		"The rod line ends at the Midas rod, not at this crate."
	]
	quest.660000000000001E.title: "Advanced Computer"
	quest.660000000000001E.quest_subtitle: "Gold, and the help command"
	quest.660000000000001E.quest_desc: [
		"The advanced computer is the top computer."
	]
	quest.660000000000001F.title: "Advanced Monitor"
	quest.660000000000001F.quest_subtitle: "A sharper screen"
	quest.660000000000001F.quest_desc: [
		"The advanced monitor is the top screen."
	]
	quest.6600000000000020.title: "Full Wired Modem"
	quest.6600000000000020.quest_subtitle: "The block that faces every side"
	quest.6600000000000020.quest_desc: [
		"The full wired modem is a peripheral that networks every face of a block."
	]
	quest.6600000000000021.title: "Advanced Wireless Modem"
	quest.6600000000000021.quest_subtitle: "The ender one"
	quest.6600000000000021.quest_desc: [
		"The advanced wireless modem is the long-range wireless peripheral."
	]
	quest.6600000000000022.title: "Speaker"
	quest.6600000000000022.quest_subtitle: "The computer makes noise"
	quest.6600000000000022.quest_desc: [
		"The speaker is a peripheral the computer plays sound through."
	]
	quest.6600000000000023.title: "Printer"
	quest.6600000000000023.quest_subtitle: "Paper out of the computer"
	quest.6600000000000023.quest_desc: [
		"The printer is a peripheral that prints pages from the computer."
	]
	quest.6600000000000024.title: "Redstone Relay"
	quest.6600000000000024.quest_subtitle: "A computer-side redstone face"
	quest.6600000000000024.quest_desc: [
		"The redstone relay is a peripheral that passes redstone to and from the computer."
	]
	quest.6600000000000025.title: "Digital Adapter"
	quest.6600000000000025.quest_subtitle: "The computer plugs into Create"
	quest.6600000000000025.quest_desc: [
		"Connects Create rotational displays and speed controllers to ComputerCraft networks—check EMI for its recipe."
		"It lets a computer talk to Create."
	]
	quest.6600000000000026.title: "Advanced Turtle"
	quest.6600000000000026.quest_subtitle: "The last computer"
	quest.6600000000000026.quest_desc: [
		"The advanced turtle is the top turtle, a computer that moves."
	]
	quest.6600000000000027.title: "CAD Assembler"
	quest.6600000000000027.quest_subtitle: "The bench from the encyclopaedia"
	quest.6600000000000027.quest_desc: [
		"The CAD assembler is the station that builds a CAD."
		"The basic battery, core, and socket are put together here."
	]
	quest.6600000000000028.title: "Basic CAD Core"
	quest.6600000000000028.quest_subtitle: "The heart of the tool"
	quest.6600000000000028.quest_desc: [
		"The basic core is the first core."
		"It is the processor inside a CAD."
	]
	quest.6600000000000029.title: "Basic CAD Socket"
	quest.6600000000000029.quest_subtitle: "Where the bullet sits"
	quest.6600000000000029.quest_desc: [
		"The basic socket is the first socket."
		"It is the slot in a CAD that holds the spell bullet."
	]
	quest.660000000000002A.title: "CAD"
	quest.660000000000002A.quest_subtitle: "Assemble the tool"
	quest.660000000000002A.quest_desc: [
		"The CAD is the gun."
		"It casts the spell loaded in its bullet."
	]
	quest.660000000000002B.title: "Psimetal Block"
	quest.660000000000002B.quest_subtitle: "Dust, pressed"
	quest.660000000000002B.quest_desc: [
		"A psimetal block stores psimetal."
		"It is a decorative and storage form of that metal."
	]
	quest.660000000000002C.title: "Psigem Block"
	quest.660000000000002C.quest_subtitle: "The gem, stored"
	quest.660000000000002C.quest_desc: [
		"A psigem block stores psigem."
		"It is a decorative and storage form of that gem."
	]
	quest.660000000000002D.title: "Ivory Psimetal"
	quest.660000000000002D.quest_subtitle: "One of the two colours"
	quest.660000000000002D.quest_desc: [
		"Ivory psimetal is a pale storage block of psimetal."
		"It is a decorative form of the metal."
	]
	quest.660000000000002E.title: "Ebony Psimetal"
	quest.660000000000002E.quest_subtitle: "The other colour"
	quest.660000000000002E.quest_desc: [
		"Ebony psimetal is a dark storage block of psimetal."
		"It is the other decorative form, beside ivory."
	]
	quest.660000000000002F.title: "Large Cogwheel"
	quest.660000000000002F.quest_subtitle: "The slow gear"
	quest.660000000000002F.quest_desc: [
		"A large cogwheel meshes with a small cog at a right angle and changes the speed."
		"It is the slow gear, and a chain conveyor uses one as well."
	]
	quest.6600000000000030.title: "Gearbox"
	quest.6600000000000030.quest_subtitle: "Turn the shaft"
	quest.6600000000000030.quest_desc: [
		"A gearbox takes one shaft and sends that rotation out the other faces."
		"Built directly from Andesite Alloy and shafts—check EMI for the standard Create recipe."
	]
	quest.6600000000000031.title: "Clutch"
	quest.6600000000000031.quest_subtitle: "A redstone brake"
	quest.6600000000000031.quest_desc: [
		"A clutch disconnects a shaft when it receives redstone."
		"It is the brake on a kinetic line."
	]
	quest.6600000000000032.title: "Gearshift"
	quest.6600000000000032.quest_subtitle: "Forward and back"
	quest.6600000000000032.quest_desc: [
		"A gearshift reverses a shaft when redstone turns on."
		"The Programmable Gearshift version that plays a whole sequence is a later Brass-tier craft."
	]
	quest.6600000000000033.title: "Encased Chain Drive"
	quest.6600000000000033.quest_subtitle: "Carry rotation along a line"
	quest.6600000000000033.quest_desc: [
		"An encased chain drive carries rotation along a face and around a corner."
		"It is the long link for rotation, before a belt is moving items."
	]
	quest.6600000000000034.title: "Millstone"
	quest.6600000000000034.quest_subtitle: "Grind by hand first"
	quest.6600000000000034.quest_desc: [
		"A millstone grinds items on a shaft into dusts and flour."
		"It also mills netherrack into cinder flour, which is the start of a blaze cake. A hand crank can turn it."
	]
	quest.6600000000000035.title: "Belt"
	quest.6600000000000035.quest_subtitle: "Dried kelp"
	quest.6600000000000035.quest_desc: [
		"A belt carries items between machines. Six dried kelp make one connector."
	]
	quest.6600000000000036.title: "Basin"
	quest.6600000000000036.quest_subtitle: "The pot the machines share"
	quest.6600000000000036.quest_desc: [
		"A basin is the pot a mixer, a press, or a fan works in."
		"Items and fluids both sit here while the machine above them runs."
	]
	quest.6600000000000037.title: "Encased Fan"
	quest.6600000000000037.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000037.quest_desc: [
		"An encased fan uses its standard mod crafting recipe (check EMI)."
		"Aimed at a basin it washes, smokes, blasts, or haunts, depending on what sits behind the fan."
	]
	quest.6600000000000038.title: "Mechanical Press"
	quest.6600000000000038.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000038.quest_desc: [
		"A mechanical press uses its standard mod crafting recipe (check EMI)."
		"It presses ingots into sheets and packs items in a basin."
	]
	quest.6600000000000039.title: "Mechanical Mixer"
	quest.6600000000000039.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000039.quest_desc: [
		"A mechanical mixer uses its standard mod crafting recipe (check EMI)."
		"Heated, copper and zinc become brass. Unheated, andesite and nuggets become alloy. Superheated, with a blaze cake under the burner, an iron ingot becomes molten iron."
	]
	quest.660000000000003A.title: "Mechanical Drill"
	quest.660000000000003A.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000003A.quest_desc: [
		"A mechanical drill uses its standard mod crafting recipe (check EMI)."
		"On a moving contraption it breaks the blocks in front of it."
	]
	quest.660000000000003B.title: "Mechanical Saw"
	quest.660000000000003B.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000003B.quest_desc: [
		"A mechanical saw uses its standard mod crafting recipe (check EMI)."
		"It cuts logs into planks and strips, and it saws a klaxium ingot into spikes."
	]
	quest.660000000000003C.title: "Andesite Funnel"
	quest.660000000000003C.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000003C.quest_desc: [
		"An andesite funnel uses its standard mod crafting recipe (check EMI)."
		"It pulls items out of inventories and pushes them onto belts."
	]
	quest.660000000000003D.title: "Mechanical Harvester"
	quest.660000000000003D.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000003D.quest_desc: [
		"A mechanical harvester uses its standard mod crafting recipe (check EMI)."
		"On a moving contraption it harvests a row of crops."
	]
	quest.660000000000003E.title: "Mechanical Plough"
	quest.660000000000003E.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000003E.quest_desc: [
		"A mechanical plough uses its standard mod crafting recipe (check EMI)."
		"It tills soil and clears plants in front of a moving contraption."
	]
	quest.660000000000003F.title: "Contraption Controls"
	quest.660000000000003F.quest_subtitle: "Tube, casing, a button"
	quest.660000000000003F.quest_desc: [
		"Contraption controls are an electron tube, an andesite casing, and a button."
		"Glue them onto a contraption so redstone can start, stop, or steer it."
	]
	quest.6600000000000040.title: "Cart Assembler"
	quest.6600000000000040.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000040.quest_desc: [
		"A cart assembler uses its standard mod crafting recipe (check EMI)."
		"It assembles a minecart contraption from the blocks above the rail."
	]
	quest.6600000000000041.title: "Copper Backtank"
	quest.6600000000000041.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000041.quest_desc: [
		"A copper backtank uses its standard mod crafting recipe (check EMI)."
		"It stores air for diving and for tools that breathe from your back."
	]
	quest.6600000000000042.title: "Spout"
	quest.6600000000000042.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000042.quest_desc: [
		"A spout is crafted from copper casing and dried kelp."
		"It pours the lava that finishes a blaze cake, and the 10 mB of molten iron that fills an electron tube. It does not need a tube of its own."
	]
	quest.6600000000000043.title: "Item Drain"
	quest.6600000000000043.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000043.quest_desc: [
		"An item drain uses its standard mod crafting recipe (check EMI)."
		"Buckets and tanks set on it empty into the pipe network."
	]
	quest.6600000000000044.title: "Hose Pulley"
	quest.6600000000000044.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000044.quest_desc: [
		"A hose pulley uses its standard mod crafting recipe (check EMI)."
		"It pumps a body of fluid out of the world, or places one."
	]
	quest.6600000000000045.title: "Smart Fluid Pipe"
	quest.6600000000000045.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000045.quest_desc: [
		"A smart fluid pipe uses its standard mod crafting recipe (check EMI)."
		"A filter in the pipe lets one fluid through and stops the rest."
	]
	quest.6600000000000046.title: "Train Controls"
	quest.6600000000000046.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000046.quest_desc: [
		"Train controls are crafted with railway casing and precision components (check EMI)."
		"This is the lever that drives a train."
	]
	quest.6600000000000047.title: "Train Station"
	quest.6600000000000047.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000047.quest_desc: [
		"A train station uses its standard mod crafting recipe (check EMI)."
		"A schedule stops the train at the stations you name."
	]
	quest.6600000000000048.title: "Train Signal"
	quest.6600000000000048.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000048.quest_desc: [
		"A train signal uses its standard mod crafting recipe (check EMI)."
		"Signals keep two trains off the same stretch of track."
	]
	quest.6600000000000049.title: "Schedule"
	quest.6600000000000049.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000049.quest_desc: [
		"A schedule uses its standard mod crafting recipe (check EMI)."
		"It lists the stops a train will make, and the enchantment handbook is built from one."
	]
	quest.660000000000004A.title: "Brass Hand"
	quest.660000000000004A.quest_subtitle: "The deployer's glove"
	quest.660000000000004A.quest_desc: [
		"A brass hand is the glove a deployer is built from."
		"It is andesite alloy and brass plates. A brass plate is a brass ingot through a press. Golden sheets are not the ingredient."
	]
	quest.660000000000004B.title: "Deployer"
	quest.660000000000004B.quest_subtitle: "Tube, casing, brass hand"
	quest.660000000000004B.quest_desc: [
		"A deployer is an electron tube, an andesite casing, and a brass hand."
		"It places and uses items. It builds precision mechanisms, train track, and walker parts. It does not build electron tubes."
	]
	quest.660000000000004C.title: "Mechanical Crafter"
	quest.660000000000004C.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000004C.quest_desc: [
		"A mechanical crafter uses its standard mod crafting recipe (check EMI)."
		"Set several in a grid and they run shaped crafts on their own."
	]
	quest.660000000000004D.title: "Steam Engine"
	quest.660000000000004D.quest_subtitle: "Alloy, copper, gold plate"
	quest.660000000000004D.quest_desc: [
		"A steam engine is andesite alloy, a copper block, and a gold plate."
		"It turns steam from a boiler into a large amount of rotation."
	]
	quest.660000000000004E.title: "Rotation Speed Controller"
	quest.660000000000004E.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000004E.quest_desc: [
		"A rotation speed controller uses its standard mod crafting recipe (check EMI)."
		"Scroll the face to lock the outgoing shaft at one chosen speed."
	]
	quest.660000000000004F.title: "Sequenced Gearshift"
	quest.660000000000004F.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000004F.quest_desc: [
		"A sequenced gearshift uses its standard mod crafting recipe (check EMI)."
		"It plays a saved pattern of directions and pauses, which is how a timed contraption steps."
	]
	quest.6600000000000050.title: "Brass Tunnel"
	quest.6600000000000050.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000050.quest_desc: [
		"A brass tunnel uses its standard mod crafting recipe (check EMI)."
		"It splits, merges, and filters the items on a belt."
	]
	quest.6600000000000051.title: "Smart Chute"
	quest.6600000000000051.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000051.quest_desc: [
		"A smart chute uses its standard mod crafting recipe (check EMI)."
		"Items fall through it, and a filter holds back what should stay put."
	]
	quest.6600000000000052.title: "Clockwork Bearing"
	quest.6600000000000052.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000052.quest_desc: [
		"A clockwork bearing uses its standard mod crafting recipe (check EMI)."
		"It assembles a contraption, winds the motion, and then runs it."
	]
	quest.6600000000000053.title: "Elevator Pulley"
	quest.6600000000000053.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000053.quest_desc: [
		"An elevator pulley uses its standard mod crafting recipe (check EMI)."
		"It lifts an elevator contraption between the floors you mark on the line."
	]
	quest.6600000000000054.title: "Display Link"
	quest.6600000000000054.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000054.quest_desc: [
		"A display link uses its standard mod crafting recipe (check EMI)."
		"It copies a stress, inventory, or fluid reading onto a display or a sign."
	]
	quest.6600000000000055.title: "Mechanical Arm"
	quest.6600000000000055.quest_subtitle: "The last brass hand"
	quest.6600000000000055.quest_desc: [
		"A mechanical arm uses its standard mod crafting recipe (check EMI)."
		"It picks a filtered item from one inventory and sets it on another."
	]
	quest.6600000000000056.title: "Small Light Connector"
	quest.6600000000000056.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000056.quest_desc: [
		"A small light connector uses its standard mod crafting recipe (check EMI)."
		"It joins the energy network and lights the block it sits on."
	]
	quest.6600000000000057.title: "Redstone Relay"
	quest.6600000000000057.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000057.quest_desc: [
		"A redstone relay uses its standard mod crafting recipe (check EMI)."
		"It reads the energy network and emits redstone from that reading."
	]
	quest.6600000000000058.title: "Electric Motor"
	quest.6600000000000058.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000058.quest_desc: [
		"An electric motor uses its standard mod crafting recipe (check EMI)."
		"It turns energy from the wire into rotation."
	]
	quest.6600000000000059.title: "Tesla Coil"
	quest.6600000000000059.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.6600000000000059.quest_desc: [
		"A tesla coil uses its standard mod crafting recipe (check EMI)."
		"It charges items from the energy network, which is how an accumulator fills."
	]
	quest.660000000000005A.title: "Portable Energy Interface"
	quest.660000000000005A.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000005A.quest_desc: [
		"A portable energy interface uses its standard mod crafting recipe (check EMI)."
		"A contraption carries energy in and out through this face."
	]
	quest.660000000000005B.title: "Modular Accumulator"
	quest.660000000000005B.quest_subtitle: "Brass, batteries, no alternator"
	quest.660000000000005B.quest_desc: [
		"A modular accumulator is mechanical crafting from brass casings, brass sheets, and power-grid batteries."
		"It stores energy for the wire network, and this pack has no alternator and no capacitor."
	]
	quest.660000000000005C.title: "Bulk Fermenter"
	quest.660000000000005C.quest_subtitle: "The vat, not a lava tap"
	quest.660000000000005C.quest_desc: [
		"The bulk fermenter is the vat for fermenting in quantity, and the craft ships with the mod."
		"Lava fermenting is removed, so cobble will not become lava here."
	]
	quest.660000000000005D.title: "Burner"
	quest.660000000000005D.quest_subtitle: "Heat for the vat"
	quest.660000000000005D.quest_desc: [
		"The burner drinks a flammable liquid and heats the basin above it."
		"Heated mixing and the distillation tower both want that heat, and the craft ships with the mod."
	]
	quest.660000000000005E.title: "Diesel Engine"
	quest.660000000000005E.quest_subtitle: "Brass-age, mod recipe"
	quest.660000000000005E.quest_desc: [
		"A diesel engine turns diesel or gasoline into rotation, and the craft ships with the mod."
		"It is the first fuel engine, and redstone can stop it."
	]
	quest.660000000000005F.title: "Large Diesel Engine"
	quest.660000000000005F.quest_subtitle: "The middle engine"
	quest.660000000000005F.quest_desc: [
		"The large diesel engine is the middle engine, and the craft ships with the mod."
		"Engines in this tier stack, and the stress on the shaft grows with the stack."
	]
	quest.6600000000000060.title: "Distillation Controller"
	quest.6600000000000060.quest_subtitle: "Split the oil"
	quest.6600000000000060.quest_desc: [
		"A distillation controller splits heated crude oil into diesel, gasoline, and the heavier fractions."
		"It is crafted from andesite alloy, an iron plate, a clock, and fluid pipes. The pumpjack feeds it, and the engines drink what comes out."
	]
	quest.6600000000000061.title: "Pumpjack Hole"
	quest.6600000000000061.quest_subtitle: "The well head"
	quest.6600000000000061.quest_desc: [
		"The pumpjack hole is the well block at the bottom of the pipe."
		"Crude oil comes out here once the head and the crank are pumping."
	]
	quest.6600000000000062.title: "Pumpjack Head"
	quest.6600000000000062.quest_subtitle: "The horse head"
	quest.6600000000000062.quest_desc: [
		"The pumpjack head is the nodding end of the well."
		"With the crank turning, it pulls crude oil up to the hole."
	]
	quest.6600000000000063.title: "Pumpjack Crank"
	quest.6600000000000063.quest_subtitle: "The wheel"
	quest.6600000000000063.quest_desc: [
		"The pumpjack crank takes rotation and drives the pumpjack."
		"Hole, head, and crank together are the well that feeds the distillation controller."
	]
	quest.6600000000000064.title: "Huge Diesel Engine"
	quest.6600000000000064.quest_subtitle: "The last engine"
	quest.6600000000000064.quest_desc: [
		"The huge diesel engine is the capstone of the fuel line, and the craft ships with the mod."
		"Give it fuel and a shaft if you want the room to know the diesel line is finished."
	]
	quest.6600000000000065.title: "Grindstone Drain"
	quest.6600000000000065.quest_subtitle: "Experience out of the wheel"
	quest.6600000000000065.quest_desc: [
		"The grindstone drain has no crafting recipe. It can be found as loot."
		"The mechanical grindstone is the machine this line builds. A drain placed under it catches the liquid experience, and pipes take that fluid on to the hatch, the lantern, and the enchanter."
	]
	quest.6600000000000066.title: "Experience Hatch"
	quest.6600000000000066.quest_subtitle: "A door for the fluid"
	quest.6600000000000066.quest_desc: [
		"An experience hatch is the port on a tank of liquid experience."
		"Through it, a player stores levels in the tank or draws them back out."
	]
	quest.6600000000000067.title: "Experience Lantern"
	quest.6600000000000067.quest_subtitle: "A light that eats levels"
	quest.6600000000000067.quest_desc: [
		"An experience lantern holds liquid experience, pulls in nearby orbs, and glows."
		"It is a small tank you can also pour levels into."
	]
	quest.6600000000000068.title: "Blaze Forger"
	quest.6600000000000068.quest_subtitle: "The anvil that burns"
	quest.6600000000000068.quest_desc: [
		"A blaze forger is the forging half of the liquid-experience machines."
		"It applies and strengthens enchantments with that fluid and blaze heat."
	]
	quest.6600000000000069.title: "Blaze Enchanter"
	quest.6600000000000069.quest_subtitle: "The last enchanting machine"
	quest.6600000000000069.quest_desc: [
		"The blaze enchanter is the capstone of this line."
		"It spends liquid experience to enchant gear and to write those enchantments into a template."
	]
	quest.660000000000006A.title: "Levitite"
	quest.660000000000006A.quest_subtitle: "An iron pick is enough"
	quest.660000000000006A.quest_desc: [
		"Levitite is the buoyant ore, and an iron pick mines it in this pack."
		"Loose pieces float, and the blend is the step toward pearlescent levitite."
	]
	quest.660000000000006B.title: "Levitite Blend"
	quest.660000000000006B.quest_subtitle: "A heated fluid"
	quest.660000000000006B.quest_desc: [
		"Levitite blend is a fluid, not a dust. A heated mixer takes four end stone powder, two zinc nuggets, and 500 mB of water, and it makes 500 mB of blend."
		"End stone powder is crushed end stone. Bucket the blend out of the basin. There is no levitite blend item."
	]
	quest.660000000000006C.title: "Pearlescent Levitite"
	quest.660000000000006C.quest_subtitle: "Soul sand in a basin"
	quest.660000000000006C.quest_desc: [
		"Heat-compact 500 mB of levitite blend with soul sand or soul soil. One mixing batch of blend is 500 mB."
		"That is the same soul fire that turns a pool of blend pink. Regular levitite is still the heat crystallization."
	]
	quest.660000000000006D.title: "Andesite Propeller"
	quest.660000000000006D.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000006D.quest_desc: [
		"An andesite propeller uses its standard mod crafting recipe (check EMI)."
		"It spins on a propeller bearing for thrust, and a wooden propeller converts into one."
	]
	quest.660000000000006E.title: "Gyroscopic Bearing"
	quest.660000000000006E.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000006E.quest_desc: [
		"A gyroscopic propeller bearing uses its standard mod crafting recipe (check EMI)."
		"It holds a propeller steady while the ship tilts around it."
	]
	quest.660000000000006F.title: "Smart Propeller"
	quest.660000000000006F.quest_subtitle: "The last propeller"
	quest.660000000000006F.quest_desc: [
		"A smart propeller uses its standard mod crafting recipe (check EMI)."
		"With the gyroscopic bearing and pearlescent levitite, it closes the airship line."
	]
	quest.6600000000000070.title: "Coke Oven"
	quest.6600000000000070.quest_subtitle: "Bricks, then the oven"
	quest.6600000000000070.quest_desc: [
		"The coke oven is an early multiblock that cooks coal into coke and creosote for treated wood."
		"Coke block crafts are removed, and creosote is not generator fuel."
	]
	quest.6600000000000071.title: "Blast Furnace"
	quest.6600000000000071.quest_subtitle: "Steel starts here"
	quest.6600000000000071.quest_desc: [
		"The blast furnace is an early multiblock that smelts steel."
	]
	quest.6600000000000072.title: "Treated Wood"
	quest.6600000000000072.quest_subtitle: "Creosote into the plank"
	quest.6600000000000072.quest_desc: [
		"Treated wood is creosote-soaked wood, and Immersive Engineering machines are built from it."
	]
	quest.6600000000000073.title: "Metal Press"
	quest.6600000000000073.quest_subtitle: "Wires are pressed"
	quest.6600000000000073.quest_desc: [
		"The metal press forms plates and wires."
		"Wires are pressed here, not sawn."
	]
	quest.6600000000000074.title: "LV Capacitor"
	quest.6600000000000074.quest_subtitle: "The first battery"
	quest.6600000000000074.quest_desc: [
		"The LV capacitor stores low-voltage Immersive Engineering power."
		"The dynamo, watermill, windmill, and thermoelectric generator are removed."
	]
	quest.6600000000000075.title: "LV Coil"
	quest.6600000000000075.quest_subtitle: "The first connector's heart"
	quest.6600000000000075.quest_desc: [
		"The LV coil is the wire winding for low-voltage machines."
	]
	quest.6600000000000076.title: "Light Engineering"
	quest.6600000000000076.quest_subtitle: "The stage 3 block"
	quest.6600000000000076.quest_desc: [
		"Light engineering is the stage 3 gate."
		"The later petroleum multiblocks and the fission power capstone wait on it."
	]
	quest.6600000000000077.title: "Heavy Engineering"
	quest.6600000000000077.quest_subtitle: "The thick block"
	quest.6600000000000077.quest_desc: [
		"Heavy engineering is the reinforced frame of the arc furnace, the excavator, and the diesel generator."
	]
	quest.6600000000000078.title: "MV Capacitor"
	quest.6600000000000078.quest_subtitle: "The middle battery"
	quest.6600000000000078.quest_desc: [
		"The MV capacitor stores medium-voltage Immersive Engineering power."
	]
	quest.6600000000000079.title: "HV Capacitor"
	quest.6600000000000079.quest_subtitle: "The last battery"
	quest.6600000000000079.quest_desc: [
		"The HV capacitor stores high-voltage Immersive Engineering power."
	]
	quest.660000000000007A.title: "Diesel Generator"
	quest.660000000000007A.quest_subtitle: "FE from diesel"
	quest.660000000000007A.quest_desc: [
		"The diesel generator is the multiblock that turns diesel into Immersive Engineering power."
		"The biodiesel refinery and the fermenter are removed, and creosote is not generator fuel."
	]
	quest.660000000000007B.title: "Arc Furnace"
	quest.660000000000007B.quest_subtitle: "The last furnace"
	quest.660000000000007B.quest_desc: [
		"The arc furnace is a multiblock capstone that smelts with graphite electrodes."
	]
	quest.660000000000007C.title: "Excavator"
	quest.660000000000007C.quest_subtitle: "The last machine"
	quest.660000000000007C.quest_desc: [
		"The excavator is a multiblock capstone that mines mineral deposits."
	]
	quest.660000000000007D.title: "Derrick"
	quest.660000000000007D.quest_subtitle: "The tower over the well"
	quest.660000000000007D.quest_desc: [
		"The derrick is the tower over an oil reservoir, and it waits on light engineering."
	]
	quest.660000000000007E.title: "Pumpjack"
	quest.660000000000007E.quest_subtitle: "The well that pumps"
	quest.660000000000007E.quest_desc: [
		"The pumpjack lifts crude oil, and it waits on light engineering."
	]
	quest.660000000000007F.title: "Oil Tank"
	quest.660000000000007F.quest_subtitle: "Hold the crude"
	quest.660000000000007F.quest_desc: [
		"The oil tank stores crude oil, and it waits on light engineering."
	]
	quest.6600000000000080.title: "Flarestack"
	quest.6600000000000080.quest_subtitle: "Burn the gas"
	quest.6600000000000080.quest_desc: [
		"The flarestack burns excess gas from the well, and it waits on light engineering."
		"The gas generator is removed."
	]
	quest.6600000000000081.title: "Coker Unit"
	quest.6600000000000081.quest_subtitle: "The heavy fraction"
	quest.6600000000000081.quest_desc: [
		"The coker unit handles the heavy fraction of the oil, and it waits on light engineering."
	]
	quest.6600000000000082.title: "Distillation Tower"
	quest.6600000000000082.quest_subtitle: "The last petroleum machine"
	quest.6600000000000082.quest_desc: [
		"The distillation tower is the end of Immersive Petroleum, and it splits crude oil into its products."
	]
	quest.6600000000000083.title: "Fluix Casing"
	quest.6600000000000083.quest_subtitle: "Two from a casing and enriched iron"
	quest.6600000000000083.quest_desc: [
		"Fluix casing is a shapeless craft of quartz enriched iron and a machine casing, and it makes two."
		"The controller is built from it."
	]
	quest.6600000000000084.title: "Controller"
	quest.6600000000000084.quest_subtitle: "Casing around a calculation mechanism"
	quest.6600000000000084.quest_desc: [
		"The controller recipe is removed, and the live craft is a donut of fluix casing around a calculation mechanism."
		"The controller runs the storage network."
	]
	quest.6600000000000085.title: "Construction Core"
	quest.6600000000000085.quest_subtitle: "Apply the controller"
	quest.6600000000000085.quest_desc: [
		"The construction core applies the controller onto glowstone and makes four."
		"It is the part that pushes items out of the network."
	]
	quest.6600000000000086.title: "Destruction Core"
	quest.6600000000000086.quest_subtitle: "The other core"
	quest.6600000000000086.quest_desc: [
		"The destruction core applies the controller onto quartz and makes four."
		"It is the part that pulls items into the network."
	]
	quest.6600000000000087.title: "Pattern"
	quest.6600000000000087.quest_subtitle: "A mechanism in the middle"
	quest.6600000000000087.quest_desc: [
		"The pattern is the blank autocrafting record."
		"This pack crafts it from glass, redstone, a calculation mechanism, and quartz enriched iron."
	]
	quest.6600000000000088.title: "Grid"
	quest.6600000000000088.quest_subtitle: "Improved processor, then the controller"
	quest.6600000000000088.quest_desc: [
		"The grid applies the controller onto an improved processor."
		"It is the screen for searching and pulling from the network."
	]
	quest.6600000000000089.title: "Wireless Transmitter"
	quest.6600000000000089.quest_subtitle: "The controller and an ender pearl"
	quest.6600000000000089.quest_desc: [
		"The wireless transmitter applies the controller onto an ender pearl."
		"It links a wireless grid to the network."
	]
	quest.660000000000008A.title: "Autocrafter"
	quest.660000000000008A.quest_subtitle: "Patterns, on the network"
	quest.660000000000008A.quest_desc: [
		"The autocrafter runs patterns and crafts items from the network."
	]
	quest.660000000000008B.title: "Disk Drive"
	quest.660000000000008B.quest_subtitle: "The last storage machine"
	quest.660000000000008B.quest_desc: [
		"The disk drive applies the controller onto an advanced processor."
		"It holds the disks that store the network's items."
	]
	quest.660000000000008C.title: "Cobblestone Generator"
	quest.660000000000008C.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.660000000000008C.quest_desc: [
		"Generates cobblestone passively—check EMI for its standard mod recipe."
		"The compact and dense cobblestone generators are removed."
	]
	quest.660000000000008D.title: "Decay Generator"
	quest.660000000000008D.quest_subtitle: "A small, slow current"
	quest.660000000000008D.quest_desc: [
		"The decay generator remains, and it makes power from radioactive decay."
		"The voltaic pile is removed."
	]
	quest.660000000000008E.title: "Fission Casing"
	quest.660000000000008E.quest_subtitle: "The reactor's wall"
	quest.660000000000008E.quest_desc: [
		"Fission casing is the wall of the solid-fuel fission reactor."
		"That reactor is the power capstone, gated on light engineering."
	]
	quest.660000000000008F.title: "Solid Fuel Fission Reactor"
	quest.660000000000008F.quest_subtitle: "The reactor"
	quest.660000000000008F.quest_desc: [
		"The solid-fuel fission controller is the brain of the fission reactor."
		"It is the power capstone, gated on light engineering."
	]
	quest.6600000000000090.title: "Turbine"
	quest.6600000000000090.quest_subtitle: "The reactor's dynamo"
	quest.6600000000000090.quest_desc: [
		"The turbine controller turns the fission reactor's heat into power."
		"It is part of the same power capstone, gated on light engineering."
	]
	quest.6600000000000091.title: "Seared Heater"
	quest.6600000000000091.quest_subtitle: "Heat under the tank"
	quest.6600000000000091.quest_desc: [
		"The seared heater is the heat source of the small smeltery."
	]
	quest.6600000000000092.title: "Seared Melter"
	quest.6600000000000092.quest_subtitle: "The first melt"
	quest.6600000000000092.quest_desc: [
		"The seared melter is the melting tank of the small smeltery."
	]
	quest.6600000000000093.title: "Smeltery Controller"
	quest.6600000000000093.quest_subtitle: "The multiblock's face"
	quest.6600000000000093.quest_desc: [
		"The smeltery controller is the multiblock brain of the smeltery."
	]
	quest.6600000000000094.title: "Foundry Controller"
	quest.6600000000000094.quest_subtitle: "The last foundry block"
	quest.6600000000000094.quest_desc: [
		"The foundry controller is the multiblock brain of the foundry."
	]
	quest.6600000000000095.title: "Magebloom"
	quest.6600000000000095.quest_subtitle: "The source crop"
	quest.6600000000000095.quest_desc: [
		"Magebloom is the crop."
		"It is grown for the later source crafts."
	]
	quest.6600000000000096.title: "Source Jar"
	quest.6600000000000096.quest_subtitle: "Hold the source"
	quest.6600000000000096.quest_desc: [
		"A source jar stores source."
		"The imbuement chamber and later machines draw on the source kept in jars."
	]
	quest.6600000000000097.title: "Source Relay"
	quest.6600000000000097.quest_subtitle: "Move source along"
	quest.6600000000000097.quest_desc: [
		"A relay moves source."
		"It carries source between jars and the machines that spend it."
	]
	quest.6600000000000098.title: "Enchanting Apparatus"
	quest.6600000000000098.quest_subtitle: "The ritual table"
	quest.6600000000000098.quest_desc: [
		"The enchanting apparatus is the multiblock that enchants gear."
		"Source enchantments are applied there."
	]
	quest.6600000000000099.title: "Mob Jar"
	quest.6600000000000099.quest_subtitle: "A creature, contained"
	quest.6600000000000099.quest_desc: [
		"A mob jar captures a mob."
		"It holds that mob for the machines and spells that need the creature on hand."
	]
	quest.660000000000009A.title: "Spell Turret"
	quest.660000000000009A.quest_subtitle: "The last spell machine"
	quest.660000000000009A.quest_desc: [
		"A spell turret casts a spell on its own."
		"It is the last machine of this line."
	]
	quest.660000000000009B.title: "Mithril Ore"
	quest.660000000000009B.quest_subtitle: "The metal under the spells"
	quest.660000000000009B.quest_desc: [
		"Mithril ore is the late metal."
		"It is mined for the metal used in the stronger gear."
	]
	quest.660000000000009C.title: "Pedestal"
	quest.660000000000009C.quest_subtitle: "A place to set a book"
	quest.660000000000009C.quest_desc: [
		"A pedestal holds items for rituals."
		"It is the stand a ritual takes items from."
	]
	quest.660000000000009D.title: "Scroll Forge"
	quest.660000000000009D.quest_subtitle: "Inks and paper"
	quest.660000000000009D.quest_desc: [
		"The scroll forge makes scrolls."
		"A scroll carries one spell you can cast without opening the book."
	]
	quest.660000000000009E.title: "Arcane Anvil"
	quest.660000000000009E.quest_subtitle: "The last smithing"
	quest.660000000000009E.quest_desc: [
		"The arcane anvil upgrades gear."
		"It is the last station of this line."
	]
	quest.660000000000009F.title: "Digestion Vat"
	quest.660000000000009F.quest_subtitle: "The next vessel"
	quest.660000000000009F.quest_desc: [
		"The digestion vat is the vessel after the distiller."
		"It digests the reagents into the next stage of the work."
	]
	quest.66000000000000A0.title: "Fermentation Vat"
	quest.66000000000000A0.quest_subtitle: "The slow vessel"
	quest.66000000000000A0.quest_desc: [
		"The fermentation vat is the slow vessel after digestion."
		"It ferments what the digestion vat has prepared."
	]
	quest.66000000000000A1.title: "Liquefaction Cauldron"
	quest.66000000000000A1.quest_subtitle: "Melt the work"
	quest.66000000000000A1.quest_desc: [
		"The liquefaction cauldron is the melt after the vats."
		"It turns the fermented work into liquid."
	]
	quest.66000000000000A2.title: "Reformation Pedestal"
	quest.66000000000000A2.quest_subtitle: "The three pedestals"
	quest.66000000000000A2.quest_desc: [
		"The reformation pedestal is a late machine."
		"It holds the target of a reformation."
	]
	quest.66000000000000A3.title: "Incubator"
	quest.66000000000000A3.quest_subtitle: "The last vessel"
	quest.66000000000000A3.quest_desc: [
		"The incubator is the last machine of this line."
		"It finishes the alchemy the earlier vessels prepared."
	]
	quest.66000000000000A4.title: "Cave Illuminator"
	quest.66000000000000A4.quest_subtitle: "A light that follows you"
	quest.66000000000000A4.quest_desc: [
		"The cave illuminator is a light powered by starlight."
		"It is used to light caves."
	]
	quest.66000000000000A5.title: "Starlight Infuser"
	quest.66000000000000A5.quest_subtitle: "Soak an item in the night"
	quest.66000000000000A5.quest_desc: [
		"The starlight infuser is the starlight crafting block."
		"Items set on it are infused under the night sky."
	]
	quest.66000000000000A6.title: "Attunement Altar"
	quest.66000000000000A6.quest_subtitle: "The constellation table"
	quest.66000000000000A6.quest_desc: [
		"The attunement altar is the attunement multiblock."
		"It is used to attune yourself to a constellation."
	]
	quest.66000000000000A7.title: "Celestial Gateway"
	quest.66000000000000A7.quest_subtitle: "The last altar"
	quest.66000000000000A7.quest_desc: [
		"The celestial gateway is the teleport capstone."
		"Linked gateways move you between two places."
	]
	quest.66000000000000A8.title: "Capsid"
	quest.66000000000000A8.quest_subtitle: "A shell from the end"
	quest.66000000000000A8.quest_desc: [
		"A capsid is the end-game biological part."
		"It is used in the last creature crafts."
	]
	quest.66000000000000A9.title: "Gustmaker"
	quest.66000000000000A9.quest_subtitle: "Wind in a block"
	quest.66000000000000A9.quest_desc: [
		"The gustmaker is the air machine."
		"It makes a gust of wind."
	]
	quest.66000000000000AA.title: "Void Worm Effigy"
	quest.66000000000000AA.quest_subtitle: "The worm, remembered"
	quest.66000000000000AA.quest_desc: [
		"The void worm effigy is the piece tied to the void worm."
		"It is used to summon that worm."
	]
	quest.66000000000000AB.title: "Transmutation Table"
	quest.66000000000000AB.quest_subtitle: "The last altar"
	quest.66000000000000AB.quest_desc: [
		"The transmutation table is the last station of this line."
		"It transmutes creature materials."
	]
	quest.66000000000000AC.title: "Amber Monolith"
	quest.66000000000000AC.quest_subtitle: "The primordial cave"
	quest.66000000000000AC.quest_desc: [
		"The amber monolith is the magnetic structure."
		"It is the large magnetic block used in the crafts of the magnetic caves."
	]
	quest.66000000000000AD.title: "Azure Neodymium"
	quest.66000000000000AD.quest_subtitle: "The magnetic cave"
	quest.66000000000000AD.quest_desc: [
		"An azure neodymium node is the magnetite."
		"It is the blue magnetic ore."
	]
	quest.66000000000000AE.title: "Abyssal Altar"
	quest.66000000000000AE.quest_subtitle: "The ocean cave"
	quest.66000000000000AE.quest_desc: [
		"The abyssal altar is the deep-sea crafting station."
		"It is used for the crafts of the abyss."
	]
	quest.66000000000000AF.title: "Nuclear Furnace"
	quest.66000000000000AF.quest_subtitle: "The last cave machine"
	quest.66000000000000AF.quest_desc: [
		"The nuclear furnace is the last machine of the toxic caves."
		"It processes the radioactive material of those caves."
	]
	quest.66000000000000B0.title: "Campfire Pot"
	quest.66000000000000B0.quest_subtitle: "Cook at the camp"
	quest.66000000000000B0.quest_desc: [
		"The campfire pot cooks."
		"It is the pot used for camp meals."
	]
	quest.66000000000000B1.title: "Pasture"
	quest.66000000000000B1.quest_subtitle: "A field for the team"
	quest.66000000000000B1.quest_desc: [
		"A pasture holds Pokemon outside."
		"It is a field for them when they are not in the PC."
	]
	quest.66000000000000B2.title: "Healing Machine"
	quest.66000000000000B2.quest_subtitle: "The last station"
	quest.66000000000000B2.quest_desc: [
		"The healing machine heals Pokemon."
		"It restores the party."
	]
	quest.66000000000000B3.title: "Utherium Block"
	quest.66000000000000B3.quest_subtitle: "The first deep metal"
	quest.66000000000000B3.quest_desc: [
		"An utherium block stores utherium, one of the three late metals."
		"It is the metal after cloggrum."
	]
	quest.66000000000000B4.title: "Froststeel Block"
	quest.66000000000000B4.quest_subtitle: "The cold metal"
	quest.66000000000000B4.quest_desc: [
		"A froststeel block stores froststeel, one of the three late metals."
		"It is the cold metal between utherium and forgotten metal."
	]
	quest.66000000000000B5.title: "Forgotten Block"
	quest.66000000000000B5.quest_subtitle: "The last metal"
	quest.66000000000000B5.quest_desc: [
		"A forgotten block stores forgotten metal, the last of the three late metals."
		"It is the capstone metal of the Undergarden."
	]
	quest.66000000000000B6.title: "Starter Stack Upgrade"
	quest.66000000000000B6.quest_subtitle: "More room in the same pack"
	quest.66000000000000B6.quest_desc: [
		"The starter stack upgrade is the first stack upgrade, and it lets each backpack slot hold more."
		"The visible stack ladder continues from tier 1 through tier 4."
	]
	quest.66000000000000B7.title: "Stack Upgrade I"
	quest.66000000000000B7.quest_subtitle: "The first numbered tier"
	quest.66000000000000B7.quest_desc: [
		"Stack upgrade tier 1 is the first numbered stack upgrade, and it raises how much each backpack slot holds."
	]
	quest.66000000000000B8.title: "Stack Upgrade IV"
	quest.66000000000000B8.quest_subtitle: "The last visible stack upgrade"
	quest.66000000000000B8.quest_desc: [
		"Stack upgrade tier 4 is the top visible backpack stack upgrade."
	]
	quest.66000000000000B9.title: "Feeding Upgrade"
	quest.66000000000000B9.quest_subtitle: "The pack eats for you"
	quest.66000000000000B9.quest_desc: [
		"The feeding upgrade eats food from the backpack for you."
	]
	quest.66000000000000BA.title: "Advanced Feeding"
	quest.66000000000000BA.quest_subtitle: "The last feeding upgrade"
	quest.66000000000000BA.quest_desc: [
		"Advanced feeding is the stronger feeding upgrade."
	]
	quest.66000000000000BB.title: "Magnet Upgrade"
	quest.66000000000000BB.quest_subtitle: "Pull items in"
	quest.66000000000000BB.quest_desc: [
		"The magnet upgrade pulls nearby items into the backpack."
	]
	quest.66000000000000BC.title: "Void Upgrade"
	quest.66000000000000BC.quest_subtitle: "Throw away the rest"
	quest.66000000000000BC.quest_desc: [
		"The void upgrade deletes items the backpack should not keep."
	]
	quest.66000000000000BD.title: "Tank Upgrade"
	quest.66000000000000BD.quest_subtitle: "A fluid pocket"
	quest.66000000000000BD.quest_desc: [
		"The tank upgrade stores a fluid in the backpack."
	]
	quest.66000000000000BE.title: "Storage Stack Upgrade I"
	quest.66000000000000BE.quest_subtitle: "The chest holds more"
	quest.66000000000000BE.quest_desc: [
		"Storage stack upgrade tier 1 lets a chest hold more in each slot."
		"The visible ladder runs from tier 1 through tier 5, and the plus tier is hidden."
	]
	quest.66000000000000BF.title: "Storage Stack Upgrade V"
	quest.66000000000000BF.quest_subtitle: "The last stack upgrade"
	quest.66000000000000BF.quest_desc: [
		"Storage stack upgrade tier 5 is the top stack upgrade."
	]
	quest.66000000000000C0.title: "Storage Feeding"
	quest.66000000000000C0.quest_subtitle: "The chest feeds you"
	quest.66000000000000C0.quest_desc: [
		"The feeding upgrade lets the storage block feed you."
	]
	quest.66000000000000C1.title: "Compacting Upgrade"
	quest.66000000000000C1.quest_subtitle: "Nuggets become blocks"
	quest.66000000000000C1.quest_desc: [
		"The compacting upgrade compacts and unpacks items inside the storage block."
	]
	quest.66000000000000C2.title: "Storage Void Upgrade"
	quest.66000000000000C2.quest_subtitle: "Delete the overflow"
	quest.66000000000000C2.quest_desc: [
		"The void upgrade deletes overflow the storage block should not keep."
	]
	quest.66000000000000C3.title: "Iron Fishing Rod"
	quest.66000000000000C3.quest_subtitle: "String is the smithing template"
	quest.66000000000000C3.quest_desc: [
		"The iron fishing rod is smithing: a string template, iron, and a stone rod."
		"It is the first metal rod."
	]
	quest.66000000000000C4.title: "Golden Fishing Rod"
	quest.66000000000000C4.quest_subtitle: "Same smithing, gold ingot"
	quest.66000000000000C4.quest_desc: [
		"The golden fishing rod is smithing, like the iron rod, with gold in place of iron."
		"It is the rod the Midas rod is built on."
	]
	quest.66000000000000C5.title: "Diamond Fishing Rod"
	quest.66000000000000C5.quest_subtitle: "String, a diamond, a rod"
	quest.66000000000000C5.quest_desc: [
		"The diamond fishing rod is smithing from string, a diamond, and a lower rod."
		"It is the rod the netherite rod is built on."
	]
	quest.66000000000000C6.title: "Crystal Fishing Rod"
	quest.66000000000000C6.quest_subtitle: "An amethyst on the rod"
	quest.66000000000000C6.quest_desc: [
		"The crystal fishing rod is smithing from string, an amethyst shard, and a lower rod."
		"It is a crystal upgrade of a lower rod."
	]
	quest.66000000000000C7.title: "Diamond Line"
	quest.66000000000000C7.quest_subtitle: "The deep line"
	quest.66000000000000C7.quest_desc: [
		"Diamond line is tackle, a stronger line than iron line."
		"It is a line, not a rod."
	]
	quest.66000000000000C8.title: "Netherite Fishing Rod"
	quest.66000000000000C8.quest_subtitle: "The metal top"
	quest.66000000000000C8.quest_desc: [
		"The netherite fishing rod is smithing from a netherite template, a netherite ingot, and a diamond rod."
		"It is the top metal rod."
	]
	quest.66000000000000C9.title: "Midas Rod"
	quest.66000000000000C9.quest_subtitle: "A fish, not an ingot"
	quest.66000000000000C9.quest_desc: [
		"The Midas rod is the last rod of this line."
		"It is smithing from string, a Midas fish, and a golden rod."
	]
	quest.66000000000000CA.title: "Psimetal"
	quest.66000000000000CA.quest_subtitle: "A spell, not a furnace"
	quest.66000000000000CA.quest_desc: [
		"Psimetal is trick-crafted from gold, not smelted."
		"The ingot is the metal for the top CAD parts and the exosuit."
	]
	quest.66000000000000CB.title: "Spell Drive"
	quest.66000000000000CB.quest_subtitle: "Psimetal and redstone"
	quest.66000000000000CB.quest_desc: [
		"The spell drive is a top CAD part."
		"It stores a spell in the gun."
	]
	quest.66000000000000CC.title: "Psimetal Assembly"
	quest.66000000000000CC.quest_subtitle: "The top assembly"
	quest.66000000000000CC.quest_desc: [
		"The psimetal assembly is the top CAD shell."
		"It replaces the iron assembly on a finished gun."
	]
	quest.66000000000000CD.title: "Hyperclocked Core"
	quest.66000000000000CD.quest_subtitle: "The top core"
	quest.66000000000000CD.quest_desc: [
		"The hyperclocked core is the top CAD core."
		"It is the processor for a finished gun."
	]
	quest.66000000000000CE.title: "Ultradense Battery"
	quest.66000000000000CE.quest_subtitle: "The top battery"
	quest.66000000000000CE.quest_desc: [
		"The ultradense battery is the top CAD battery."
		"It holds the psi a finished gun spends."
	]
	quest.66000000000000CF.title: "Transmissive Socket"
	quest.66000000000000CF.quest_subtitle: "A top socket"
	quest.66000000000000CF.quest_desc: [
		"The transmissive socket is the top CAD socket."
		"It holds the spell bullet in a finished gun."
	]
	quest.66000000000000D0.title: "Exosuit Chestplate"
	quest.66000000000000D0.quest_subtitle: "Psimetal and psigem"
	quest.66000000000000D0.quest_desc: [
		"The exosuit chestplate is psi armor."
		"With the controller, it is the armor at the end of this line."
	]
	quest.66000000000000D1.title: "Exosuit Controller"
	quest.66000000000000D1.quest_subtitle: "The last psi part"
	quest.66000000000000D1.quest_desc: [
		"The exosuit controller runs the exosuit."
		"With the chestplate, it is the armor at the end of this line."
	]
	quest.66000000000000D2.title: "Train Track"
	quest.66000000000000D2.quest_subtitle: "Sleeper, nuggets, press"
	quest.66000000000000D2.quest_desc: [
		"Train track is a sequenced assembly on a sleeper: deploy iron or zinc nuggets, then press, so you need a deployer and a press."
		"Stations, signals, and schedules sit on the line it makes."
	]
	quest.66000000000000D3.title: "Chain Conveyor"
	quest.66000000000000D3.quest_subtitle: "Andesite casing and a large cog"
	quest.66000000000000D3.quest_desc: [
		"A chain conveyor carries items, and a rider, along a hanging chain."
		"Package frogports send their packages along these chains."
	]
	quest.66000000000000D4.title: "Schematicannon"
	quest.66000000000000D4.quest_subtitle: "Print a saved building"
	quest.66000000000000D4.quest_desc: [
		"The schematicannon prints a saved schematic into the world, and the craft is still iron blocks, logs, and a dispenser."
		"It is a cannon that learned architecture."
	]
	quest.66000000000000D5.title: "Stock Link"
	quest.66000000000000D5.quest_subtitle: "Lightning rod on a lead casing"
	quest.66000000000000D5.quest_desc: [
		"A stock link reports an inventory to the factory network, and this pack builds it as a lightning rod on a lead casing."
		"The stock ticker and the factory gauge read these links."
	]
	quest.66000000000000D6.title: "Stock Ticker"
	quest.66000000000000D6.quest_subtitle: "Glass, the link, gold"
	quest.66000000000000D6.quest_desc: [
		"A stock ticker is the screen for the stock network."
		"It lists what the links can see and sends out the packages you request."
	]
	quest.66000000000000D7.title: "Factory Gauge"
	quest.66000000000000D7.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.66000000000000D7.quest_desc: [
		"A factory gauge uses its standard mod crafting recipe (check EMI)."
		"Set on an inventory, it tells the stock network how much to keep and when to restock."
	]
	quest.66000000000000D8.title: "Packager"
	quest.66000000000000D8.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.66000000000000D8.quest_desc: [
		"A packager uses its standard mod crafting recipe (check EMI)."
		"It boxes items into addressed packages for the frogports."
	]
	quest.66000000000000D9.title: "Repackager"
	quest.66000000000000D9.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.66000000000000D9.quest_desc: [
		"A repackager uses its standard mod crafting recipe (check EMI)."
		"It unpacks a package back into items."
	]
	quest.66000000000000DA.title: "Package Frogport"
	quest.66000000000000DA.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.66000000000000DA.quest_desc: [
		"A package frogport uses its standard mod crafting recipe (check EMI)."
		"It is the address packages travel to along a chain conveyor."
	]
	quest.66000000000000DB.title: "Redstone Requester"
	quest.66000000000000DB.quest_subtitle: "The logistics capstone"
	quest.66000000000000DB.quest_desc: [
		"A redstone requester uses its standard mod crafting recipe (check EMI)."
		"Give it redstone and the network sends the items that link is keeping."
	]
	quest.66000000000000DC.title: "Steel Component"
	quest.66000000000000DC.quest_subtitle: "A components blueprint"
	quest.66000000000000DC.quest_desc: [
		"The steel component is an Engineer's Blueprint part: two steel plates and a copper ingot."
		"It is the mechanical part for the heavier machines."
	]
	quest.66000000000000DD.title: "Graphite Electrode"
	quest.66000000000000DD.quest_subtitle: "The arc furnace's rod"
	quest.66000000000000DD.quest_desc: [
		"The graphite electrode is the bottling machine's output, and the arc furnace consumes it."
	]
	quest.66000000000000DE.title: "Electronic Component"
	quest.66000000000000DE.quest_subtitle: "The first circuit"
	quest.66000000000000DE.quest_desc: [
		"The basic electronic component is an Engineer's Blueprint part made from a treated wood slab, quartz, redstone dust, and electrum wire."
		"It is the early circuit, and it is not a vacuum tube."
	]
	quest.66000000000000DF.title: "Advanced Electronic Component"
	quest.66000000000000DF.quest_subtitle: "Plastic, tubes, aluminum wire"
	quest.66000000000000DF.quest_desc: [
		"The advanced electronic component is an Engineer's Blueprint part made from a plastic plate, two electron tubes, and aluminum wire."
		"It is the later circuit."
	]
	quest.66000000000000E0.title: "1k Storage Part"
	quest.66000000000000E0.quest_subtitle: "A calculation mechanism, not redstone dust"
	quest.66000000000000E0.quest_desc: [
		"The 1k storage part uses a calculation mechanism instead of redstone."
		"It is the smallest disk part."
	]
	quest.66000000000000E1.title: "1k Storage Disk"
	quest.66000000000000E1.quest_subtitle: "Part, glass, enriched iron"
	quest.66000000000000E1.quest_desc: [
		"The 1k storage disk is glass, redstone, a 1k part, and quartz enriched iron."
		"The disk drive mounts it."
	]
	quest.66000000000000E2.title: "4k Storage Part"
	quest.66000000000000E2.quest_subtitle: "Basic processors around a 1k part"
	quest.66000000000000E2.quest_desc: [
		"The 4k storage part is made from basic processors and a 1k part."
		"Silicon comes from heated silicon compound, and the silicon craft is removed."
	]
	quest.66000000000000E3.title: "16k Storage Part"
	quest.66000000000000E3.quest_subtitle: "Improved processors around a 4k"
	quest.66000000000000E3.quest_desc: [
		"The 16k storage part is made from improved processors and a 4k part."
	]
	quest.66000000000000E4.title: "64k Storage Part"
	quest.66000000000000E4.quest_subtitle: "Advanced processors around a 16k"
	quest.66000000000000E4.quest_desc: [
		"The 64k storage part is made from advanced processors and a 16k part."
		"It is the largest storage part."
	]
	quest.66000000000000E5.title: "64k Storage Disk"
	quest.66000000000000E5.quest_subtitle: "The last disk"
	quest.66000000000000E5.quest_desc: [
		"The 64k storage disk is glass, redstone, a 64k part, and quartz enriched iron."
		"It is the largest disk, and the disk drive mounts it."
	]
	quest.66000000000000E6.title: "Importer"
	quest.66000000000000E6.quest_subtitle: "Cable, destruction core, improved processor"
	quest.66000000000000E6.quest_desc: [
		"The importer is cable, a destruction core, and an improved processor."
		"It pulls items from an inventory into the network."
	]
	quest.66000000000000E7.title: "Exporter"
	quest.66000000000000E7.quest_subtitle: "Cable, construction core, improved processor"
	quest.66000000000000E7.quest_desc: [
		"The exporter is cable, a construction core, and an improved processor."
		"It pushes items from the network into an inventory."
	]
	quest.66000000000000E8.title: "External Storage"
	quest.66000000000000E8.quest_subtitle: "A chest on the network"
	quest.66000000000000E8.quest_desc: [
		"External storage is both cores, quartz enriched iron, a chest, cable, and an improved processor."
		"It puts a chest on the network without moving the items onto a disk."
	]
	quest.66000000000000E9.title: "Pattern Grid"
	quest.66000000000000E9.quest_subtitle: "Grid, advanced processor, pattern"
	quest.66000000000000E9.quest_desc: [
		"The pattern grid is a grid, an advanced processor, and a pattern."
		"It writes the patterns the autocrafter runs."
	]
	quest.66000000000000EA.title: "Crafting Grid"
	quest.66000000000000EA.quest_subtitle: "A grid that crafts"
	quest.66000000000000EA.quest_desc: [
		"The crafting grid is a grid, an advanced processor, and a crafting table."
		"It lets you craft by hand from the network."
	]
	quest.66000000000000EB.title: "Autocrafting Monitor"
	quest.66000000000000EB.quest_subtitle: "Watch the pattern run"
	quest.66000000000000EB.quest_desc: [
		"The autocrafting monitor shows autocrafting jobs while they run."
	]
	quest.66000000000000EC.title: "Autocrafter Manager"
	quest.66000000000000EC.quest_subtitle: "Several crafters, one face"
	quest.66000000000000EC.quest_desc: [
		"The autocrafter manager groups several autocrafters on one screen."
	]
	quest.66000000000000ED.title: "Disk Interface"
	quest.66000000000000ED.quest_subtitle: "Move disks without the drive"
	quest.66000000000000ED.quest_desc: [
		"The disk interface lets another inventory insert and remove disks."
	]
	quest.66000000000000EE.title: "Detector"
	quest.66000000000000EE.quest_subtitle: "A redstone face"
	quest.66000000000000EE.quest_desc: [
		"The detector emits redstone when the network holds the items it is set to watch."
	]
	quest.66000000000000EF.title: "Wireless Grid"
	quest.66000000000000EF.quest_subtitle: "The last wireless piece"
	quest.66000000000000EF.quest_desc: [
		"The wireless grid is quartz enriched iron, an ender pearl, a grid, and an advanced processor."
		"It is the handheld screen for the network."
	]
	quest.66000000000000F0.title: "Crafting Station"
	quest.66000000000000F0.quest_subtitle: "A pattern on a workbench"
	quest.66000000000000F0.quest_desc: [
		"The crafting station is a pattern on a workbench, and it is the mod's crafting table."
	]
	quest.66000000000000F1.title: "Modifier Worktable"
	quest.66000000000000F1.quest_subtitle: "Where tools take modifiers"
	quest.66000000000000F1.quest_desc: [
		"The modifier worktable is seared blocks and workstation rock."
		"Finished tools take modifiers here."
	]
	quest.66000000000000F2.title: "Tinker's Anvil"
	quest.66000000000000F2.quest_subtitle: "The tool forge"
	quest.66000000000000F2.quest_desc: [
		"There is no item named tool forge."
		"The tinkers anvil is that tool station: anvil metal over seared blocks."
	]
	quest.66000000000000F3.title: "Scorched Anvil"
	quest.66000000000000F3.quest_subtitle: "The nether forge"
	quest.66000000000000F3.quest_desc: [
		"The scorched anvil is the nether-tier anvil and the tool capstone."
	]
	quest.66000000000000F4.title: "Great Ball"
	quest.66000000000000F4.quest_subtitle: "Blue and red apricorns"
	quest.66000000000000F4.quest_desc: [
		"A Great Ball is made from blue and red apricorns and a tier-2 material."
		"It is a stronger catch than a Poke Ball."
	]
	quest.66000000000000F5.title: "Ultra Ball"
	quest.66000000000000F5.quest_subtitle: "Black and yellow apricorns"
	quest.66000000000000F5.quest_desc: [
		"An Ultra Ball is made from black and yellow apricorns and a tier-3 material."
		"It is the ball above the Great Ball."
	]
	quest.66000000000000F6.title: "Master Ball"
	quest.66000000000000F6.quest_subtitle: "Netherite, a shell, a star"
	quest.66000000000000F6.quest_desc: [
		"The Master Ball is the last ball of this line."
		"It is crafted from two shulker shells, two netherite ingots, and one nether star."
	]
	quest.6600000000000100.title: "Iron Sheet"
	quest.6600000000000100.quest_subtitle: "Press an ingot"
	quest.6600000000000100.quest_desc: [
		"An iron sheet is an iron ingot under the press."
		"Whisks, propellers, drill heads, and saw blades are built from it."
	]
	quest.6600000000000101.title: "Golden Sheet"
	quest.6600000000000101.quest_subtitle: "Press a gold ingot"
	quest.6600000000000101.quest_desc: [
		"A golden sheet is a gold ingot under the press."
		"Goggles and the deepslate railway casing ask for this plate. The brass hand uses brass plates, not gold."
	]
	quest.6600000000000102.title: "Copper Sheet"
	quest.6600000000000102.quest_subtitle: "Press a copper ingot"
	quest.6600000000000102.quest_desc: [
		"A copper sheet is a copper ingot under the press."
		"One copper sheet and any stripped log make Copper Casings for fluid handling."
	]
	quest.6600000000000103.title: "Brass Sheet"
	quest.6600000000000103.quest_subtitle: "Press a brass ingot"
	quest.6600000000000103.quest_desc: [
		"A brass sheet is a brass ingot under the press, and the ingot is heated copper and zinc from the mixer."
		"One sheet and any log make two brass casings."
	]
	quest.6600000000000108.title: "Whisk"
	quest.6600000000000108.quest_subtitle: "Iron sheets on an alloy core"
	quest.6600000000000108.quest_desc: [
		"A whisk is the mixing head."
		"Used to craft the mechanical mixer (check EMI)."
	]
	quest.6600000000000109.title: "Propeller"
	quest.6600000000000109.quest_subtitle: "Iron sheets around alloy"
	quest.6600000000000109.quest_desc: [
		"A propeller is the blade of a fan."
		"Used to craft the encased fan (check EMI)."
	]
	quest.660000000000010A.title: "Drill Head"
	quest.660000000000010A.quest_subtitle: "Sheets, nuggets, lead"
	quest.660000000000010A.quest_desc: [
		"A drill head is iron nuggets, iron sheets, and lead."
		"Used to craft the mechanical drill (check EMI)."
	]
	quest.660000000000010B.title: "Saw Blade"
	quest.660000000000010B.quest_subtitle: "Sheets around a lead ingot"
	quest.660000000000010B.quest_desc: [
		"A saw blade is iron nuggets, iron sheets, and lead."
		"Used to craft the mechanical saw (check EMI)."
	]
	quest.6600000000000106.title: "Railway Casing"
	quest.6600000000000106.quest_subtitle: "Golden sheet and deepslate"
	quest.6600000000000106.quest_desc: [
		"Railway casing is a golden sheet and deepslate, and the craft makes two."
		"Used for Create trains, stations, and railway logistics."
	]
	quest.6600000000000107.title: "Brass Casing"
	quest.6600000000000107.quest_subtitle: "Brass sheet and a log"
	quest.6600000000000107.quest_desc: [
		"Brass casing is a brass sheet and any log, and the craft makes two."
		"Used for smart Brass-tier logistics, funnels, and mechanical arms."
	]
	quest.6600000000000104.title: "Electron Tube"
	quest.6600000000000104.quest_subtitle: "Spout molten iron on rose quartz"
	quest.6600000000000104.quest_desc: [
		"An electron tube is 10 mB of molten iron spouted onto polished rose quartz."
		"The crafting-table tube is removed, and precision mechanisms consume these tubes."
	]
	quest.6600000000000105.title: "Precision Mechanism"
	quest.6600000000000105.quest_subtitle: "Two tubes and the cutters"
	quest.6600000000000105.quest_desc: [
		"A precision mechanism is a sequenced assembly on a kinetic mechanism: deploy an electron tube twice, then the wire cutters."
		"It is the heart of Brass-tier automation—crafted via sequenced assembly on a Kinetic Mechanism or Gold Sheet."
	]
	quest.660000000000010C.title: "Railway Casing"
	quest.660000000000010C.quest_subtitle: "Obsidian on a kinetic mechanism"
	quest.660000000000010C.quest_desc: [
		"The hand craft is a kinetic mechanism between two obsidian, and it does not need a deployer."
		"Crafted by deploying sturdy sheets onto brass casings; used for train tracks, bogeys, and heavy railway machinery."
	]
	chapter.6519000000000000.title: "Let it Walk"
	chapter.6519000000000000.chapter_subtitle: [
		"Machines that walk"
	]
	quest.6419000000000000.title: "Let it Walk"
	quest.6419000000000000.quest_subtitle: "A machine that walks"
	quest.6419000000000000.quest_desc: [
		"A walker is a hull of any blocks on legs, and the Walker Core is the heart that makes those legs step."
		"Every part is klaxium, mixed cold, so the line starts once the mixer turns."
	]
	quest.6419000000000001.title: "Klaxium Alloy"
	quest.6419000000000001.quest_subtitle: "Iron, copper, soul sand, lava"
	quest.6419000000000001.quest_desc: [
		"Klaxium is an unheated mix of one iron, two copper, two soul sand, and 100 mB of lava."
		"Sheets, joints, jets, and the core are all cut from this ingot."
	]
	quest.6419000000000002.title: "Klaxium Nugget"
	quest.6419000000000002.quest_subtitle: "Nine from an ingot"
	quest.6419000000000002.quest_desc: [
		"A klaxium nugget is one ingot split into nine, and nine nuggets make the ingot again."
		"Mounts, the stabilization module, and the positioner all take nuggets."
	]
	quest.6419000000000003.title: "Klaxium Sheet"
	quest.6419000000000003.quest_subtitle: "Press the ingot"
	quest.6419000000000003.quest_desc: [
		"A klaxium sheet is a klaxium ingot under the press."
		"Casings, hinges, nozzles, and mounts are all this plate."
	]
	quest.6419000000000004.title: "Klaxium Casing"
	quest.6419000000000004.quest_subtitle: "A sheet on stripped wood"
	quest.6419000000000004.quest_desc: [
		"A klaxium casing is a klaxium sheet applied to stripped wood."
		"The Walker Core and the pilot controls both sit on this casing."
	]
	quest.6419000000000005.title: "Articulation Unit"
	quest.6419000000000005.quest_subtitle: "Cog, alloy, then the press"
	quest.6419000000000005.quest_desc: [
		"An articulation unit is a sequenced assembly on a klaxium sheet: deploy a cog, deploy andesite alloy, then press."
		"Hinges and swivels are this unit between plates."
	]
	quest.6419000000000006.title: "Leg Hinge"
	quest.6419000000000006.quest_subtitle: "Bends in one plane"
	quest.6419000000000006.quest_desc: [
		"A leg hinge is a sheet, an articulation unit, and another sheet, and the craft makes two."
		"It bends the next segment in one plane, like a hip or a knee, and the side panel can mark that chain as an arm."
	]
	quest.6419000000000007.title: "Leg Swivel"
	quest.6419000000000007.quest_subtitle: "Turns about its facing"
	quest.6419000000000007.quest_desc: [
		"A leg swivel is a sheet, an articulation unit, and a shaft, and the craft makes two."
		"It turns everything beyond it, and under the hull that swing steps the leg sideways."
	]
	quest.6419000000000008.title: "Leg Foot"
	quest.6419000000000008.quest_subtitle: "Where the leg ends"
	quest.6419000000000008.quest_desc: [
		"A leg foot is one klaxium ingot over three sheets."
		"Every walking leg ends in a foot, and a chain of joints with no foot is an arm."
	]
	quest.6419000000000009.title: "Klaxium Spike"
	quest.6419000000000009.quest_subtitle: "Saw an ingot into four"
	quest.6419000000000009.quest_desc: [
		"A klaxium spike is a saw cut, one ingot into four spikes."
		"Four of them around a foot make the climbing foot."
	]
	quest.641900000000000A.title: "Spiked Foot"
	quest.641900000000000A.quest_subtitle: "Four spikes on a foot"
	quest.641900000000000A.quest_desc: [
		"A spiked foot is a leg foot with a spike in each corner."
		"With spiked feet on at least half the legs, the walker climbs walls and ceilings."
	]
	quest.641900000000000B.title: "Jet Nozzle"
	quest.641900000000000B.quest_subtitle: "Sheet, pipe, lava, then the press"
	quest.641900000000000B.quest_desc: [
		"A jet nozzle is a sequenced assembly on a klaxium sheet: deploy an iron sheet, deploy a fluid pipe, fill 250 mB of lava, then press."
		"A jet foot is a leg foot set on this nozzle."
	]
	quest.641900000000000C.title: "Jet Foot"
	quest.641900000000000C.quest_subtitle: "A nozzle under a foot"
	quest.641900000000000C.quest_desc: [
		"A jet foot is a leg foot on a jet nozzle."
		"With jet feet on at least half the legs the walker flies, and the jets burn lava pumped into the core."
	]
	quest.641900000000000D.title: "Jet Mount"
	quest.641900000000000D.quest_subtitle: "Nuggets and a sheet"
	quest.641900000000000D.quest_desc: [
		"A mount is two klaxium nuggets and a sheet, a plate you fix to the side of a block."
		"Seat a jet foot or a spiked foot on it so the jets can dash and the spikes can grab."
	]
	quest.641900000000000E.title: "Stabilization Module"
	quest.641900000000000E.quest_subtitle: "Precision, a tube, two nuggets"
	quest.641900000000000E.quest_desc: [
		"A stabilization module is a sequenced assembly on a precision mechanism: deploy an electron tube, deploy two klaxium nuggets, then press."
		"The Walker Core will not craft without this module."
	]
	quest.641900000000000F.title: "Walker Core"
	quest.641900000000000F.quest_subtitle: "The heart of the hull"
	quest.641900000000000F.quest_desc: [
		"The Walker Core is a shaft, four klaxium ingots, a stabilization module, and a klaxium casing."
		"Rotation on the front face makes the assembled walker step, and a faster shaft unlocks higher gears."
	]
	quest.6419000000000010.title: "Pilot Controls"
	quest.6419000000000010.quest_subtitle: "Levers, a tube, a casing"
	quest.6419000000000010.quest_desc: [
		"Pilot controls are two analog levers, an electron tube, and a klaxium casing."
		"An analog lever is a stick on an andesite casing, and these controls drive, turn, and fly the walker they are linked to."
	]
	quest.6419000000000011.title: "Remote Pilot Controller"
	quest.6419000000000011.quest_subtitle: "Levers, a transmitter, a sheet"
	quest.6419000000000011.quest_desc: [
		"The remote is two analog levers, a transmitter, and a klaxium sheet."
		"The transmitter is a lightning rod, copper sheets, and redstone, and the remote steers a linked walker from anywhere."
	]
	quest.6419000000000012.title: "Positioner"
	quest.6419000000000012.quest_subtitle: "Sheet, nugget, two shafts"
	quest.6419000000000012.quest_desc: [
		"A positioner is a klaxium sheet, a nugget, and two shafts."
		"Look at a hinge or a swivel and scroll to set the angle that leg stands and walks from."
	]

	quest.A11E000000000001.title: "Iron Nugget"
	quest.A11E000000000001.quest_subtitle: "Nine from an ingot"
	quest.A11E000000000001.quest_desc: [
		"An iron nugget is one ninth of an iron ingot."
		"Two nuggets and two andesite make one andesite alloy. Zinc nuggets work in place of the iron."
	]
	quest.A11E000000000002.title: "Cogwheel"
	quest.A11E000000000002.quest_subtitle: "A shaft and planks"
	quest.A11E000000000002.quest_desc: [
		"A cogwheel is a shaft and planks."
		"The hand-built kinetic mechanism takes one, with a hammer, andesite alloy, and a stripped log."
	]
	quest.A11E000000000003.title: "Cinder Flour"
	quest.A11E000000000003.quest_subtitle: "Mill netherrack"
	quest.A11E000000000003.quest_desc: [
		"A millstone mills netherrack into cinder flour. A crushing wheel is not required, and the wheel does not exist yet."
		"The flour is the dust in a blaze cake."
	]
	quest.A11E000000000004.title: "Blaze Cake Base"
	quest.A11E000000000004.quest_subtitle: "Press the flour"
	quest.A11E000000000004.quest_desc: [
		"A blaze cake base is an egg, sugar, and cinder flour, pressed together."
		"The mechanical press does it. A mixer does not."
	]
	quest.A11E000000000005.title: "Blaze Cake"
	quest.A11E000000000005.quest_subtitle: "A spout of lava"
	quest.A11E000000000005.quest_desc: [
		"A spout pours 250 mB of lava onto a blaze cake base, and the cake is what it becomes."
		"Feed the cake to a lit blaze burner and the mixer can superheat. That is the heat that melts an iron ingot."
	]

	quest.66A1000000000001.title: "Andesite Linkage"
	quest.66A1000000000001.quest_subtitle: "Transmission"
	quest.66A1000000000001.quest_desc: [
		"The andesite universal joint rod is two shafts, an andesite alloy, and a Simulated spring. The kinetic conversion bearing is a swivel bearing wrapped in copper sheets."
		"Both sit in the early kinetic tier and do not require brass."
	]
	quest.66A1000000000002.title: "Brass Linkage"
	quest.66A1000000000002.quest_subtitle: "Transmission"
	quest.66A1000000000002.quest_desc: [
		"With a brass casing, craft the pneumatic rod, the brass universal joint rod, and the andesite hydraulic hinge head. The rod and the joint rod take brass sheet. The hinge takes a brass casing."
		"They do not take an electron tube or a precision mechanism."
	]
	quest.66A1000000000003.title: "Precision Linkage"
	quest.66A1000000000003.quest_subtitle: "Transmission"
	quest.66A1000000000003.quest_desc: [
		"The brass hydraulic hinge head and the universal joint head each take a precision mechanism and a brass casing. The pneumatic regulator takes that mechanism plus two electron tubes."
		"The pneumatic connection head and the giant hydraulic rod are the same tier. The giant rod is a mechanical craft around one precision mechanism."
		"None of these crafts give a tube or a mechanism back."
	]

	chapter.6900000000000000.title: "Dimension Progression"
	quest.6900000000000001.title: "Layer 1: Overworld Skylands"
	quest.6900000000000001.quest_subtitle: "Starting Layer (Open Sky)"
	quest.6900000000000001.quest_desc: [
		"You begin high above on the Overworld Skylands. Descend into the world and pass through the dimensional barriers to reach ever lower depths, attaining the resources needed to eventually build a rocket and reach the stars."
	]
	quest.6900000000000002.title: "Create Kinetics & Metallurgy"
	quest.6900000000000002.quest_subtitle: "Overworld Tech Foundation"
	quest.6900000000000002.quest_desc: [
		"Build Create contraptions, Kinetic Mechanisms, and Brass alloys on the Overworld. These form the backbone of every deeper tech tier."
	]
	quest.6900000000000003.title: "Thaumaturge"
	quest.6900000000000003.quest_subtitle: "Ungated Overworld Magic"
	quest.6900000000000003.quest_desc: [
		"Thaumaturge is completely ungated and available from day one on the Overworld."
	]
	quest.6900000000000004.title: "Layer 2: The Deepsea"
	quest.6900000000000004.quest_subtitle: "Drop below the Skylands"
	quest.6900000000000004.quest_desc: [
		"Fall or dive beneath the Overworld islands into the Deepsea ocean."
		"All crude oil reservoirs (Immersive Petroleum & Create Diesel Generators) are gated to this layer."
	]
	quest.6900000000000005.title: "Offshore Oil Rigs"
	quest.6900000000000005.quest_subtitle: "Deepsea Crude Extraction"
	quest.6900000000000005.quest_desc: [
		"Craft Sealed Mechanisms with Rubber and Copper, then set up a Pumpjack in Deepsea oil chunks to extract Crude Oil."
	]
	quest.6900000000000006.title: "Diesel & Rocket Fuel Refining"
	quest.6900000000000006.quest_subtitle: "Power & Space Fuel"
	quest.6900000000000006.quest_desc: [
		"Distill Deepsea Crude Oil into Diesel for heavy power—and refine Stellaris Rocket Fuel for your eventual launch to Space."
	]
	quest.6900000000000007.title: "Optional Boss: The Leviathan"
	quest.6900000000000007.quest_subtitle: "Deepsea Sunken City"
	quest.6900000000000007.quest_desc: [
		"Use an Abyss Eye in the Deepsea to locate the Sunken City and challenge The Leviathan."
	]
	quest.6900000000000008.title: "Layer 3: Dimension of Caves"
	quest.6900000000000008.quest_subtitle: "Beneath the Deepsea Floor"
	quest.6900000000000008.quest_desc: [
		"Tunnel beneath the Deepsea seabed to enter the Dimension of Caves."
		"This layer is the exclusive home of AE2 Meteorites, Certus Quartz, and Alex's Caves Neodymium."
	]
	quest.6900000000000009.title: "Neodymium & Certus Quartz"
	quest.6900000000000009.quest_subtitle: "Cave-Layer Exclusives"
	quest.6900000000000009.quest_desc: [
		"Mine Scarlet & Azure Neodymium in Magnetic Caves and harvest Certus Quartz from underground AE2 Meteorites."
	]
	quest.690000000000000A.title: "AE2 Inscriber & Charger"
	quest.690000000000000A.quest_subtitle: "Neodymium-Gated AE2"
	quest.690000000000000A.quest_desc: [
		"Craft your AE2 Inscriber, Charger, and Processor Presses using Cave-layer Neodymium."
	]
	quest.690000000000000B.title: "Tesla-Powered ME Network"
	quest.690000000000000B.quest_subtitle: "Digital Storage Unlocked"
	quest.690000000000000B.quest_desc: [
		"Combine a Cave-layer Tesla Bulb, Smooth Sky Stone, and Fluix Crystals to build an ME Controller."
	]
	quest.690000000000000C.title: "Layer 4: Infinite Abyss"
	quest.690000000000000C.quest_subtitle: "Beneath the Caves"
	quest.690000000000000C.quest_desc: [
		"Descend past the Dimension of Caves into the flooded Infinite Abyss."
		"Astral Sorcery's starter ores and crystals are gated to this dark layer."
	]
	quest.690000000000000D.title: "Abyssal Starlight Minerals"
	quest.690000000000000D.quest_subtitle: "Rock Crystal & Aquamarine"
	quest.690000000000000D.quest_desc: [
		"Mine Rock Crystal Ore and Aquamarine Shale in the Infinite Abyss."
	]
	quest.690000000000000E.title: "Open-Sky Starlight Altars"
	quest.690000000000000E.quest_subtitle: "Bring back to Overworld Sky"
	quest.690000000000000E.quest_desc: [
		"Astral Sorcery altars require direct sky access! Bring your Infinite Abyss Rock Crystals back up to the Overworld Skylands to craft and attune."
	]
	quest.690000000000000F.title: "Layer 5: The Otherside"
	quest.690000000000000F.quest_subtitle: "Sculk Bridge Layer"
	quest.690000000000000F.quest_desc: [
		"Continue downward from the Infinite Abyss into the sculk-choked Otherside."
	]
	quest.6900000000000010.title: "Echo Shards"
	quest.6900000000000010.quest_subtitle: "Shadow Steel Catalyst"
	quest.6900000000000010.quest_desc: [
		"Collect Echo Shards here—you will need them later with Chromatic Compound to forge Shadow Steel for your rocket."
	]
	quest.6900000000000011.title: "Layer 6: The Undergarden"
	quest.6900000000000011.quest_subtitle: "Beneath the Otherside"
	quest.6900000000000011.quest_desc: [
		"Break through into the Undergarden."
		"All Ars Nouveau and Iron's Spells 'n Spellbooks starter stations—plus Mithril Ore—are gated here."
	]
	quest.6900000000000012.title: "Undergarden Alloys & Mithril"
	quest.6900000000000012.quest_subtitle: "Cloggrum, Utherium & Mithril"
	quest.6900000000000012.quest_desc: [
		"Mine Cloggrum, Froststeel, Utherium, and Mithril Ore in Depthrock and Shiverstone."
	]
	quest.6900000000000013.title: "Ars Nouveau"
	quest.6900000000000013.quest_subtitle: "Undergarden-Gated Spellcraft"
	quest.6900000000000013.quest_desc: [
		"Use Cloggrum and Utherium to craft your Novice Spell Book and Imbuement Chamber."
	]
	quest.6900000000000014.title: "Iron's Spells 'n Spellbooks"
	quest.6900000000000014.quest_subtitle: "Undergarden-Gated Runes"
	quest.6900000000000014.quest_desc: [
		"Use Froststeel, Cloggrum, Utherium, and Regalium to build the Scroll Forge and Arcane Anvil."
	]
	quest.6900000000000015.title: "Pre-Infernal Radiation Prep"
	quest.6900000000000015.quest_subtitle: "Craft BEFORE Layer 7!"
	quest.6900000000000015.quest_desc: [
		"Infernal Cross has constant ambient radiation. Craft a Hazmat Suit (Rubber + Brass), Rad-X, and RadAway before descending!"
	]
	quest.6900000000000016.title: "Layer 7: Infernal Cross"
	quest.6900000000000016.quest_subtitle: "Radioactive Blackstone Layer"
	quest.6900000000000016.quest_desc: [
		"Equip your Hazmat Suit and descend into Infernal Cross."
		"All NuclearCraft: Neohaul ores (Uranium, Thorium, Boron, Lithium, Magnesium, Tin) spawn exclusively in this dimension."
	]
	quest.6900000000000017.title: "NuclearCraft Ores & Fission"
	quest.6900000000000017.quest_subtitle: "Infernal Cross Mining"
	quest.6900000000000017.quest_desc: [
		"Mine NuclearCraft ores embedded in Blackstone and Netherrack to unlock fission reactors and endgame alloys."
	]
	quest.6900000000000018.title: "Layer 8: The Nether"
	quest.6900000000000018.quest_subtitle: "Beneath Infernal Cross"
	quest.6900000000000018.quest_desc: [
		"Descend below Infernal Cross into The Nether to harvest Blaze Rods and Glowstone for superheated Create mixing."
	]
	quest.6900000000000019.title: "Blaze Burners & Chromatic Compound"
	quest.6900000000000019.quest_subtitle: "Superheated Mixing"
	quest.6900000000000019.quest_desc: [
		"Feed Blaze Burners with Blaze Cakes to superheat Polished Rose Quartz, Glowstone, and Powdered Obsidian into Chromatic Compound."
	]
	quest.690000000000001A.title: "Optional Boss: Ignis"
	quest.690000000000001A.quest_subtitle: "Nether Burning Arena"
	quest.690000000000001A.quest_desc: [
		"Use a Flame Eye in The Nether to locate the Burning Arena and challenge Ignis."
	]
	quest.690000000000001B.title: "Layer 9: Molten Depths"
	quest.690000000000001B.quest_subtitle: "Stratified Molten Metals"
	quest.690000000000001B.quest_desc: [
		"Break into the Molten Depths—an extreme crust of fractured obsidian and layered reservoirs of molten metals."
	]
	quest.690000000000001C.title: "Molten Metal Reservoirs"
	quest.690000000000001C.quest_subtitle: "Industrial Metallurgy"
	quest.690000000000001C.quest_desc: [
		"Tap the layered molten metal pools and complete Precision Mechanisms to finalize high-tier rocket components."
	]
	quest.690000000000001D.title: "Shadow Steel & Refined Radiance"
	quest.690000000000001D.quest_subtitle: "Rocket Hull & Nose Cone"
	quest.690000000000001D.quest_desc: [
		"Superheat Chromatic Compound with Echo Shards & Obsidian for Shadow Steel (rocket body), and fill Chromatic Compound with Lumisene for Refined Radiance (nose cone)."
	]
	quest.690000000000001E.title: "Layer 10: The End"
	quest.690000000000001E.quest_subtitle: "Bottom of the Stack"
	quest.690000000000001E.quest_desc: [
		"Descend past the Molten Depths into The End at the very bottom of the world stack."
	]
	quest.690000000000001F.title: "Optional Boss: Scylla"
	quest.690000000000001F.quest_subtitle: "End / Open-Sky Acropolis"
	quest.690000000000001F.quest_desc: [
		"Use a Storm Eye in The End to locate the floating Acropolis and challenge Scylla."
	]
	quest.6900000000000030.title: "Rocket Station & Space Suit"
	quest.6900000000000030.quest_subtitle: "Ascend to the Top"
	quest.6900000000000030.quest_desc: [
		"Return to the Overworld Skylands with your Shadow Steel, Refined Radiance, and Deepsea Rocket Fuel. Build a Rocket Station, Rocket Nose Cone, and Space Suit."
	]
	quest.6900000000000031.title: "Launch to Space!"
	quest.6900000000000031.quest_subtitle: "Stellaris Finale"
	quest.6900000000000031.quest_desc: [
		"Assemble your Stellaris Rocket at the Rocket Station, place a Launch Pad under the open Overworld sky, fuel up, and blast off into Space!"
	]

	chapter.651F000000000000.title: "Applied Energistics 2"
	quest.651F000000000001.title: "Enter the Dimension of Caves"
	quest.651F000000000002.title: "Magnet Caves Neodymium"
	quest.651F000000000003.title: "Certus Quartz"
	quest.651F000000000004.title: "Neodymium Inscriber & Charger"
	quest.651F000000000005.title: "ME Processors"
	quest.651F000000000006.title: "Tesla-Powered ME Network"

	chapter.6520000000000000.title: "Thaumaturge"
	quest.6520000000000001.title: "Salis Mundus"
	quest.6520000000000001.quest_desc: [
		"Thaumaturge is completely ungated in the Overworld. Craft Salis Mundus to begin."
	]
	quest.6520000000000002.title: "The Thaumonomicon"
	quest.6520000000000003.title: "Thaumometer"
	quest.6520000000000004.title: "Arcane Workbench"
	quest.6520000000000005.title: "Crucible & Research Table"
	quest.6520000000000006.title: "Goggles of Revealing & Infusion"

	chapter.6521000000000000.title: "Cataclysm Bosses (Optional)"
	quest.6521000000000001.title: "No Bosses on the Overworld"
	quest.6521000000000001.quest_desc: [
		"All L_Ender's Cataclysm boss structures have been relocated off the Overworld into deeper dimensions as optional combat challenges."
	]
	quest.6521000000000002.title: "The Leviathan — Deepsea (Sunken City)"
	quest.6521000000000003.title: "The Harbinger — Dimension of Caves (Ancient Factory)"
	quest.6521000000000004.title: "Ender Guardian — Infinite Abyss (Ruined Citadel)"
	quest.6521000000000005.title: "Maledictus — Otherside (Frosted Prison)"
	quest.6521000000000006.title: "Ancient Remnant — Undergarden (Cursed Pyramid)"
	quest.6521000000000007.title: "Netherite Monstrosity — Infernal Cross (Soul Black Smith)"
	quest.6521000000000008.title: "Ignis — The Nether (Burning Arena)"
	quest.6521000000000009.title: "Scylla — The End (Acropolis)"
}

		""
		"{cabin.quest.6BC864CC7CB2C316.description2}"
	]
	quest.6BC864CC7CB2C316.title: "Ingot Electrum"
	quest.6C029983EE2035A5.quest_desc: [
		"Nether wart here is the awkward base of that haste potion, beside the glow berries."
		"The logistic mechanism is filled from the brew."
	]
	quest.6C029983EE2035A5.quest_subtitle: "{cabin.quest.6C029983EE2035A5.subtitle}"
	quest.6C029983EE2035A5.title: "Nether Wart"
	quest.6C4CB8F616A9C3DF.quest_desc: [
		"A blaze rod sits between basalt and blaze powder."
		"The powder is the step that becomes a fire charge."
	]
	quest.6C4CB8F616A9C3DF.quest_subtitle: "{cabin.quest.6C4CB8F616A9C3DF.subtitle}"
	quest.6C4CB8F616A9C3DF.title: "Blaze Rod"
	quest.6CBA3D97CAD5DB63.quest_desc: [
		"The inductive mechanism is the power-age mechanism, after the radiant coil and the resonator."
		"The Light Engineering block is the gate that follows it."
	]
	quest.6CBA3D97CAD5DB63.quest_subtitle: "{cabin.quest.6CBA3D97CAD5DB63.subtitle}"
	quest.6CBA3D97CAD5DB63.title: "Inductive Mechanism"
	quest.6CC8D9848625CC34.quest_desc: ["The path you've chosen is not for the faint of heart. If you're a bad enough dude to handle the Seven Curses, then put on the ring..."]
	quest.6CC8D9848625CC34.title: "One Ring to Rule Them All"
	quest.6D26DAB7D0FF6E90.quest_desc: [
		"Computer advanced is a ComputerCraft goal sitting beside the processor line."
		"This one is only the mark from the tea, and the wafers do not pass through it."
	]
	quest.6D26DAB7D0FF6E90.title: "Computer Advanced"
	quest.6D7D2E63F1E35329.quest_desc: [
		"This overview node tracks the brewing chapter milestone that opens the logistic and lead line."
	]
	quest.6D7D2E63F1E35329.quest_subtitle: "{cabin.quest.6D7D2E63F1E35329.subtitle}"
	quest.6D7D2E63F1E35329.title: "{cabin.quest.6D7D2E63F1E35329.title}"
	quest.6D7D504E9DC22590.quest_desc: ["{cabin.quest.6D7D504E9DC22590.description1}"]
	quest.6D7D504E9DC22590.title: "Ender Pearl"
	quest.6D8BB2D6A75ABB16.quest_desc: [
		"The wrench turns Create machines and picks them back up."
		"It sits between the electron tube and the precision mechanism."
	]
	quest.6D8BB2D6A75ABB16.title: "Wrench"
	quest.6D900619B1967D72.quest_desc: [
		"{cabin.quest.6D900619B1967D72.description1}"
		""
		"{cabin.quest.6D900619B1967D72.description2}"
	]
	quest.6D900619B1967D72.title: "Painting"
	quest.6DBEF7A11890ADF8.quest_desc: [
		"The abstruse mechanism is a heated mix of an inductive mechanism, an ender pearl, and chorus fruit."
		"The enderium machine is the gate cut from it."
	]
	quest.6DBEF7A11890ADF8.title: "Abstruse Mechanism"
	quest.6E3CD6919EAA9EE4.quest_desc: [
		"For your garden-variety autist, building a glider would mean gathering leather and other parts from local fauna. But you &oare&r the local fauna."
		"With an axe and a cutting board, you can take a little bit off the top, and harvest the supplies you need..."
	]
	quest.6E3CD6919EAA9EE4.title: "Skin Off My Nose"
	quest.6EE9AA6D2A8FE0AD.quest_desc: [
		"A sepia globe is the old-world marker after the second Lead Machine."
		"The wasteland visit, and the decorative lead and uranium art, sit behind it."
	]
	quest.6EE9AA6D2A8FE0AD.title: "Epilogue: Rewriting History"
	quest.6F0E3626FD191407.title: "fwooosh"
	quest.6F4B1FC2E7182883.title: "Khajiit Has Wares"
	quest.6F56109274CDF42A.quest_desc: ["wooda"]
	quest.6F56109274CDF42A.title: "Chop Vood"
	quest.6F750A66D0A559DE.quest_desc: [
		"Blaze cake is the same superheat fuel the brass age used to melt iron."
		"Here it feeds matter plastics beside the paraffin."
	]
	quest.6F750A66D0A559DE.title: "Blaze Cake"
	quest.6FDC8DA2FDED5FDD.quest_desc: [
		"The silicon reagent sits outside the seven rows."
		"The laser chaos pairing can make it, and an extractor pulls the dust back out."
	]
	quest.6FDC8DA2FDED5FDD.title: "Substrate Silicon"
	quest.7021A2BD8775DC07.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.7021A2BD8775DC07.title: "Lead Casing"
quest.7021A2BD8775DC07.quest_desc: [
		"A lead casing is the shell a logistic mechanism wears."
		"Packagers, frogports, and the stock link are built in that shell."
	]
	quest.7061F42CF050ADCA.quest_desc: ["{cabin.quest.7061F42CF050ADCA.description1}"]
	quest.7061F42CF050ADCA.title: "Cogwheel"
	quest.70D563EF30E9CB97.quest_desc: [
		"Raw logic fluid is the ink the computation-matrix digits are made from."
		"Three, eight, and the plus sign start here."
	]
	quest.70D563EF30E9CB97.quest_subtitle: "{cabin.quest.70D563EF30E9CB97.subtitle}"
	quest.70D563EF30E9CB97.title: "Raw Logic Bucket"
	quest.715BBD0DF0136FF1.quest_subtitle: "{cabin.quest.21E76761CD3761C2.subtitle}"
	quest.715BBD0DF0136FF1.title: "{cabin.quest.715BBD0DF0136FF1.title}"
	quest.71659ADD9BF9E5A1.quest_desc: ["The crossbow: a weapon so simple, even the tyrants of the outer isles permit their peasants to own one. While it's hardly a real weapon by Cactoid standards, your race's talent for biosmithing will help you transform it into something better later."]
	quest.71659ADD9BF9E5A1.title: "Legal in the UK"
	quest.71D90A1E5D53FC0A.quest_desc: [
		"Processor binding is the strap a Refined Storage processor wears."
		"This chapter puts it in front of the flash drive and the calculation mechanism."
	]
	quest.71D90A1E5D53FC0A.quest_subtitle: "{cabin.quest.71D90A1E5D53FC0A.subtitle}"
	quest.71D90A1E5D53FC0A.title: "Processor Binding"
	quest.727B43FD95C4A512.quest_desc: [
		"Builders tea is the drink that opens the brass age."
		"Sand, water, cobblestone, and the removed crystal steps all sit behind this cup."
	]
	quest.727B43FD95C4A512.title: "Builders Tea"
	quest.729FB5DD07C234E8.quest_desc: [
		"Clay balls are the clay the blend actually uses."
		"With kelp or seagrass they make algal blend, and that blend is masonry."
	]
	quest.729FB5DD07C234E8.quest_subtitle: "{cabin.quest.729FB5DD07C234E8.subtitle}"
	quest.729FB5DD07C234E8.title: "Clay"
	quest.72BE175C83834838.quest_desc: [
		"Algal blend is clay with kelp or seagrass."
		"It smelts into an algal brick. The brick is masonry. Andesite alloy does not use it."
	]
	quest.72BE175C83834838.quest_subtitle: "{cabin.quest.72BE175C83834838.subtitle}"
	quest.72BE175C83834838.title: "Algal Blend"
	quest.73473DC7269EC5B0.quest_subtitle: "{cabin.quest.73473DC7269EC5B0.subtitle}"
	quest.73641E4A11A71215.quest_desc: ["Now that you've got iron, you can build a gun bench. Once you have that, all it'll take to cobble together a real gun is some wood and rocks. The ATF will never know a thing."]
	quest.73641E4A11A71215.title: "Unregistered Firearm"
	quest.73FCA432DEFC1DED.quest_desc: [
		"Andesite alloy is two andesite and two iron nuggets, or two andesite and two zinc nuggets, and it makes one."
		"An unheated mixer makes the same alloy. Algal bricks are not part of it. The kinetic mechanism is built on this alloy."
	]
	quest.73FCA432DEFC1DED.quest_subtitle: "Andesite and a nugget"
	quest.73FCA432DEFC1DED.title: "Andesite Alloy"
	quest.746F9F4F21D8400D.quest_subtitle: "{cabin.quest.1250AE58911C27A9.subtitle}"
	quest.746F9F4F21D8400D.title: "{cabin.quest.746F9F4F21D8400D.title}"
	quest.74D22D54CA80E7FD.quest_desc: [
		"A brown mushroom is the cap the glowing potion soaks."
		"The result is a glowing mushroom for radaway."
	]
	quest.74D22D54CA80E7FD.quest_subtitle: "Contraption 19-4"
	quest.74D22D54CA80E7FD.title: "mmm, musroom"
	quest.74F82F70F43DF148.quest_desc: [
		"A Daemon's mind is digital perfection, but its body mere flesh. A construct lacks a mind, yet its body is pure machine. Daemonkind has long sought to merge the two, all attempts in vain. Still, a construct could be useful."
		""
		"Constructs are fueled by \"animus\". Organics consider it a magical substance, known only to wizards. But as a Daemon, your own blood yielded a trace amount. Build the parts, arrange them on an armor stand, and apply the animus dust. That strange bell you found in a dungeon years ago should let you command it."
	]
	quest.74F82F70F43DF148.title: "Silica Animus"
	quest.75FB28B253B14876.quest_desc: [
		"An oak log is the first wood of the workshop."
		"Planks, slabs, and the andesite age all start from a tree."
	]
	quest.75FB28B253B14876.quest_subtitle: "The first wood"
	quest.75FB28B253B14876.title: "Oak Log"
	quest.7650D7E4FE40E2C7.title: "Angelic Feather"
	quest.7664FBB32FCC6BE6.quest_desc: [
		"This overview node tracks the deepslate chapter milestone on the way to obsidian and the gold machine."
	]
	quest.7664FBB32FCC6BE6.quest_subtitle: "{cabin.quest.7664FBB32FCC6BE6.subtitle}"
	quest.7664FBB32FCC6BE6.title: "{cabin.quest.7664FBB32FCC6BE6.title}"
	quest.76706BE282ABAC31.quest_desc: [
		"A reinforced mechanism is a kinetic mechanism between two obsidian, crafted by hand."
		"The sequenced assembly is a later path, once a deployer exists. The Gold Machine is stage 2, and it wraps this mechanism in railway casing."
	]
	quest.76706BE282ABAC31.title: "Reinforced Mechanism"
	quest.779266F2F19F839E.quest_desc: ["You've got all the parts, all that remains is to assemble the glider and lift off. That's one small step for rat, one giant leap for rat-kind."]
	quest.779266F2F19F839E.title: "The Flying Rat"
	quest.780E8AE86250C73D.quest_desc: [
		"This overview node tracks the chapter milestone that opens the inductive age."
	]
	quest.780E8AE86250C73D.quest_subtitle: "{cabin.quest.780E8AE86250C73D.subtitle}"
	quest.780E8AE86250C73D.title: "{cabin.quest.780E8AE86250C73D.title}"
	quest.7888F9129E9FE517.quest_desc: [
		"This crafting blueprint is the infernal gate, the heat line after brass."
		"The Zinc Machine is cut from that mechanism."
	]
	quest.7888F9129E9FE517.quest_subtitle: "{cabin.quest.7888F9129E9FE517.subtitle}"
	quest.7888F9129E9FE517.title: "Crafting Blueprint"
	quest.78A8751AF86E0E32.quest_desc: [
		"{cabin.quest.78A8751AF86E0E32.description1}"
		""
		"{cabin.quest.78A8751AF86E0E32.description2}"
	]
	quest.78A8751AF86E0E32.title: "Cobblestone"
	quest.7927B6162577FA7B.quest_desc: [
		"Five is a computation-matrix digit, beside four."
		"The matrix asks for it with zero through nine."
	]
	quest.7927B6162577FA7B.quest_subtitle: "{cabin.quest.7927B6162577FA7B.subtitle}"
	quest.794B3C10C6110CB5.quest_desc: [
		"A chorus flower is the end plant on this branch."
		"It opens the harvester and the electrum that sit in front of the abstruse mechanism."
	]
	quest.794B3C10C6110CB5.title: "Chorus Flower"
	quest.794DF747BF925C4B.title: "Sugar Dealer"
	quest.7967324CAC77AF60.quest_subtitle: "{cabin.quest.7967324CAC77AF60.subtitle}"
	quest.7967324CAC77AF60.title: "Golden Pickaxe"
	quest.7A3C54CE8AD783D4.quest_desc: [
		"The End of the World is a visit to the wasteland after the sepia globe."
		"It is the far edge of the uranium line."
	]
	quest.7A3C54CE8AD783D4.title: "The End of the World"
	quest.7A99056A697C4CEC.quest_desc: ["Aparently theres a rock that can remmber experiences. Thatd be even better then having a brain cus a rock is cooler and i can show off to bolbis frends and stuff."]
	quest.7A99056A697C4CEC.title: "the Smart rock"
	quest.7A9AA27029185035.quest_desc: [
		"Substrate chaos is the failed or wild laser output."
		"It is what a pairing leaves when it does not land on a clean row."
	]
	quest.7A9AA27029185035.title: "Substrate Chaos"
	quest.7AAE71F57FB89BCC.quest_desc: [
		"A crushing wheel is mechanical crafting. One pattern is andesite alloy, planks, and stone. Another is cobblestone and sticks. Both need the crafter a brass machine cuts."
		"Crushed raw iron, the iron steel is mixed from, comes off this wheel. The chromatic singularity mix later eats a wheel as well."
	]
	quest.7AAE71F57FB89BCC.quest_subtitle: "{cabin.quest.44540B11F341AE09.subtitle}"
	quest.7AAE71F57FB89BCC.title: "Crushing Wheel"
	quest.7B080B5C87247EA1.quest_desc: [
		"Electrum is the ingot this chapter places in front of the abstruse mechanism, after chorus and an ender pearl."
		"The mechanism itself is a heated mix of an inductive mechanism, an ender pearl, and chorus fruit."
	]
	quest.7B080B5C87247EA1.title: "Ingot Electrum"
	quest.7B23C933D76458BA.quest_desc: [
		"Chromatic compound is the drained singularity, the five dyes gathered into one material."
		"It feeds refined radiance."
	]
	quest.7B23C933D76458BA.quest_subtitle: "{cabin.quest.7B23C933D76458BA.subtitle}"
	quest.7B23C933D76458BA.title: "Chromatic Compound"
	quest.7BE0F4512FE4936D.quest_desc: [
		"A Lead Machine is a lead casing around a logistic mechanism."
		"Packagers, frogports, and the stock link are cut from it."
	]
	quest.7BE0F4512FE4936D.quest_subtitle: "Lead casing around a logistic mechanism"
	quest.7BE0F4512FE4936D.title: "Lead Machine"
	quest.7C26B21C40608612.quest_desc: ["Laboring with one's flesh is unbecoming for a Daemon. And worse, it's inefficient. But you need materials to build your machines in the first place. Swallow your pride for now, and gather some base metals. Just remember to clear your cookies after."]
	quest.7C26B21C40608612.title: "Bootstrapping"
	quest.7C31A0611CC62360.quest_subtitle: "Fuel for the fission reactor"
	quest.7C31A0611CC62360.title: "Uranium Rod"
quest.7C31A0611CC62360.quest_desc: [
		"A uranium rod is the fuel a fission reactor burns."
		"Enrichment is the work of turning uranium into rods like this."
	]
	quest.7D6BC99CCCB29924.quest_desc: [
		"The andesite workshop is the press, the saw, the fan, the wrench, the mixer, the basin, and the millstone."
		"Those contraptions are cut from the Andesite Machine."
	]
	quest.7D6BC99CCCB29924.quest_subtitle: "Press, saw, fan, mixer, and millstone"
	quest.7D6BC99CCCB29924.title: "Andesite Workshop"
	quest.7D808F15BEDD7A7B.quest_desc: [
		"Nine is the last computation-matrix digit."
		"With zero through eight it completes the thinking machine."
	]
	quest.7D808F15BEDD7A7B.quest_subtitle: "{cabin.quest.7D808F15BEDD7A7B.subtitle}"
	quest.7D872F933F45809B.quest_desc: [
		"This crafting blueprint is the rubber gate, the sealed mechanism off the andesite age."
		"It opens the copper branch."
	]
	quest.7D872F933F45809B.quest_subtitle: "{cabin.quest.7D872F933F45809B.subtitle}"
	quest.7D872F933F45809B.title: "Crafting Blueprint"
	quest.7E59B7DC239E621E.quest_desc: [
		"Weeping vines are the other nether vine."
		"Heated with twisting vines they make the plasma for the infernal mechanism."
	]
	quest.7E59B7DC239E621E.quest_subtitle: "{cabin.quest.7E59B7DC239E621E.subtitle}"
	quest.7E59B7DC239E621E.title: "Weeping Vines"
	quest.7FC4D1E69377271D.quest_desc: [
		"A Brass Machine is brass casing wrapped around a precision mechanism."
		"The crafter, the arm, and the other brass-gated machines are cut from it. A steam engine is also crafted from andesite alloy, a copper block, and a gold plate."
	]
	quest.7FC4D1E69377271D.quest_subtitle: "Casing around a precision mechanism"
	quest.7FC4D1E69377271D.title: "Brass Machine"

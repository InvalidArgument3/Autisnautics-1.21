	quest.11862F961F13287D.quest_desc: ["Blobbis dont have a brain so i dont member any experienices. But if blobbers eat stuffs thats got experimences in it then i can save em for later. like the bottle one tahts blue flavor for some reason or the square nuggies :DDD"]
	quest.11862F961F13287D.title: "mmm nuggies"

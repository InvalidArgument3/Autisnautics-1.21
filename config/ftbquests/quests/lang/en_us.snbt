	quest.3E391D4870926B8F.quest_desc: ["As a rat, your tough teeth let you mine stone without any tools. That should be useful for crafting a stone chisel, which you could use to carve pint-sized details."]
	quest.3E391D4870926B8F.title: "Hidey Hole"
	quest.3EB5CD9776DF0E63.quest_desc: [
		"Assemble a scoria reagent (kubejs:substrate_scoria). The jar ingredient is scoria (create:scoria)."
		"The sequence is an open jar, that ingredient deployed in, then a wooden slab as the lid. It sits on the netherrack row."
		"Four reagents from one row, in the Alchemical Laser, are the world's seed-rolled recipe for that row's catalyst. Ponder the laser. JEI has the jar. The tome does not."
	]
	quest.3EEF098FB1D343AD.quest_desc: ["{image: width:100 height:100 align:center}"]

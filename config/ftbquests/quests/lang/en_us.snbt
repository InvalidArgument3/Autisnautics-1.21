	quest.26C39961F2E2ABF2.title: "Golden Sheet"
	quest.26DD1CA6A8D4E249.quest_desc: [
		"Rocket fuel is what the rocket burns."
		"This ask comes straight off finding crude oil."
	]
	quest.26DD1CA6A8D4E249.title: "Rocket Fuel"
	quest.2727DB837CE5B37E.title: "its a tree :)"
	quest.27C191346BB14D9D.quest_desc: [
		"This sand is the gather after bone meal, on the way to the chromatic singularity."
		"The singularity itself is the heated mix further down the page."
	]
	quest.27C191346BB14D9D.quest_subtitle: "{cabin.quest.27C191346BB14D9D.subtitle}"
	quest.27C191346BB14D9D.title: "Sand"
	quest.2809AE02EA018BFA.quest_desc: [
		"this quest is never completed, so it ensures its dependent quests can never be completed"
		""
		"(this probably isn't necessary)"
	]
	quest.2809AE02EA018BFA.title: "never"
	quest.286510750C333C1F.quest_desc: [
		"A spout fills one chromatic compound with 250 mB of lumisene, the light drained from the chromatic singularity."
		"It presses into a radiant sheet. Dropping the compound in light still wants a beacon."
	]
	quest.286510750C333C1F.quest_subtitle: "{cabin.quest.286510750C333C1F.subtitle}"
	quest.286510750C333C1F.title: "Refined Radiance"
	quest.28DAED70768C6A50.quest_desc: [
		"The controller is a ring of fluix casings around a calculation mechanism."
		"It is the block that runs a Refined Storage network."
	]
	quest.28DAED70768C6A50.quest_subtitle: "Fluix casings around a calculation mechanism"
	quest.28DAED70768C6A50.title: "Controller"
	quest.29D37095C73B3DEC.quest_desc: [
		"A belt connector is the belt that carries items. Six dried kelp make one."
		"The sealed mechanism is next."
	]
	quest.29D37095C73B3DEC.quest_subtitle: "Dried kelp"
	quest.29D37095C73B3DEC.title: "Belt Connector"
	quest.29DABB5FDE6356E9.title: "{cabin.quest.29DABB5FDE6356E9.title}"
	quest.2B195E5B195246F5.quest_desc: [
		"A bone meal reagent is a jar on the egg row, after the plain dyes."
		"Blaze shares that row, and four reagents from it become the catalyst."
	]
	quest.2B8F1D804107EB8C.quest_desc: [
		"Finished processors are the smelted dice: basic, improved, and advanced."
		"Disks, grids, and importers are built on them."
	]
	quest.2B8F1D804107EB8C.quest_subtitle: "{cabin.quest.2B8F1D804107EB8C.subtitle}"
	quest.2B8F1D804107EB8C.title: "Finished Processors"
	quest.2BB2C7B95E3C89AE.quest_desc: [
		"This crafting blueprint is the abstruse gate, the enderium line after the inductive age."
	]
	quest.2BB2C7B95E3C89AE.quest_subtitle: "{cabin.quest.2BB2C7B95E3C89AE.subtitle}"
	quest.2BB2C7B95E3C89AE.title: "Crafting Blueprint"
	quest.2BD76CB3F8BC215E.quest_desc: [
		"Crude oil in a bucket is the stock the second rocket-fuel ask is filled from."
		"The find comes first, and the bucket is what you actually hold."
	]
	quest.2BD76CB3F8BC215E.title: "Crude Oil Bucket"
	quest.2BE033F631A778D9.title: "{cabin.quest.2BE033F631A778D9.title}"
	quest.2C196D41B3B087C6.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.2C196D41B3B087C6.title: "Lead Casing"
quest.2C196D41B3B087C6.quest_desc: [
		"A lead casing is the shell a logistic mechanism wears."
		"Packagers, frogports, and the stock link are built in that shell."
	]
	quest.2C2E304910D7F33D.quest_subtitle: "{cabin.quest.2C2E304910D7F33D.subtitle}"
	quest.2C2E304910D7F33D.title: "{cabin.quest.2C2E304910D7F33D.title}"
	quest.2C40901DB42DD8F8.quest_desc: [
		"Bone meal is the fertilizer the chromatic line collects."
		"Crops and the singularity mix both have a use for it."
	]
	quest.2C40901DB42DD8F8.quest_subtitle: "Fertilizer for the colour line"
	quest.2C40901DB42DD8F8.title: "Bone Meal"
	quest.2C7ADB6C11B918B1.quest_desc: [
		"{cabin.quest.2C7ADB6C11B918B1.description1}"

		"{cabin.quest.2C7ADB6C11B918B1.description2}"
	]
	quest.2C7ADB6C11B918B1.title: "The Magic Mods"
	quest.2C81D358594C4352.quest_desc: [
		"Quartz enriched iron anchors the chromatic singularity mix."
		"The heated mix is a crushing wheel, two of these ingots, an ender pearl, and red, yellow, green, blue, and magenta dye."
	]
	quest.2C81D358594C4352.quest_subtitle: "{cabin.quest.2C81D358594C4352.subtitle}"
	quest.2C81D358594C4352.title: "Quartz Enriched Iron"
	quest.2CB570195DA7E106.quest_desc: [
		"A log is the wood this age starts from."
		"It becomes planks, then a slab, then a stripped log for the kinetic mechanism."
	]
	quest.2CB570195DA7E106.quest_subtitle: "{cabin.quest.2CB570195DA7E106.subtitle}"
	quest.2CB570195DA7E106.title: "Log"
	quest.2CCD84D55DE71EB2.quest_desc: [
		"The chromatic singularity is that heated mix of wheel, quartz enriched iron, ender pearl, and the five dyes."
		"Draining it yields chromatic compound."
	]
	quest.2CCD84D55DE71EB2.quest_subtitle: "{cabin.quest.2CCD84D55DE71EB2.subtitle}"
	quest.2CCD84D55DE71EB2.title: "Chromatic Singularity"
	quest.2DC3AA8A89005C42.quest_desc: [
		"Apple cider is a drink counter for the infernal mechanism."
		"It marks the heat branch after brass."
	]
	quest.2DC3AA8A89005C42.quest_subtitle: "{cabin.quest.11C36A243F5108DC.subtitle}"
	quest.2DC3AA8A89005C42.title: "Apple Cider"
	quest.2F1B9FE2E9C2FFEC.quest_desc: [
		"Milk is the other half of radaway, beside the glowing mushrooms."
		"The enrichment line will not open without that wash."
	]
	quest.2F1B9FE2E9C2FFEC.quest_subtitle: "Contraption 19-6"
	quest.2F1B9FE2E9C2FFEC.title: "Milk: It's Legal"
	quest.2F469F6F1511D9C4.quest_desc: [
		"{cabin.quest.2F469F6F1511D9C4.description1}"
		""
		"{cabin.quest.2F469F6F1511D9C4.description2}"
	]
	quest.2F469F6F1511D9C4.title: "Scaffolding"
	quest.2F50046724A0DF9C.quest_desc: [
		"Apple cider is a drink counter for the abstruse mechanism."
		"It marks the enderium branch."
	]
	quest.2F50046724A0DF9C.quest_subtitle: "{cabin.quest.11C36A243F5108DC.subtitle}"
	quest.2F50046724A0DF9C.title: "Apple Cider"
	quest.2F51EA6259AD6A44.quest_desc: ["There is another form of construct, far more complex to use but highly versatile. The \"turtle\", a multipurpose robot build around a computer, can automate all sorts of tasks. If you never want to labor with those pitiful flesh hands again, making a turtle would help. You'll have to develop some sophisticated technology to even build one... unless a village might have one laying around?"]
	quest.2F51EA6259AD6A44.title: "It's Not A Digital Miner"
	quest.2FFFE1C5366930BB.quest_desc: [
		"A water bucket sits beside that sand."
		"Nether quartz waits on both, and the removed sky-solution step used to wait on the water too."
	]
	quest.2FFFE1C5366930BB.title: "Water Bucket"
	quest.3025B5861FE17ADF.quest_desc: [
		"This sand node is a mark in front of refined radiance."
		"It is the plain gather of this chapter, before the sand that feeds the singularity or the sand that packs into TNT."
	]
	quest.3025B5861FE17ADF.quest_subtitle: "{cabin.quest.3025B5861FE17ADF.subtitle}"
	quest.3025B5861FE17ADF.title: "Sand"
	quest.302FCD205CC2F708.quest_desc: [
		"Blue dye is the fourth spectrum dye."
		"It belongs in the singularity mix, then in the compound that mix drains into."
	]
	quest.302FCD205CC2F708.title: "Blue Dye"
	quest.30C8408E8F663FA2.title: "its a tree :)"
	quest.3126DE83A6741671.quest_desc: [
		"Eight is the other early digit from raw logic."
		"With three and the plus sign, it unlocks the rest of the matrix."
	]
	quest.3126DE83A6741671.quest_subtitle: "{cabin.quest.3126DE83A6741671.subtitle}"
	quest.3147E9D7F547137E.quest_desc: ["the first stick is a conmplete debacle. i forgot the up stick is a different stick actualy. Everyons gonna laugh at bolbis  if we dont get rid of the evidince. theres only one way........"]
	quest.3147E9D7F547137E.title: "BLAST em"
	quest.319D13EA51472303.quest_desc: [
		"Radaway is the radiation wash mixed from glowing mushrooms and milk."
		"Uranium enrichment waits on it, with the uranium and a source of steel."
	]
	quest.319D13EA51472303.quest_subtitle: "Contraption 19-7"
	quest.319D13EA51472303.title: "Rads, Away"
	quest.31DA3A80C6E23004.quest_subtitle: "Fuel for the fission reactor"
	quest.31DA3A80C6E23004.title: "Uranium Rod"
quest.31DA3A80C6E23004.quest_desc: [
		"A uranium rod is the fuel a fission reactor burns."
		"Enrichment is the work of turning uranium into rods like this."
	]
	quest.31EDFA6D2FF86CB0.quest_desc: [
		"{cabin.quest.31EDFA6D2FF86CB0.description1}"

		"{cabin.quest.31EDFA6D2FF86CB0.description2}"

		"{cabin.quest.31EDFA6D2FF86CB0.description3}"
	]
	quest.31EDFA6D2FF86CB0.title: "Off You Go"
	quest.3249CD08992F2BCD.quest_desc: [
		"Charcoal is a cooked log."
		"It feeds coal coke, and the printed-calculation pause sits beside that cook."
	]
	quest.3249CD08992F2BCD.quest_subtitle: "{cabin.quest.3249CD08992F2BCD.subtitle}"
	quest.3249CD08992F2BCD.title: "Charcoal"
	quest.32CB540B4C01720A.title: "its a tree :)"
	quest.334146C815B304DB.quest_desc: [
		"{cabin.quest.334146C815B304DB.description1}"
		""
		"{cabin.quest.334146C815B304DB.description2}"
	]
	quest.334146C815B304DB.title: "Pipe Module Tier 1"
	quest.33674138F4866C18.quest_desc: [
		"A printed calculation processor is the patterned die on the wafer line."
		"Smelting that die finishes a processor the storage network can use."
	]
	quest.33674138F4866C18.quest_subtitle: "The patterned die"
	quest.33674138F4866C18.title: "Printed Calculation Processor"
	quest.342BB6EF80EBFDCA.quest_desc: [
		"Apple cider is a drink counter for the sealed mechanism."
		"It marks the copper branch once that mechanism exists."
	]
	quest.342BB6EF80EBFDCA.quest_subtitle: "{cabin.quest.11C36A243F5108DC.subtitle}"
	quest.342BB6EF80EBFDCA.title: "Apple Cider"
	quest.343050A40A3AB1F0.quest_desc: [
		"Purified sand is washed rough sand."
		"With a coke chunk it becomes silicon compound."
	]
	quest.343050A40A3AB1F0.quest_subtitle: "{cabin.quest.343050A40A3AB1F0.subtitle}"
	quest.343050A40A3AB1F0.title: "Purified Sand"
	quest.345B94F6D17605CD.quest_desc: [
		"Nether quartz is the quartz half of rose quartz."
		"Redstone is the other half, after the crystal steps that left with AE2."
	]
	quest.345B94F6D17605CD.quest_subtitle: "{cabin.quest.345B94F6D17605CD.subtitle}"
	quest.345B94F6D17605CD.title: "Nether Quartz"
	quest.34A1D176C78FB64E.quest_desc: [
		"Crystal growth left with AE2."
		"Nether quartz still passes this spot, and the line goes on to rose quartz without growing a crystal."
	]
	quest.34A1D176C78FB64E.quest_subtitle: "{cabin.quest.34A1D176C78FB64E.subtitle}"
	quest.34A1D176C78FB64E.title: "Crystal Growth (removed)"
	quest.352F5F851045653A.quest_subtitle: "{cabin.quest.352F5F851045653A.subtitle}"
	quest.352F5F851045653A.title: "{cabin.quest.352F5F851045653A.title}"
	quest.35F18B3DFEFEC5C6.quest_desc: [
		"Lesser beings use these intro quests to learn about some early-game gizmos for traversing the floating islands. But you're not one of those casuals. All an Accursed One needs to get around is a sword."
		""
		"Luckily, like all hardcore warriors, you had some spare bones and edgy rocks lying around in your pockets. Perfect to forge your first blade with."
	]
	quest.35F18B3DFEFEC5C6.title: "Fuck Quests"
	quest.3680C9F8751A9E5F.quest_desc: [
		"The curse you bear makes neutral mobs aggro on you immediately. This includes Endermen. This means they could teleport in and attack you at any time. The spirit within your weapon seethes at the audacity of these monsters. Bathe its blade in their alien blood, and your sword may manifest a new power..."
		""
	]
	quest.3680C9F8751A9E5F.title: "Disgusting Black Creatures"
	quest.3728DF562D6DCE3A.quest_desc: [
		"Raw rubber is vines, flowers, or resin."
		"It cooks into rubber, and that rubber seals a kinetic mechanism."
	]
	quest.3728DF562D6DCE3A.quest_subtitle: "Vines, flowers, or resin"
	quest.3728DF562D6DCE3A.title: "Raw Rubber"
	quest.374933A06E016CE9.quest_desc: ["{cabin.quest.374933A06E016CE9.description1}"]
	quest.374933A06E016CE9.title: "Redstone"
	quest.375C9A43FE5620B6.quest_desc: [
		"These ender pearls sit on the old reactor branch."
		"The reactor left with AE2, and the singularity mix still wants an ender pearl of its own."
	]
	quest.375C9A43FE5620B6.quest_subtitle: "{cabin.quest.375C9A43FE5620B6.subtitle}"
	quest.375C9A43FE5620B6.title: "Ender Pearls"
	quest.376F399A85832658.title: "Basic Information"
	quest.381F8F373605BB97.quest_desc: [
		"Yellow dye is the second spectrum dye in that same mix, between red and green."
		"The compound those dyes drain into is the next bright material."
	]
	quest.381F8F373605BB97.title: "Yellow Dye"
	quest.382EBC32AC27C839.quest_desc: ["{cabin.quest.382EBC32AC27C839.description1}"]
	quest.382EBC32AC27C839.title: "Log"
	quest.38B063C8DE71E86D.quest_desc: [
		"A numismatics cog is the coin gear between the inductive mechanism and the end stone."
		"The ender branch uses it as a step, not as a Create cogwheel."
	]
	quest.38B063C8DE71E86D.title: "Cog"
	quest.38D19F4EC634F33B.quest_desc: [
		"Slime gathered after the fern is the first ball on the branch the reactor used to own."
		"A second slime node splits that branch toward gunpowder."
	]
	quest.38D19F4EC634F33B.quest_subtitle: "{cabin.quest.38D19F4EC634F33B.subtitle}"
	quest.38D19F4EC634F33B.title: "Slime Ball"
	quest.3934AD57122B6FFE.quest_desc: [
		"This crafting blueprint is the alchemical laser, the chaos gate beside the calculation age."
		"Substrate chaos is the wild output that gate is named for."
	]
	quest.3934AD57122B6FFE.quest_subtitle: "{cabin.quest.3934AD57122B6FFE.subtitle}"
	quest.3934AD57122B6FFE.title: "Crafting Blueprint"
	quest.397232F676CB621B.quest_desc: [
		"Builders tea is the drink that opens the inductive age."
		"Sand, a log, a fern, and the redstone-link nodes start from this cup."
	]
	quest.397232F676CB621B.title: "Builders Tea"
	quest.3A24852885341D52.title: "Quick Nap"

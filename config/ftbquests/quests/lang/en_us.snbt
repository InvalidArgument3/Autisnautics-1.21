quest.0504DC3275C4F49D.quest_desc: [
		"A uranium rod is the fuel a fission reactor burns."
		"Enrichment is the work of turning uranium into rods like this."
	]
	quest.050A20198A80CF1A.quest_desc: [
		"Gunpowder is the charge that branch still collects."
		"It packs into TNT, and the reactor that used to take the TNT is already gone."

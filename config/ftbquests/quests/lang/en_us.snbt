	quest.0B8816319F81C12A.title: "Enchanted Book"
	quest.0BE1DA955F49FBD6.quest_desc: ["Rats may have a lot of talents, but flying isn't one of them. At least, not yet. There's only one way to get started down the path to rat-powered flight. Time to punch trees."]
	quest.0BE1DA955F49FBD6.title: "Gnawing Logs"
	quest.0C11EC34D5FA508B.quest_desc: [
		"End stone is the pale stone of the outer islands."
		"Chorus grows on it, and the enderium work is built out here."
	]
	quest.0C11EC34D5FA508B.quest_subtitle: "Stone of the outer islands"
	quest.0C11EC34D5FA508B.title: "End Stone"
	quest.0CC92E94D10E681D.quest_desc: [
		"Another iron reagent for the wool row, after the metal jars around it."
	]
	quest.0CE88FEA070DC46C.quest_desc: [
		"Computer advanced is the ComputerCraft goal reached from the laser accelerators."
		"Passing it opens a second ask for Refined Storage silicon."
	]
	quest.0CE88FEA070DC46C.title: "Computer Advanced"
	quest.0D146AD9FE774F8B.quest_desc: [
		"A log on the ender branch sits between the end stone mark and the electrum ingot."
		"Electrum is what this chapter places in front of the abstruse mechanism."
	]
	quest.0D146AD9FE774F8B.title: "Log"
	quest.0D739DC45906A4EB.quest_desc: ["eek"]
	quest.0D739DC45906A4EB.title: "rat_parts"
	quest.0DCC71420C57E089.quest_desc: [
		"It's said that once in every Cactoid's life, he enters a strange mood and seeks out rare organic materials. In this temporary state, the Cactoid's genetically-engineered instincts let it fuse biology with metal to forge a unique living tool, a phenomenon known as \"biosmithing\"."
		"Your instincts cry out - this crossbow could be something more, if only you had the right parts! You sense the need for tentacles, yes... giant orange tentacles, from a leviathan of the deep sea! But even if such a beast existed in this world, you might never find it..."
		"Plan B: slaughter enough fish, rip open their guts, and surely you'd find a few decent tentacles in their stomachs."
	]
	quest.0DCC71420C57E089.title: "Fish Fear Me"
	quest.0E0535849D8D9279.quest_desc: [
		"The Copper Machine is the fluid gate of the andesite age, built around a sealed mechanism."
		"Spouts, drains, and the other fluid machines are cut from it."
	]
	quest.0E0535849D8D9279.title: "Copper Machine"
	quest.0E4476BA80B316F6.quest_desc: ["{cabin.quest.0E4476BA80B316F6.description1}"]
	quest.0E4476BA80B316F6.title: "Salmon"
	quest.0E98B4D2BBF55308.quest_desc: [
		"This overview node tracks the andesite chapter milestone, once a kinetic mechanism exists."
	]
	quest.0E98B4D2BBF55308.quest_subtitle: "{cabin.quest.08716DBF9C882623.subtitle}"
	quest.0E98B4D2BBF55308.title: "{cabin.quest.0E98B4D2BBF55308.title}"

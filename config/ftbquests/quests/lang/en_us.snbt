	quest.01C36D2B3E49D379.quest_desc: ["i think to make the up stick blobbis needs rose metal. that sounids unreasonmably expensive and frankly bolbi isnt made of monney. Im just gonna make my own. if blobb already rose this far then metal can rose too."]
	quest.01C36D2B3E49D379.title: "Rise of the bllob"
	quest.02B2E249421FAE58.quest_desc: [
		"TNT is that gunpowder, packed, after the sand on this branch."
		"The line goes on to the singularity without the reactor."
	]
	quest.02B2E249421FAE58.quest_subtitle: "{cabin.quest.02B2E249421FAE58.subtitle}"
	quest.02B2E249421FAE58.title: "Tnt"
	quest.02E41EDC1899468D.quest_desc: [
		"A glowing mushroom is a brown mushroom soaked in potion of glowing."
		"With milk it becomes radaway."
	]
	quest.02E41EDC1899468D.quest_subtitle: "Contraption 19-5"
	quest.02E41EDC1899468D.title: "Rad-Scrubbing Fungi"
	quest.034B6B71E610D8E1.quest_desc: [
		"&oThe Blobbian is unique among organic life-forms, exhibiting no genetic variation between individuals... the only confirmed species is Blobbius Caelus, the Sky Blobbian..."
		"&o...lacking any sort of nervous system, all analysis shows no physical activity resembling thought. Yet Blobbius Caelus readily communicates, forms plans, and even makes specialized tools to navigate its environment..."
		"&o...have argued an extraphysical location for thought processing, or that Blobbius is part of a larger organism...&r"
		""
		"&8&o- Encyclopedia Daemonica&r"
	]
	quest.034B6B71E610D8E1.title: "Blobbius Caelus"
	quest.03B7909623F97843.quest_desc: [
		"The paint-ball overcorrection left with AE2."
		"Magenta dye still passes this spot, and the line goes on to chromatic compound without the paint."
	]
	quest.03B7909623F97843.title: "Overcorrection (removed)"
	quest.047FD4E54147D8F7.quest_desc: [
		"A Zinc Machine is the block the electrical parts of this age are cut from."
		"Connectors, the tesla coil, and the portable energy interface come off it."
	]
	quest.047FD4E54147D8F7.quest_subtitle: "The electrical gate"
	quest.047FD4E54147D8F7.title: "Zinc Machine"

	quest.A710000000000003.quest_desc: ["Sturdier canopy for longer glides between islands."]
	quest.A710000000000004.quest_desc: ["Immersive Aircraft propulsion."]
	quest.A710000000000005.quest_desc: ["First powered personal aircraft."]

	quest.2C81D358594C4352.quest_desc: ["The Crushing Wheel anomaly needed AE2. Instead, Refined Storage's Quartz Enriched Iron (iron and Nether Quartz) anchors the colour in the Chromatic Singularity mix."]
	quest.2C81D358594C4352.quest_subtitle: "{cabin.quest.2C81D358594C4352.subtitle}"

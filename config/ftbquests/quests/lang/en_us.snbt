	quest.05446225038D260A.title: "Hot Cocoa"
	quest.05C7E580ED88B556.quest_desc: [
		"End stone is the ground chorus grows from."
		"It sits after the inductive mechanism and leads to the chorus flower."
	]
	quest.05C7E580ED88B556.title: "End Stone"
	quest.067C5FDA4709F195.quest_desc: [
		"Refined Storage silicon is heated out of silicon compound."
		"A saw cut of it makes six wafers, and it also feeds processor binding and the lithography spirit."

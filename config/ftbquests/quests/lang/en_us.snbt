	quest.6509024553997AB0.quest_subtitle: "{cabin.quest.6509024553997AB0.subtitle}"
	quest.6509024553997AB0.title: "{cabin.quest.6509024553997AB0.title}"
	quest.6545C3F427B12106.quest_desc: [
		"The sealed mechanism is a kinetic mechanism closed up with rubber."
		"The Copper Machine is the fluid gate cut from it."
	]
	quest.6545C3F427B12106.title: "Sealed Mechanism"
	quest.661807F8ED723EEB.quest_desc: [
		"{cabin.quest.661807F8ED723EEB.description1}"
		""
		"{cabin.quest.661807F8ED723EEB.description2}"
	]
	quest.667F4F686A45EF3E.quest_desc: [
		"A Gold Machine is railway casing around a reinforced mechanism."
		"Train controls, stations, signals, and schedules are cut from it."
	]
	quest.667F4F686A45EF3E.quest_subtitle: "Railway casing around a reinforced mechanism"
	quest.667F4F686A45EF3E.title: "Gold Machine"
	quest.675C395B2074C24C.quest_desc: [
		"A kinetic mechanism is a hammer, a cogwheel, andesite alloy, and a stripped log, crafted by hand."
		"A sequenced assembly can make one later, once a deployer exists. The Andesite Machine is not cut from it."
	]
	quest.675C395B2074C24C.quest_subtitle: "Hammer, cog, alloy, log"
	quest.675C395B2074C24C.title: "Kinetic Mechanism"
	quest.6824055533465010.quest_desc: [
		"The calculation mechanism is the processor-age mechanism, sequenced with the flash drive."
		"The controller is fluix casings around it."
	]
	quest.6824055533465010.quest_subtitle: "{cabin.quest.6824055533465010.subtitle}"
	quest.6824055533465010.title: "Calculation Mechanism"
	quest.6892AE55581393C6.quest_desc: [
		"Deepslate is the dark stone under the workshop."
		"A railway casing is a golden sheet on deepslate, and obsidian is the stone after it."
	]
	quest.6892AE55581393C6.quest_subtitle: "The dark stone under the workshop"
	quest.6892AE55581393C6.title: "Deepslate"
	quest.68A8C2CB135ECA87.quest_desc: [
		"Steel starts from crushed raw iron, and a crushing wheel is what makes that dust. The wheel is mechanical crafting, so it waits on the crafter a brass machine cuts."
		"A heated mixer turns the crushed iron into ingots, and a superheated mixer turns those ingots into steel."
	]
	quest.68A8C2CB135ECA87.quest_subtitle: "Contraption 20-1"
	quest.68A8C2CB135ECA87.title: "A Source of Steel"
	quest.68DF462185A9AF63.quest_desc: [
		"This overview node tracks the lead-machine chapter milestone, once a logistic mechanism exists."
	]
	quest.68DF462185A9AF63.quest_subtitle: "{cabin.quest.11C36A243F5108DC.subtitle}"
	quest.68DF462185A9AF63.title: "{cabin.quest.68DF462185A9AF63.title}"
	quest.69275ECFC147E15B.quest_desc: [
		"This overview node tracks the brass chapter milestone, once a precision mechanism exists."
	]
	quest.69275ECFC147E15B.quest_subtitle: "{cabin.quest.08716DBF9C882623.subtitle}"
	quest.69275ECFC147E15B.title: "{cabin.quest.69275ECFC147E15B.title}"
	quest.69311E02A8B3451D.quest_desc: [
		"The computation matrix is the thinking machine."
		"It wants every digit from zero through nine, and the rocket will not count without it."
	]
	quest.69311E02A8B3451D.quest_subtitle: "{cabin.quest.69311E02A8B3451D.subtitle}"
	quest.69311E02A8B3451D.title: "Computation Matrix"

		"{cabin.quest.69D55492A8F42A94.description3}"
	]
	quest.69D55492A8F42A94.title: "What Is In This Book"
	quest.69FDD93C8097E0FB.quest_desc: [
		"The CAD might not run on gunpowder, but it probably counts as a gun, too."
		"It could be a useful alternative for traversing the islands - if you can figure out how to program it with the right spells."
	]
	quest.69FDD93C8097E0FB.title: "The Other Gun"
	quest.6A156D11D983661D.quest_desc: [
		"Matter plastics are the solid the space suit, the oxygen distributor, the launch pad, and the rocket are cut from."
		"Paraffin and blaze cake are what this chapter puts in front of them."
	]
	quest.6A156D11D983661D.title: "Matter Plastics"
	quest.6A76E65324F0ACC0.quest_desc: [
		"Green dye is the middle of the five."
		"The singularity mix wants it with the red, the yellow, the blue, and the magenta."
	]
	quest.6A76E65324F0ACC0.title: "Green Dye"

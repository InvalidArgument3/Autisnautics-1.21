	quest.0BE1DA955F49FBD6.quest_desc: ["Rats may have a lot of talents, but flying isn't one of them. At least, not yet. There's only one way to get started down the path to rat-powered flight. Time to punch trees."]
	quest.0BE1DA955F49FBD6.title: "Gnawing Logs"

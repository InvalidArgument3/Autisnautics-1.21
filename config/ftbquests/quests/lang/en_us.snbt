	quest.0AF5F19F5D9FB5C9.quest_desc: [
		"Sand at the start of the brass age is the pile in front of nether quartz."
		"Rose quartz is quartz and redstone, and this sand only opens that gather."
	]
	quest.0AF5F19F5D9FB5C9.title: "Sand"
	quest.0B602ED47A0195A4.quest_desc: [
		"Basalt is the nether rock this chapter gathers."

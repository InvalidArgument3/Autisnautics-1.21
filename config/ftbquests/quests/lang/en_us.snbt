	quest.128900FD54A81038.quest_desc: ["Lesser races might try and navigate this broken landscape with gliders and boats, but the Cactoids know better. There's no problem that can't be solved by shooting at it. The first step to building your problem-solvers will be forging some iron."]
	quest.128900FD54A81038.title: "Big Iron"
	quest.12DC1012CBEBB6F0.quest_desc: ["adds Power III to flinging sword so it's not useless"]
	quest.12DC1012CBEBB6F0.title: "flingingsword_power"

	quest.13C43EFB6ED15325.quest_desc: ["its a nice stick and all but it doesnt wanna help bolbi go up. i probly gotta grow up some more and get stronnger to make a better stick. even if its not that tasty i bet eating stick flavered vegtibles is gonna help."]
	quest.13C43EFB6ED15325.title: "stick Vegtables"
	quest.1401C9EEAD31C31E.title: "You Snail!"
	quest.14A12AAB5FD3F6C1.quest_desc: [
		"Legends speak of a mysterious cursed artifact. It is said to repulse its owner from the ground, because the very land itself rejects them. To keep its corrupting influence away from mortals, it was sealed away in a prison beyond the heavens long ago."
		""
		"But you don't have to follow the rules. With a sword, you can go anywhere you want. Ascend beyond the highest heights, and grasp your first taste of forbidden power."
	]
	quest.14A12AAB5FD3F6C1.title: "Pierce the Heavens"
	quest.14FA93A81C14879D.title: "Chaos Emeralds"
	quest.15368864A6946A93.quest_desc: [
		"Glow Lichen + Awkward Potion = Potion of Glowing."
		""
		"Don't forget potions can be mass-brewed as fluids, by heated mixing in a Basin. You'll need a Blaze Burner for that option."
	]
	quest.15368864A6946A93.quest_subtitle: "Contraption 19-3"
	quest.15368864A6946A93.title: "Bright Brew"
	quest.155B2476219F8F57.title: "Learn to Code"
	quest.15978ED5A6E3DFFE.quest_desc: [
		"Start with a Precision Mechanism. Cast it a new base with Molten Steel, delicately apply Molten Uranium, pour Molten Lead for shielding, and infuse the whole thing with Radaway. Welcome to the Atomic age."
		""
		"{cabin.quest.3C50B4556375178E.description2}"
		"{cabin.quest.3C50B4556375178E.description3}"
	]

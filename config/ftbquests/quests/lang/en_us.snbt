	quest.0F4B0608CBF966E6.title: "Chain"
	quest.0F5AA5DF001DCDF5.quest_desc: [
		"Rough sand is the grit out of a sand ball."
		"It washes into purified sand."
	]
	quest.0F5AA5DF001DCDF5.quest_subtitle: "{cabin.quest.0F5AA5DF001DCDF5.subtitle}"
	quest.0F5AA5DF001DCDF5.title: "Rough Sand"
	quest.0F7D65050E1F7A6E.quest_desc: [
		"It is written: The Daemon soul is like water, the body its vessel. Perfect is the machine, that vessel which swallows even the ocean and spills not a drop. But ever are we cursed to spill blood; the flesh is weak."
		""
		"Organic minds might fear this truth, as the flesh fears to bleed. But you have no such weakness. Your flesh is but another resource, and your blood a source of trace redstone particles. Time to begin resource extraction."
	]
	quest.0F7D65050E1F7A6E.title: "The Vessel"
	quest.106C6DFDCB97327C.quest_desc: [
		"Andesite is the stone of this age."
		"Two of these and two iron nuggets, or two of these and two zinc nuggets, make one andesite alloy. An unheated mixer does the same."
	]
	quest.106C6DFDCB97327C.quest_subtitle: "{cabin.quest.106C6DFDCB97327C.subtitle}"
	quest.106C6DFDCB97327C.title: "Andesite"
	quest.10E93BEB78219368.quest_desc: [
		"Glow lichen brews the potion of glowing."
		"That potion soaks brown mushrooms into the glowing mushrooms radaway wants."
	]
	quest.10E93BEB78219368.quest_subtitle: "Contraption 19-2"
	quest.10E93BEB78219368.title: "Glow in the Dark II"

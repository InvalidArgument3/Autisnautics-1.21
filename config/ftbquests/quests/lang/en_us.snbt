	quest.3A63A48662F352CB.quest_desc: [
		"Light engineering is the block that opens Immersive Engineering's multiblocks."
		"The arc furnace, the excavator, and the diesel generator wait on it."
	]
	quest.3A63A48662F352CB.quest_subtitle: "The Immersive Engineering gate"
	quest.3A63A48662F352CB.title: "Light Engineering"
	quest.3A81BC460AF1756D.quest_subtitle: "{cabin.quest.21E76761CD3761C2.subtitle}"
	quest.3A81BC460AF1756D.title: "{cabin.quest.3A81BC460AF1756D.title}"
	quest.3AD7553F3C8593F9.quest_desc: [
		"The oxygen distributor keeps a room breathable off the pad."
		"It is built from matter plastics, and the launch marker wants it."
	]
	quest.3AD7553F3C8593F9.quest_subtitle: "{cabin.quest.3AD7553F3C8593F9.subtitle}"
	quest.3ADD69413C0798FE.quest_desc: ["i heard theres these weird eyeball thingies scattered all over the world. and if i catch 'em all and put them in the weird blinky jars i win a free trip to somewhere blobbins never been before! its gonna be the best souvenir collection ever!!!"]
	quest.3ADD69413C0798FE.title: "Blobbo's big Adventure"
	quest.3B421C8F7947E542.quest_desc: [
		"Red dye is the first of the five dyes that feed chromatic compound."
		"It is in the heated singularity mix with the quartz enriched iron."
	]
	quest.3B421C8F7947E542.title: "Red Dye"
	quest.3B431AAADE8845FA.quest_desc: [
		"Another mark for accelerator redstone."
		"It passes the ComputerCraft computer on, once the laser has been sped up."
	]
	quest.3B431AAADE8845FA.title: "Accellerator Redstone"
	quest.3B448BBF4352E4AB.quest_desc: ["The Casting Assistant Device is a versatile tool. Organic minds struggle to comprehend it, but when programmed correctly, it commands countless powers. Even the power to soar between the floating isles. Start with a CAD Assembly, a Core, and a Socket. Then combine them in a CAD Assembler to produce the blessed technology."]
	quest.3B448BBF4352E4AB.title: "Let's Build A Gun"
	quest.3B86BE3E3211A392.title: "A Balanced Jetpack?"
	quest.3B930AA32F92246B.quest_desc: [
		"A Lead Machine is a lead casing around a logistic mechanism."
		"Packagers, frogports, and the stock link are cut from it."
	]
	quest.3B930AA32F92246B.quest_subtitle: "Lead casing around a logistic mechanism"
	quest.3B930AA32F92246B.title: "Lead Machine"
	quest.3BE15AA5C237AB80.quest_desc: [
		"Magenta dye is the last of the five."
		"It closes the singularity mix, and chromatic compound is what that mix becomes."
	]
	quest.3BE15AA5C237AB80.quest_subtitle: "{cabin.quest.3BE15AA5C237AB80.subtitle}"
	quest.3BE15AA5C237AB80.title: "Magenta Dye"
	quest.3BFC4DFCE765F3EA.quest_desc: [
		"These ender pearls are the enderium branch, after the inductive mechanism."
		"They lead to the electrum ingot in front of the abstruse mechanism."
	]
	quest.3BFC4DFCE765F3EA.title: "Ender Pearls"
	quest.3C50B4556375178E.quest_desc: [
		"The infernal mechanism is a precision mechanism filled with lava and the plasma from the nether vines."
		"The Zinc Machine is the gate cut from it."
	]
	quest.3C50B4556375178E.quest_subtitle: "{cabin.quest.3C50B4556375178E.subtitle}"
	quest.3C50B4556375178E.title: "Infernal Mechanism"
	quest.3CBED6B591BCEDEA.quest_desc: [
		"Paraffin is the wax from the oil work."
		"With blaze cake it feeds matter plastics."
	]
	quest.3CBED6B591BCEDEA.quest_subtitle: "{cabin.quest.3CBED6B591BCEDEA.subtitle}"
	quest.3CBED6B591BCEDEA.title: "Paraffin Wax"
	quest.3D1EEB596FDBE4E7.quest_desc: [
		"Another slime ball for that same branch."
		"Gunpowder, ender pearls, and bone meal all split from here."
	]
	quest.3D1EEB596FDBE4E7.quest_subtitle: "{cabin.quest.3D1EEB596FDBE4E7.subtitle}"
	quest.3D1EEB596FDBE4E7.title: "Slime Ball"
	quest.3E391D4870926B8F.quest_desc: ["As a rat, your tough teeth let you mine stone without any tools. That should be useful for crafting a stone chisel, which you could use to carve pint-sized details."]
	quest.3E391D4870926B8F.title: "Hidey Hole"
	quest.3EB5CD9776DF0E63.quest_desc: [
		"Another scoria reagent for the netherrack row, after the opening jars of stone, granite, and scoria."
	]
	quest.3EEF098FB1D343AD.quest_desc: ["{image: width:100 height:100 align:center}"]
	quest.3EF5F89DBD6959E3.quest_desc: [
		"Rubber is cooked raw rubber."
		"Two rubber seal a kinetic mechanism. Belts are dried kelp."
	]
	quest.3EF5F89DBD6959E3.quest_subtitle: "Furnace or blast furnace"
	quest.3EF5F89DBD6959E3.title: "Rubber"
	quest.3F45DFEF31838A00.quest_desc: [
		"The Andesite Machine is the block the early contraptions are cut from."
		"The press, the mixer, the saw, and the drill are applications of this machine. The deployer is not. It waits on an electron tube."
	]
	quest.3F45DFEF31838A00.title: "Andesite Machine"
	quest.400CDC316DCDFE88.quest_desc: [
		"This overview node tracks the inductive chapter milestone, once an inductive mechanism exists."
	]
	quest.400CDC316DCDFE88.quest_subtitle: "{cabin.quest.08716DBF9C882623.subtitle}"
	quest.400CDC316DCDFE88.title: "{cabin.quest.400CDC316DCDFE88.title}"
	quest.402F89CABF6BCDA4.quest_desc: [
		"Bone meal on the old reactor branch, after the slime."
		"It leads to the sand the singularity mix stands on."
	]
	quest.402F89CABF6BCDA4.quest_subtitle: "{cabin.quest.402F89CABF6BCDA4.subtitle}"
	quest.402F89CABF6BCDA4.title: "Bone Meal"
	quest.4064D448404CD639.quest_desc: [
		"Obsidian is the dark glass after magma."
		"The hand craft sets a kinetic mechanism between two obsidian. A deployer and a press can sequence one later."
	]
	quest.4064D448404CD639.quest_subtitle: "{cabin.quest.4064D448404CD639.subtitle}"
	quest.4064D448404CD639.title: "Obsidian"
	quest.407236D2B1D2257D.quest_desc: [
		"{cabin.quest.407236D2B1D2257D.description1}"

		"{cabin.quest.407236D2B1D2257D.description2}"

		"{cabin.quest.407236D2B1D2257D.description3}"
	]
	quest.407236D2B1D2257D.title: "Create and the Tech Mods"
	quest.40923F4758A50D9C.quest_desc: [
		"Among the fleshminds, it is said that advanced technology is indistinguishable from magic. Daemonkind knows better: technology is the source of magic."
		""
		"Take to the Spell Programmer, and weave arcane alogrithms beyond organic understanding. Do this well, and you will far surpass the meat-brains' pitiful gliders and ropes. Fail, and fall into despair. That is the way of the Daemon."
	]
	quest.40923F4758A50D9C.title: "Sufficiently Advanced Technology"
	quest.409A50CBCDBBA1F0.quest_subtitle: "{cabin.quest.409A50CBCDBBA1F0.subtitle}"
	quest.409A50CBCDBBA1F0.title: "{cabin.quest.409A50CBCDBBA1F0.title}"
	quest.40C30DFD4DDBEE6C.title: "its a tree :)"
	quest.40D663C4D421DBAA.title: "Brew Potion"
	quest.410FF28B63E0FC0C.quest_desc: [
		"A radiant sheet is pressed refined radiance."
		"It is wound into the radiant coil."
	]
	quest.410FF28B63E0FC0C.quest_subtitle: "{cabin.quest.410FF28B63E0FC0C.subtitle}"
	quest.410FF28B63E0FC0C.title: "Radiant Sheet"
	quest.42B5C0102B22F389.quest_desc: [
		"One is a computation-matrix digit, after three, eight, and plus."
		"The matrix will not think without it."
	]
	quest.42B5C0102B22F389.quest_subtitle: "{cabin.quest.42B5C0102B22F389.subtitle}"
	quest.42B615F7BECA6E58.quest_desc: [
		"The bottling machine is the Immersive Engineering machine that fills the wider family of these jars."
		"Graphite electrodes and bottled fluids come off that same machine."
	]
	quest.42B615F7BECA6E58.title: "Bottling Machine"
	quest.42F1A649D86DB86D.quest_desc: [
		"A sand ball is sand balled up for the silicon line."
		"Rough sand comes out of it."
	]
	quest.42F1A649D86DB86D.quest_subtitle: "{cabin.quest.42F1A649D86DB86D.subtitle}"
	quest.42F1A649D86DB86D.title: "Sand Ball"
	quest.435BE0485FB92245.title: "its a tree :)"
	quest.4412F3B2827606E4.quest_desc: [
		"Rough sand is sand worked toward silicon."
		"It still has to be purified before it becomes silicon compound."
	]
	quest.4412F3B2827606E4.quest_subtitle: "Sand on the way to silicon"
	quest.4412F3B2827606E4.title: "Rough Sand"
	quest.44540B11F341AE09.quest_desc: [
		"A logistic mechanism is the sequenced part after a precision mechanism."
		"A Lead Machine is a lead casing around it."
	]
	quest.44540B11F341AE09.quest_subtitle: "{cabin.quest.44540B11F341AE09.subtitle}"
	quest.44540B11F341AE09.title: "Logistic Mechanism"
	quest.451CB26EBDE58A25.quest_desc: [
		"Though Daemonkind's history logs rapidly outgrew available storage space long ago, the first few terabytes are universal knowledge. They describe the Daemon's ancient home: mechanical fortresses built by their unknown masters, made to guard the upper void beyond this world. "
		""
		"Daemons have long tried and failed to regain the digital forms they once used to administrate these platforms. But if you were to build one of these stations yourself, despite your mortal body... you would prove that Daemonkind has transcended the curse of flesh for all time."
	]
	quest.451CB26EBDE58A25.title: "The Upper Void"
	quest.45E7810E21F6F9AE.quest_desc: ["{cabin.quest.45E7810E21F6F9AE.description1}"]
	quest.46820FBDDDEE491E.quest_desc: [
		"A log here is cooked into charcoal."
		"Charcoal is the start of the coke the silicon compound wants."
	]
	quest.46820FBDDDEE491E.quest_subtitle: "{cabin.quest.46820FBDDDEE491E.subtitle}"
	quest.46820FBDDDEE491E.title: "Log"
	quest.46BF1AE437F27403.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.46BF1AE437F27403.title: "Lead Casing"
quest.46BF1AE437F27403.quest_desc: [
		"A lead casing is the shell a logistic mechanism wears."
		"Packagers, frogports, and the stock link are built in that shell."
	]
	quest.472FB03D0E5A38D6.quest_desc: [
		"A stockpile switch watches an inventory and emits a redstone signal."
		"In this pack it stands in for a redstone link, and it is cut using its standard mod recipe (check EMI)."
	]
	quest.472FB03D0E5A38D6.quest_subtitle: "The brass stand-in for a redstone link"
	quest.472FB03D0E5A38D6.title: "Stockpile Switch"
	quest.4761DAE59CDD93AF.quest_desc: [
		"Crude oil is the black fluid a pumpjack lifts."
		"Rocket fuel and the diesel engines both start from it."
	]
	quest.4761DAE59CDD93AF.quest_subtitle: "What the pumpjack lifts"
	quest.4761DAE59CDD93AF.title: "Crude Oil Bucket"
	quest.47965C310D9847DC.quest_desc: [
		"A blaze cake is the dense fuel a blaze burner eats."
		"The brass age already burned this cake to melt iron into the electron tube. Here it is the heat the late workshop runs on."
	]
	quest.47965C310D9847DC.quest_subtitle: "Dense fuel for a blaze burner"
	quest.47965C310D9847DC.title: "Blaze Cake"
	quest.47DB705903F26597.quest_desc: ["Even though I barfed em up and there all slimey now, after eatign those vegtables i feel a lot more smarter.  its time to settle down and become civilized bolbbin. Theres this new thing called angriculture and were gonna do it RIGHT NOW."]
	quest.47DB705903F26597.title: "its a tree ;)))"
	quest.4800892E1E70648D.quest_desc: [
		"The launch pad is the slab the rocket leaves from."
		"Matter plastics build it, and the rocket will not count without it."
	]
	quest.4800892E1E70648D.quest_subtitle: "{cabin.quest.4800892E1E70648D.subtitle}"
	quest.4815DA7B77DD7175.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.4815DA7B77DD7175.title: "Lead Casing"
quest.4815DA7B77DD7175.quest_desc: [
		"A lead casing is the shell a logistic mechanism wears."
		"Packagers, frogports, and the stock link are built in that shell."
	]
	quest.4986F69A73BB122E.quest_desc: ["the slimey dirt isnt that tasty but thats probly cuz it's still dirt. we gotta BLAST the dirt so its not dirt anymore. then itll be better to eat. Except dont eat it. Im not gonna eat it. its for the new stick."]
	quest.4986F69A73BB122E.title: "Extra crunnchy"
	quest.4A16CE3BC111280F.quest_desc: [
		"Seven is a computation-matrix digit."
		"The matrix is not finished while seven is missing."
	]
	quest.4A16CE3BC111280F.quest_subtitle: "{cabin.quest.4A16CE3BC111280F.subtitle}"
	quest.4A5F78CCBAA649D0.quest_desc: ["remove the daemon's physical debuffs"]
	quest.4A5F78CCBAA649D0.title: "transcendence_reward"
	quest.4B1017D1C176412F.quest_desc: ["{cabin.quest.4B1017D1C176412F.description1}"]
	quest.4B19B6EAD511378D.quest_desc: [
		"This is the second ask for Refined Storage silicon, after that ComputerCraft computer."
		"It meets the first silicon at processor binding."
	]
	quest.4B19B6EAD511378D.quest_subtitle: "{cabin.quest.4B19B6EAD511378D.subtitle}"
	quest.4B19B6EAD511378D.title: "Silicon"
	quest.4B80A801A5BE4A01.quest_desc: [
		"Builders tea is the drink that opens the processor age."
		"Sand, basalt, a log, and the ComputerCraft computer sit behind this cup."
	]
	quest.4B80A801A5BE4A01.title: "Builders Tea"
	quest.4B891E9ED8DE6BB2.quest_desc: [
		"Glow berries brew the haste potion in front of the logistic mechanism."
		"The potion of glowing, later, is a different brew."
	]
	quest.4B891E9ED8DE6BB2.quest_subtitle: "{cabin.quest.4B891E9ED8DE6BB2.subtitle}"
	quest.4B891E9ED8DE6BB2.title: "Glow Berries"
	quest.4CC420A6B673176A.quest_desc: [
		"Sand in the andesite age is the gather in front of clay."
		"Clay, sand, and dried kelp cook into algal blend for masonry. The alloy does not use it."
	]
	quest.4CC420A6B673176A.quest_subtitle: "{cabin.quest.4CC420A6B673176A.subtitle}"
	quest.4CC420A6B673176A.title: "Sand"
	quest.4D7C2B2653C1982A.quest_desc: [
		"The Accursed Ones bear a heavy burden, but by adventuring and killing stuff, you can make unique exclusive items that patch up your weaknesses and make you even stronger than a baseline autist."
		""
		"Search JEI for \"@enigmaticlegacyplus\" to see all the exclusive items only hardcore gamers like you get to use."
	]
	quest.4D7C2B2653C1982A.quest_subtitle: "And That's A Good Thing!"
	quest.4D7C2B2653C1982A.title: "So You're Eternally Damned"
	quest.4D8972AE5B614FB3.quest_desc: [
		"Magma is blasted deepslate."
		"Obsidian is the next stone, and the reinforced mechanism is pressed from that."
	]
	quest.4D8972AE5B614FB3.quest_subtitle: "{cabin.quest.4D8972AE5B614FB3.subtitle}"
	quest.4D8972AE5B614FB3.title: "Magma Block"
	quest.4E85C8A2EEEB57C3.quest_desc: [
		"Plus, minus, multiply, and divide are the signs the computation matrix uses with the digits."
		"The matrix calculates with both."
	]
	quest.4E85C8A2EEEB57C3.quest_subtitle: "{cabin.quest.4E85C8A2EEEB57C3.subtitle}"
	quest.4E85C8A2EEEB57C3.title: "Operators"
	quest.4EDD9A8F14E48EAE.quest_desc: [
		"An Enderium Machine is an ender casing around an abstruse mechanism."
		"The ender-age machines are cut from it."
	]
	quest.4EDD9A8F14E48EAE.quest_subtitle: "Ender casing around an abstruse mechanism"
	quest.4EDD9A8F14E48EAE.title: "Enderium Machine"
	quest.4F7A70041B67A348.title: "Moon Stone"
	quest.4F95D5136E944ADB.quest_desc: [
		"The skystone infini-mill left with AE2."
		"The brass age goes on toward rose quartz without milling sky stone."
	]
	quest.4F95D5136E944ADB.quest_subtitle: "{cabin.quest.4F95D5136E944ADB.subtitle}"
	quest.4F95D5136E944ADB.title: "Skystone Infini-mill (removed)"
	quest.4FFA0F65FA89D867.quest_desc: [
		"Nether wart again, this time for the potion of glowing."
		"It is not the wart that fed the logistic brew."
	]
	quest.4FFA0F65FA89D867.quest_subtitle: "Contraption 19-1"
	quest.4FFA0F65FA89D867.title: "Glow in the Dark I"
	quest.5004B1CBC8BA874D.title: "its a tree :)"
	quest.50766CC48FB21D85.quest_desc: [
		"A long time ago the blobis lived in the dark place. blobos was bored cus its too crowded and pointy and theres no up and down. then the dirt got bored too and went way up. blobbi learned about up and became sky bolb B))"
		""
		"i also heard theres something called down that really hurts, but it doesn hurt blobbers. But blobbims still need stuff to go up. theres lots of up stuff but im gonna make a stick :D"
	]
	quest.50766CC48FB21D85.title: "sky blobbin B)"
	quest.50E2D6459F3D68C0.quest_desc: ["{cabin.quest.50E2D6459F3D68C0.description1}"]
	quest.50E2D6459F3D68C0.title: "Barrel"
	quest.5181318DC4AAD768.quest_desc: [
		"The Cactoid histories have always recorded that their origins lie beyond this world. Traditional myths state that beings from the moon once created the Cactoids, long ago. But when the land rose from the sea, they suddenly disappeared. Lacking any other concrete information about these hypothetical beings, historians dub them \"Lunarians\"."
		""
		"If you could somehow make it to the moon, you could solve the mystery of the Cactoids once and for all. And if the Lunarians really do exist, you could send them a clear message... that their creations have surpassed them."
	]
	quest.5181318DC4AAD768.quest_subtitle: " If I met my creator, I'd punch him in the face"
	quest.5181318DC4AAD768.title: "The Makers"
	quest.5200AD3B32D219C6.quest_desc: [
		"Another emerald reagent for the granite row, after the plain diamond and the lapis jars."
	]
	quest.522065CE0A5CE9D2.quest_desc: [
		"{cabin.quest.522065CE0A5CE9D2.description1}"
		""
		"{cabin.quest.522065CE0A5CE9D2.description2}"
		""
		"{cabin.quest.522065CE0A5CE9D2.description3}"
	]
	quest.522065CE0A5CE9D2.title: "{cabin.quest.522065CE0A5CE9D2.title}"
	quest.532EFE32C3A515B5.quest_desc: [
		"Planks are a log, split."
		"The slab the kinetic line wants is cut from them."
	]
	quest.532EFE32C3A515B5.quest_subtitle: "{cabin.quest.532EFE32C3A515B5.subtitle}"
	quest.532EFE32C3A515B5.title: "Planks"
	quest.5351AF6CA73CB8E0.quest_desc: [
		"An electron tube is 10 mB of molten iron spouted onto polished rose quartz."
		"Two tubes are deployed onto a kinetic mechanism, then wire cutters, to make a precision mechanism."
	]
	quest.5351AF6CA73CB8E0.quest_subtitle: "{cabin.quest.5351AF6CA73CB8E0.subtitle}"
	quest.5351AF6CA73CB8E0.title: "Electron Tube"
	quest.5358E5F7FB59DD60.quest_desc: [
		"Two is a computation-matrix digit on that same wait."
		"It feeds the thinking machine."
	]
	quest.5358E5F7FB59DD60.quest_subtitle: "{cabin.quest.5358E5F7FB59DD60.subtitle}"
	quest.5378EDF26A6861D0.quest_desc: [
		"This is an invisible chapter used to assign origin quests."
		"You shouldn't be seeing this unless you're in edit mode."
	]
	quest.549D7F67A97CD2CE.quest_desc: [
		"Another quartz reagent for the granite row, after the plain quartz and the amethyst."
	]
	quest.5550A3E383EFEC90.quest_desc: [
		"Three is a computation-matrix digit, one of the two that raw logic makes first."
		"The other digits and the thinking machine wait on it."
	]
	quest.5550A3E383EFEC90.quest_subtitle: "{cabin.quest.5550A3E383EFEC90.subtitle}"
	quest.55F959A18E904D6C.quest_desc: [
		"Four is a computation-matrix digit."
		"It is the digit the matrix reads, after the early pair and the plus sign."
	]
	quest.55F959A18E904D6C.quest_subtitle: "{cabin.quest.55F959A18E904D6C.subtitle}"
	quest.566E72AE7D580917.quest_desc: [
		"The silver reagent is the other jar outside the seven rows."
		"Chaos pairing can make it too, and an extractor pulls the silver dust back out."
	]
	quest.5799B4124EE20DB1.quest_desc: [
		"Blaze powder is a blaze rod, ground."
		"It packs into the fire charge that purified sand waits on."
	]
	quest.5799B4124EE20DB1.quest_subtitle: "{cabin.quest.5799B4124EE20DB1.subtitle}"
	quest.5799B4124EE20DB1.title: "Blaze Powder"
	quest.5799D55BB26BA52C.quest_desc: [
		"Builders tea is the drink that opens the andesite age."
		"Logs, kelp, sand, andesite, and the deepslate mark all sit behind the cup."
	]
	quest.5799D55BB26BA52C.title: "Builders Tea"
	quest.58B534C4AEB4139D.quest_desc: [
		"A lodestone is the compass stone off basalt."
		"The processor line does not use it further."
	]
	quest.58B534C4AEB4139D.quest_subtitle: "{cabin.quest.58B534C4AEB4139D.subtitle}"
	quest.58B534C4AEB4139D.title: "Lodestone"
	quest.58CD5739BCB8A790.title: "Ether Metal"
	quest.58E38BA6D927409F.quest_desc: [
		"{cabin.quest.58E38BA6D927409F.description1}"

		"{cabin.quest.58E38BA6D927409F.description2}"

		"{cabin.quest.58E38BA6D927409F.description3}"

		"{cabin.quest.58E38BA6D927409F.description4}"
	]
	quest.58E38BA6D927409F.title: "Multiplayer"
	quest.5943F8F91AA79D59.quest_desc: [
		"Uranium is the metal the enrichment line is built around."
		"With radaway and crushed iron, it asks for a logistic mechanism."
	]
	quest.5943F8F91AA79D59.title: "Lost Technology"
	quest.59D2104DB6AE93FD.quest_desc: [
		"The chromatic resonator is the piece that finishes the inductive sequence after the coils."
		"The inductive mechanism is the power-age mechanism those two make."
	]
	quest.59D2104DB6AE93FD.title: "Chromatic Resonator"
	quest.59E4A6163753BC12.quest_desc: [
		"A stripped log is a log with the bark taken off."
		"The kinetic mechanism and the diesel hammer both wait on it, beside the alloy."
	]
	quest.59E4A6163753BC12.quest_subtitle: "{cabin.quest.59E4A6163753BC12.subtitle}"
	quest.59E4A6163753BC12.title: "Stripped Log"
	quest.5A055D0421861318.quest_desc: [
		"The diesel hammer is the hammer of the andesite age."
		"It is the last hit that finishes a kinetic mechanism."
	]
	quest.5A055D0421861318.title: "Engineer's Hammer"
	quest.5A199B898D41A309.quest_desc: [
		"The reactor left with AE2."
		"Quartz enriched iron, TNT, and ender pearls still meet this spot, and the line goes on to the chromatic singularity without it."
	]
	quest.5A199B898D41A309.quest_subtitle: "{cabin.quest.5A199B898D41A309.subtitle}"
	quest.5A199B898D41A309.title: "The Reactor (removed)"
	quest.5A64DBCFBF78856B.quest_desc: ["adds Power III to flinging staff so it's not useless"]
	quest.5A64DBCFBF78856B.title: "flingingstaff_power"
	quest.5A6926E64EEE7729.quest_subtitle: "Standard mod recipe (check EMI)"
	quest.5A6926E64EEE7729.title: "Lead Casing"
quest.5A6926E64EEE7729.quest_desc: [
		"A lead casing is the shell a logistic mechanism wears."
		"Packagers, frogports, and the stock link are built in that shell."
	]
	quest.5B0727505DC791DF.quest_desc: [
		"A grass block is the return-home marker after you have been off the world."
		"Earth orbit, the moon, or any of the other orbits can send you back to it."
	]
	quest.5B0727505DC791DF.quest_subtitle: "{cabin.quest.5B0727505DC791DF.subtitle}"
	quest.5B0727505DC791DF.title: "Grass Block"
	quest.5BDF2960FBF3C35D.title: "fwoosh"
	quest.5C4F6E63B02A25F0.quest_desc: [
		"Deepslate is the dark stone under this age."
		"It blasts into magma on the way to obsidian."
	]
	quest.5C4F6E63B02A25F0.quest_subtitle: "{cabin.quest.5C4F6E63B02A25F0.subtitle}"
	quest.5C4F6E63B02A25F0.title: "Deepslate"
	quest.5D0454F977C4F080.quest_desc: [
		"Builders tea is the drink that opens the rocket age."
		"Raw logic, paraffin, crude oil, and blaze cake start from this cup."
	]
	quest.5D0454F977C4F080.title: "Builders Tea"
	quest.5DCF9C8212AA3BE3.quest_desc: [
		"The blaze burner is the heat of the brass age."
		"Soul sand on the infernal branch, and radaway later, both sit behind this one."
	]
	quest.5DCF9C8212AA3BE3.title: "Blaze Burner"
	quest.5E62059675895213.quest_desc: [
		"This crafting blueprint is the computation matrix, the gate between calculation and taking flight."
	]
	quest.5E62059675895213.quest_subtitle: "{cabin.quest.5E62059675895213.subtitle}"
	quest.5E62059675895213.title: "Crafting Blueprint"
	quest.5F6999F8DAEC2A03.title: "its dirt :)"
	quest.5F9BA7BA46D2E5B8.quest_desc: [
		"This sand is the pile that packs into TNT, on the branch the reactor used to own."
		"The reactor left with AE2, and the line goes on without it."
	]
	quest.5F9BA7BA46D2E5B8.quest_subtitle: "{cabin.quest.5F9BA7BA46D2E5B8.subtitle}"
	quest.5F9BA7BA46D2E5B8.title: "Sand"
	quest.5FCCD2F720115D41.quest_subtitle: "{cabin.quest.5FCCD2F720115D41.subtitle}"
	quest.5FCCD2F720115D41.title: "{cabin.quest.5FCCD2F720115D41.title}"
	quest.608BF7BE3CB666F3.quest_desc: [
		"Kelp is the sea plant in algal blend."
		"Seagrass can stand in for it, with clay. The blend is masonry, not the alloy."
	]
	quest.608BF7BE3CB666F3.quest_subtitle: "{cabin.quest.608BF7BE3CB666F3.subtitle}"
	quest.608BF7BE3CB666F3.title: "Kelp"
	quest.60A8B4C736CE3226.quest_desc: [
		"A fire charge is the blaze item this chapter sets in front of purified sand."
		"Blaze powder is the dust that charge is packed from."
	]
	quest.60A8B4C736CE3226.quest_subtitle: "{cabin.quest.60A8B4C736CE3226.subtitle}"
	quest.60A8B4C736CE3226.title: "Fire Charge"
	quest.60C9D11076C4A724.title: "Flying Boat"
	quest.61147823CC87F711.quest_desc: [
		"This overview node tracks the chapter milestone that opens the andesite age."
	]
	quest.61147823CC87F711.quest_subtitle: "{cabin.quest.61147823CC87F711.subtitle}"
	quest.61147823CC87F711.title: "{cabin.quest.61147823CC87F711.title}"
	quest.612100C7C6E0A7C9.title: "Golden Pickaxe"
	quest.6199E449AF2BADBA.quest_subtitle: "Fuel for the fission reactor"
	quest.6199E449AF2BADBA.title: "Uranium Rod"
quest.6199E449AF2BADBA.quest_desc: [
		"A uranium rod is the fuel a fission reactor burns."
		"Enrichment is the work of turning uranium into rods like this."
	]
	quest.619E34A7DE48B991.quest_desc: [
		"Redstone is the dust half of rose quartz on the Create recipe, now that AE2 is gone."
		"Sandpaper turns that quartz into the polished gem an electron tube needs."
	]
	quest.619E34A7DE48B991.quest_subtitle: "{cabin.quest.619E34A7DE48B991.subtitle}"
	quest.619E34A7DE48B991.title: "Redstone"

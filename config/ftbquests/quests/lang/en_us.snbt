	quest.4D7C2B2653C1982A.quest_desc: [
		"The Accursed Ones bear a heavy burden, but by adventuring and killing stuff, you can make unique exclusive items that patch up your weaknesses and make you even stronger than a baseline autist."
		""
		"Search JEI for \"@enigmaticlegacyplus\" to see all the exclusive items only hardcore gamers like you get to use."
	]
	quest.4D7C2B2653C1982A.quest_subtitle: "And That's A Good Thing!"
	quest.4D7C2B2653C1982A.title: "So You're Eternally Damned"
